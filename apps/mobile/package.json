{
  "name": "@taptime/mobile",
  "version": "1.0.0",
  "description": "TapTim.e Mobile app with C1 authentication, C2 private transport, C3E1 Employee enrollment, and an explicit development-only demo path.",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@noble/hashes": "2.2.0",
    "@supabase/supabase-js": "^2.110.3",
    "@taptime/core": "*",
    "@taptime/mobile-work-contract": "*",
    "@taptime/offline-sync-contract": "*",
    "@taptime/time-review-contract": "*",
    "expo": "~57.0.2",
    "expo-background-task": "~57.0.5",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.0",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "@taptime/administration-contract": "*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9",
    "axe-core": "^4.10.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "eas-build-post-install": "npm run build --workspace=@taptime/administration-contract && npm run build --workspace=@taptime/mobile-work-contract && npm run build --workspace=@taptime/offline-sync-contract && npm run build --workspace=@taptime/time-review-contract",
    "android:production-validation:build": "node scripts/buildProductionValidationAndroid.mjs",
    "android:offline-storage-boundary:verify": "node scripts/verifyOfflineStorageAndroidBoundary.mjs",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "private": true
}
