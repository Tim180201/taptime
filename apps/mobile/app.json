{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false },
      "bundleIdentifier": "com.tim180201.mobile",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false,
      "package": "com.tim180201.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Taptura liest NFC-Tags zur Zeiterfassung und beschreibt sie beim Zuordnen.",
          "includeNdefEntitlement": false,
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withOfflineStorageBackupBoundary",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-background-task",
      [
        "expo-status-bar",
        {
          "style": "light",
          "hidden": false
        }
      ],
      "./plugins/withSystemBarAppearance"
    ],
    "extra": {
      "eas": {
        "projectId": "a585d394-130a-41d9-af16-53038ce2e7ff"
      }
    }
  }
}
