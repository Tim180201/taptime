{
  "expo": {
    "name": "%APP_NAME%",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../shared/brand/app/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": {
        "light": "../../shared/brand/app/icon.png",
        "dark": "../../shared/brand/app/icon-dark.png",
        "tinted": "../../shared/brand/app/icon-tinted.png"
      },
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false },
      "bundleIdentifier": "com.tim180201.mobile",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1512",
        "foregroundImage": "../../shared/brand/app/android-icon-foreground.png",
        "monochromeImage": "../../shared/brand/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false,
      "package": "com.tim180201.mobile"
    },
    "web": {
      "favicon": "../../shared/brand/app/favicon.png"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "%APP_NAME% liest NFC-Karten zur Zeiterfassung und beschreibt sie beim Zuordnen.",
          "includeNdefEntitlement": false,
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withOfflineStorageBackupBoundary",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-background-task",
      [
        "expo-status-bar",
        {
          "style": "light",
          "hidden": false
        }
      ],
      "./plugins/withSystemBarAppearance"
    ],
    "extra": {
      "eas": {
        "projectId": "a585d394-130a-41d9-af16-53038ce2e7ff"
      }
    }
  }
}
