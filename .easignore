# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/apps/mobile/ios/
/apps/mobile/android/

# Local analysis and reviews
.audit-*/
.t[0-9]*-review/
# EAS also filters directory names without a trailing slash before visiting their contents.
.audit-*
.t[0-9]*-review
# Every local environment-file variant
.env*
