#!/usr/bin/env bash
# Passwords enter only shell builtins and Caddy's stdin; never argv or environment.
set +x
set -euo pipefail
umask 077
fail() { printf '%s\n' "$1" >&2; exit 1; }
[[ "$EUID" == 0 ]] || fail 'Dieses Werkzeug benötigt root.'
mode='gesetzt'
case "$#:${1:-}" in 0:) ;; 1:--disable) mode='gesperrt';; *) fail 'Aufruf: taptime-landing-password [--disable]';; esac
readonly AUTH_DIRECTORY="${TAPTIME_LANDING_AUTH_DIRECTORY:-/opt/taptime/landing-auth}"
readonly PROJECT="${TAPTIME_LANDING_PROJECT:-taptime-prod}"
readonly ORIGIN="${TAPTIME_LANDING_ORIGIN:-https://tb-infra.de}"
[[ "$PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail 'Ungültiges Compose-Projekt.'
[[ -d "$AUTH_DIRECTORY" && ! -L "$AUTH_DIRECTORY" && "$(stat -c '%u:%g:%a' "$AUTH_DIRECTORY")" == 0:0:700 ]] || fail 'Zugangsverzeichnis ist nicht privat.'
readonly HASH_FILE="$AUTH_DIRECTORY/password.hash"
[[ -f "$HASH_FILE" && ! -L "$HASH_FILE" && "$(stat -c '%u:%g:%a' "$HASH_FILE")" == 0:0:600 ]] || fail 'Zugangsdatei ist nicht privat.'
exec {lock_fd}>"${TAPTIME_DEPLOY_LOCK_FILE:-/run/lock/taptime-deploy.lock}"
flock -n "$lock_fd" || fail 'Eine Auslieferung oder Passwortänderung läuft bereits.'
container="$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" --filter 'label=com.docker.compose.service=caddy')"
[[ "$container" =~ ^[a-z0-9]+$ ]] || fail 'Genau ein laufender Caddy wird benötigt.'
stage="$(mktemp -d "$AUTH_DIRECTORY/.password.XXXXXX")"
changed=0
committed=0
reload_saved() { docker exec -i "$container" caddy reload --config - --force < "$stage/running.json" >/dev/null 2>&1; }
read_running() { docker exec "$container" wget -q -T 5 -Y off -O - http://127.0.0.1:2019/config/ 2>/dev/null; }
check_edge() {
  local status
  status="$(curl --silent --max-time 5 --output /dev/null --write-out '%{http_code}' "$ORIGIN/")" || return
  [[ "$status" == 401 ]] || return 1
  status="$(curl --silent --max-time 5 --output /dev/null --write-out '%{http_code}' "$ORIGIN/tag")" || return
  [[ "$status" == 200 ]] || return 1
  read_running > "$stage/readback.json" && cmp -s "$stage/running.json" "$stage/readback.json"
}
# An interrupted or failed operation restores both the disk and provisioned hash.
# shellcheck disable=SC2317,SC2329
cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if (( changed == 1 && committed == 0 )); then
    if ! mv -f -- "$stage/original" "$HASH_FILE" || ! reload_saved || ! check_edge; then
      printf 'Wiederherstellung fehlgeschlagen; Zugang über die Konsole prüfen.\n' >&2
      status=1
    fi
  fi
  rm -rf -- "$stage"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
cp -p -- "$HASH_FILE" "$stage/original"
read_running > "$stage/running.json" || fail 'Laufende Konfiguration nicht lesbar.'
docker exec -i "$container" caddy validate --config - < "$stage/running.json" >/dev/null 2>&1 || fail 'Laufende Konfiguration nicht ladbar.'
if [[ "$mode" == gesetzt ]]; then
  IFS= read -r -s password || fail 'Passwort fehlt.'
  IFS= read -r -s repeated || fail 'Wiederholung fehlt.'
  [[ "$password" == "$repeated" && "$password" =~ ^[a-x0-9]{16,64}$ ]] || fail 'Passwörter müssen übereinstimmen: 16–64 Kleinbuchstaben ohne y/z oder Ziffern.'
  unset repeated
else
  password="$(od -An -v -N32 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$password" =~ ^[0-9a-f]{64}$ ]] || fail 'Sperrwert konnte nicht erzeugt werden.'
fi
printf '%s\n' "$password" | docker exec -i "$container" caddy hash-password > "$stage/new" 2>/dev/null || fail 'Hash konnte nicht erzeugt werden.'
unset password
[[ -s "$stage/new" ]] || fail 'Hash fehlt.'
chmod 600 "$stage/new"
changed=1
mv -f -- "$stage/new" "$HASH_FILE"
if ! reload_saved || ! check_edge; then fail 'Änderung fehlgeschlagen; vorheriger Zugang wird wiederhergestellt.'; fi
committed=1
printf '%s\n' "$mode"
