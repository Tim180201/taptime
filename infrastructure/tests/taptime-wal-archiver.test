#!/usr/bin/env bash
set -euo pipefail

REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly REPOSITORY_ROOT
TEST_ROOT="$(mktemp -d)"
readonly TEST_ROOT
trap 'rm -rf -- "$TEST_ROOT"' EXIT

mkdir -p "$TEST_ROOT/bin" "$TEST_ROOT/spool"
readonly WAL_FILE='000000010000000000000001'
readonly CLUSTER_ID='0123456789abcdef'
printf 'synthetic WAL bytes\n' > "$TEST_ROOT/spool/$WAL_FILE"

cat > "$TEST_ROOT/bin/borg" <<'EOF_BORG'
#!/usr/bin/env bash
set -euo pipefail
printf 'borg %s\n' "$*" >> "$ARCHIVER_CALL_LOG"
if [[ "${1:-}" == 'info' ]]; then
  exit 0
fi
if [[ "${1:-}" == 'extract' && "${2:-}" == '--stdout' ]]; then
  exit 42
fi
exit 1
EOF_BORG

cat > "$TEST_ROOT/bin/docker" <<'EOF_DOCKER'
#!/usr/bin/env bash
set -euo pipefail
printf 'docker %s\n' "$*" >> "$ARCHIVER_CALL_LOG"
exit 99
EOF_DOCKER
chmod 0755 "$TEST_ROOT/bin/borg" "$TEST_ROOT/bin/docker"

export PATH="$TEST_ROOT/bin:$PATH"
export ARCHIVER_CALL_LOG="$TEST_ROOT/calls.log"
export TAPTIME_BORG_LOCK_FILE="$TEST_ROOT/borg.lock"
: > "$ARCHIVER_CALL_LOG"

# shellcheck source=../backup/taptime-wal-archiver
source "$REPOSITORY_ROOT/infrastructure/backup/taptime-wal-archiver"
hostname() {
  if [[ "${1:-}" == '-I' ]]; then
    printf '192.0.2.10 10.0.0.10\n'
  else
    printf 'synthetic-local\n'
  fi
}
getent() {
  [[ "${1:-}" == 'ahostsv4' ]] || return 1
  case "${2:-}" in
    offsite.invalid)
      printf '198.51.100.23 STREAM offsite.invalid\n'
      ;;
    local-alias.invalid)
      printf '192.0.2.10 STREAM local-alias.invalid\n'
      ;;
    *)
      return 2
      ;;
  esac
}
export BORG_RSH='ssh -p 23 -i /synthetic-key -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile=/synthetic-known-hosts -o StrictHostKeyChecking=yes'
export BORG_REPOSITORY="$TEST_ROOT/local-borg-repository"
set +e
validate_offsite_borg_repository > "$TEST_ROOT/repository.output.log" 2>&1
repository_status=$?
set -e
if (( repository_status == 0 )); then
  printf 'A local Borg repository was accepted as offsite storage.\n' >&2
  exit 1
fi
grep --quiet 'must use non-local ssh:// storage' "$TEST_ROOT/repository.output.log"
export BORG_REPOSITORY='ssh://synthetic@localhost:23/./taptime'
set +e
validate_offsite_borg_repository > "$TEST_ROOT/repository.output.log" 2>&1
repository_status=$?
set -e
if (( repository_status == 0 )); then
  printf 'The local host was accepted as offsite storage.\n' >&2
  exit 1
fi
grep --quiet 'must not resolve by configuration to this host' \
  "$TEST_ROOT/repository.output.log"
export BORG_REPOSITORY='ssh://synthetic@local-alias.invalid:23/./taptime'
set +e
validate_offsite_borg_repository > "$TEST_ROOT/repository.output.log" 2>&1
repository_status=$?
set -e
if (( repository_status == 0 )); then
  printf 'A local interface alias was accepted as offsite storage.\n' >&2
  exit 1
fi
grep --quiet 'resolves to a local interface address' \
  "$TEST_ROOT/repository.output.log"
export BORG_REPOSITORY='ssh://synthetic@offsite.invalid:23/./taptime'
validate_offsite_borg_repository
export WAL_SPOOL_DIRECTORY="$TEST_ROOT/spool"
export DATABASE_CONTAINER='synthetic-database'
export DATABASE_NAME='synthetic'
export CLUSTER_SYSTEM_IDENTIFIER='81985529216486895'
export CLUSTER_ARCHIVE_IDENTIFIER="$CLUSTER_ID"

set +e
archive_file "$WAL_FILE" > "$TEST_ROOT/output.log" 2>&1
archive_status=$?
set -e
if (( archive_status == 0 )); then
  printf 'A failed offsite read-back was accepted.\n' >&2
  exit 1
fi
test -f "$TEST_ROOT/spool/$WAL_FILE"
if grep --quiet '^docker ' "$ARCHIVER_CALL_LOG"; then
  printf 'An archive receipt was recorded before external bytes were verified.\n' >&2
  exit 1
fi
grep --quiet 'Could not read back offsite WAL archive' "$TEST_ROOT/output.log"

receiver_is_active() { printf 'f\n'; }
set +e
archive_once > "$TEST_ROOT/receiver.output.log" 2>&1
receiver_status=$?
set -e
if (( receiver_status == 0 )); then
  printf 'An inactive physical WAL receiver was accepted.\n' >&2
  exit 1
fi
grep --quiet 'physical WAL receiver slot is not active' "$TEST_ROOT/receiver.output.log"

database_query() { printf '81985529216486895|%s\n' "$CLUSTER_ID"; }
printf 'fedcba9876543210\n' > "$TEST_ROOT/spool/.cluster-system-identifier"
set +e
load_cluster_identity > "$TEST_ROOT/identity.output.log" 2>&1
identity_status=$?
set -e
if (( identity_status == 0 )); then
  printf 'A WAL spool from another PostgreSQL cluster was accepted.\n' >&2
  exit 1
fi
grep --quiet 'WAL spool belongs to a different PostgreSQL cluster' \
  "$TEST_ROOT/identity.output.log"

printf 'WAL archive failure evidence: no receipt and local segment retained.\n'
printf 'WAL receiver failure evidence: inactive slot rejected before backlog processing.\n'
printf 'WAL cluster evidence: a spool from another PostgreSQL cluster was rejected.\n'
printf 'Offsite repository evidence: local paths, localhost and local aliases were rejected.\n'

# Isolate these mocks from the receiver/read-back cases above. Count the real reconciliation
# path's external work, not elapsed time: confirmed history must not cost one call per file.
bash -euo pipefail -s -- "$REPOSITORY_ROOT" "$TEST_ROOT" <<'CHAIN_TESTS'
source "$1/infrastructure/backup/taptime-wal-archiver"
trace="$2/chain-calls"
inventory="$2/chain-inventory"
CLUSTER_ARCHIVE_IDENTIFIER='0123456789abcdef'
base="base-$CLUSTER_ARCHIVE_IDENTIFIER-20260920T000000Z"
selected_base="$base"
mark=''
fault=''
start_wal='000000010000000000000001'

wal() { printf '00000001%08X%08X' "$(( $1 / 256 ))" "$(( $1 % 256 ))"; }
fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
count() { awk -v kind="$1" '$1 == kind { n++ } END { print n+0 }' "$trace"; }
expect_count() { [[ "$(count "$1")" == "$2" ]] || fail "$1: expected $2 calls, got $(count "$1")"; }
latest_verified_base_marker() { printf 'verified-%s\n' "$selected_base"; }
registered_base_evidence() { printf '0/1000028|%s\n' "$start_wal"; }
ensure_base_evidence() { printf 'full-base\n' >> "$trace"; registered_base_evidence; }
database_query() {
  # Exercise the actual watermark reader and its exact cluster/base binding.
  [[ "$1" == *'current_offsite_archive_cluster_identifier_v1()'* \
    && "$1" == *"watermark.base_archive_name = '$selected_base'"* \
    && "$1" == *'ORDER BY watermark.wal_file DESC'* \
    && "$1" != *'SET ROLE'* ]] || fail 'watermark query lost its cluster/base binding'
  printf 'watermark-query\n' >> "$trace"
  [[ "$fault" != query ]] || return 1
  [[ "$selected_base" != "$base" ]] || printf '%s\n' "$mark"
  return 0
}
registered_wal_checksum() {
  printf 'receipt %s\n' "$1" >> "$trace"
  [[ "$fault" != receipt ]] || return 1
  printf '%064d\n' 0
}
advance_watermark() {
  printf 'advance %s %s\n' "$1" "$2" >> "$trace"
  [[ "$fault" != advance ]]
}
wal_files_are_adjacent() {
  printf 'adjacent %s %s\n' "$1" "$2" >> "$trace"
  local left right
  left=$((16#${1:8:8} * 256 + 16#${1:16:8}))
  right=$((16#${2:8:8} * 256 + 16#${2:16:8}))
  if (( right == left + 1 )); then printf 't\n'; else printf 'f\n'; fi
}
borg() {
  printf 'borg-%s\n' "$1" >> "$trace"
  case "$1" in
    list)
      [[ "$fault" != list ]] || return 1
      # Borg 1.2 --glob-archives takes the shell glob WITHOUT a literal sh: prefix.
      [[ "$2" == --glob-archives && "$3" == "wal-$CLUSTER_ARCHIVE_IDENTIFIER-*" ]] || return 1
      cat "$inventory"
      ;;
    info)
      [[ "$fault" != info ]] || return 1
      if [[ "$2" == *"::$selected_base" ]]; then return 0; fi
      grep -Fxq "${2#*::}" "$inventory"
      ;;
    *) return 1 ;;
  esac
}
prepare() {
  local history="$1" added="$2" i
  selected_base="$base"; mark="$(wal "$history")"; fault=''
  : > "$trace"; : > "$inventory"
  for ((i=1; i<=history+added; i++)); do
    printf 'wal-%s-%s\n' "$CLUSTER_ARCHIVE_IDENTIFIER" "$(wal "$i")" >> "$inventory"
  done
}
for added in 0 1 3; do
  reference=''
  for history in 512 1; do
    prepare "$history" "$added"
    reconcile_contiguous_watermark
    expect_count receipt "$added"
    expect_count advance "$added"
    expect_count adjacent "$added"
    expect_count full-base 0
    expect_count borg-info 1 # Only the base; receipted WAL adds no remote call.
    work="$(sort "$trace" | sed -E 's/ (.*)//' | sort | uniq -c)"
    if [[ -n "$reference" ]]; then [[ "$work" == "$reference" ]] || fail 'confirmed history increased external call count'; fi
    reference="$work"
    printf 'Incremental work: confirmed=%s new=%s receipt=%s advance=%s adjacency=%s\n' \
      "$history" "$added" "$(count receipt)" "$(count advance)" "$(count adjacent)"
  done
done

# Restore/lost mark and a newly verified base must both rebuild from their own first WAL.
for reason in missing-mark changed-base; do
  prepare 3 1
  if [[ "$reason" == missing-mark ]]; then mark=''; else selected_base="base-$CLUSTER_ARCHIVE_IDENTIFIER-20260920T010000Z"; fi
  reconcile_contiguous_watermark
  expect_count full-base 1
  expect_count receipt 4
  expect_count advance 4
done

# Both a missing first successor and an internal new gap must force a full scan AND fail.
for missing in 4 5 3; do
  prepare 3 3
  missing_archive="wal-$CLUSTER_ARCHIVE_IDENTIFIER-$(wal "$missing")"
  grep -Fvx "$missing_archive" "$inventory" > "$inventory.next"
  mv "$inventory.next" "$inventory"
  if reconcile_contiguous_watermark > "$2/gap-$missing.log" 2>&1; then fail 'a WAL gap was accepted'; fi
  expect_count full-base 1
  if grep -q "^advance .*$(wal "$((missing+1))")$" "$trace"; then fail 'advanced across a WAL gap'; fi
done

# A missing watermark at the end is also a gap, even with no newer archive to expose it.
prepare 3 0
grep -Fvx "wal-$CLUSTER_ARCHIVE_IDENTIFIER-$mark" "$inventory" > "$inventory.next"
mv "$inventory.next" "$inventory"
if reconcile_contiguous_watermark > "$2/missing-tail.log" 2>&1; then fail 'a truncated confirmed tail was accepted'; fi
expect_count full-base 1

# An error must remain an error even when the reconciler is called as an if-condition
# (Bash disables errexit throughout that call tree).
for fault_case in query list receipt advance info; do
  prepare 3 1; fault="$fault_case"
  if reconcile_contiguous_watermark > "$2/fault-$fault_case.log" 2>&1; then fail "$fault_case error was swallowed"; fi
done
for invalid_mark in invalid 000000020000000000000003 000000010000000000000000; do
  prepare 3 1; mark="$invalid_mark"
  if reconcile_contiguous_watermark >/dev/null 2>&1; then fail 'invalid watermark was trusted'; fi
  expect_count advance 0
done
printf 'Incremental chain evidence: constant calls for confirmed history, full rebuild on absent/base-changed mark, gaps and dependency failures rejected.\n'
CHAIN_TESTS

# Exercise the real main loop, archive_once and status writer. The clock and sleeps are
# controlled: assert ordering and fresh evidence, without a wall-clock timing assertion.
bash -euo pipefail -s -- "$REPOSITORY_ROOT" "$TEST_ROOT" <<'CADENCE_TESTS'
root="$2/cadence"
mkdir -p "$root/spool"
export TAPTIME_BACKUP_CONFIG="$root/config"
export TAPTIME_BORG_LOCK_FILE="$root/borg.lock"
source "$1/infrastructure/backup/taptime-wal-archiver"
trace="$root/trace"
fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
validate_offsite_borg_repository() { :; }
load_cluster_identity() { CLUSTER_ARCHIVE_IDENTIFIER='0123456789abcdef'; }
receiver_is_active() { printf 'receiver\n' >> "$trace"; printf 't\n'; }
pending_wal_files() { printf 'pending\n' >> "$trace"; }
database_query() { [[ "$1" == *pg_switch_wal* ]] || return 1; printf 'switch\n' >> "$trace"; }
archive_file() {
  printf 'upload %s\n' "$1" >> "$trace"
  printf '%s\n' "$1" > "$root/watermark"
  rm "$WAL_SPOOL_DIRECTORY/$1"
}
latest_base_has_offsite_start_wal() { printf 'base\n' >> "$trace"; }
latest_verified_base_marker() { printf 'verified-base-%s-20260920T000000Z\n' "$CLUSTER_ARCHIVE_IDENTIFIER"; }
reconcile_contiguous_watermark() {
  printf 'chain\n' >> "$trace"
  [[ "$(cat "$root/watermark")" != "$fault_wal" ]]
}
backlog_status() {
  printf 'backlog\n' >> "$trace"
  printf '||%s|2026-09-20T00:00:00Z|0\n' "$(cat "$root/watermark")"
}
date() { cat "$root/clock"; }
eval "$(declare -f write_status | sed '1s/write_status/real_write_status/')"
write_status() {
  real_write_status "$@"
  cat "$WAL_ARCHIVE_STATUS_FILE" >> "$root/statuses"
  printf 'status %s\n' "$1" >> "$trace"
}
sleep() {
  # Reaching this point also proves that the subshell released the Borg lock.
  flock --nonblock "$LOCK_FILE" true || fail 'Borg lock was held during sleep'
  [[ "$TAPTIME_WAL_ARCHIVE_RUN_ONCE" != 1 ]] || fail 'run-once slept'
  [[ "$WAL_ARCHIVE_INTERVAL_SECONDS" == "$interval" ]] || fail 'configured interval changed'
  awk -v pause="$1" -v interval="$interval" 'BEGIN { exit pause * 2 != interval }' \
    || fail "expected half of $interval seconds, got $1"
  sleep_count=$((sleep_count + 1))
  if (( sleep_count == 3 )); then exit 0; fi
  printf 'sleep %s\n' "$1" >> "$trace"
  # The third pass has an empty spool: it must still re-check evidence and write status.
  if (( sleep_count == 1 )) && [[ "$scenario" != empty ]]; then : > "$root/spool/000000010000000000000002"; fi
  printf '2026-09-20T00:0%s:00Z\n' "$sleep_count" > "$root/clock"
}
for interval in 60 61 1; do
  for scenario in upload gap empty; do
    fault_wal=''
    if [[ "$scenario" == gap ]]; then fault_wal='000000010000000000000002'; fi
    for run_once in 0 1; do
      : > "$trace"; : > "$root/statuses"
      printf '2026-09-20T00:00:00Z\n' > "$root/clock"
      : > "$root/passphrase"
      : > "$root/spool/000000010000000000000001"
      cat > "$CONFIG_FILE" <<CONFIG
BORG_REPOSITORY='ssh://synthetic@offsite.invalid/./repository'
BORG_RSH='synthetic'
BORG_PASSPHRASE_FILE='$root/passphrase'
DATABASE_CONTAINER='synthetic'
DATABASE_NAME='synthetic'
WAL_SPOOL_DIRECTORY='$root/spool'
WAL_ARCHIVE_STATUS_FILE='$root/status.json'
WAL_ARCHIVE_INTERVAL_SECONDS='$interval'
WAL_ARCHIVE_MISSED_CYCLES='2'
WAL_ARCHIVE_CACHE_DIRECTORY='$root/cache'
WAL_REPLICATION_SLOT='synthetic'
CONFIG
      export TAPTIME_WAL_ARCHIVE_RUN_ONCE="$run_once"
      sleep_count=0
      ( main ) > "$root/cycles"
      node - "$trace" "$root/statuses" "$run_once" "$fault_wal" "$scenario" "$root/cycles" <<'ASSERT'
const fs = require('node:fs');
const [tracePath, statusesPath, once, fault, scenario, cyclesPath] = process.argv.slice(2);
const trace = fs.readFileSync(tracePath, 'utf8').trim().split('\n');
const statuses = fs.readFileSync(statusesPath, 'utf8').trim().split('\n').map(JSON.parse);
const assert = (condition, message) => { if (!condition) throw new Error(message); };
const full = ['receiver', 'pending', 'upload 000000010000000000000001', 'base', 'chain', 'backlog', 'status ok'];
assert(JSON.stringify(trace.slice(0, full.length)) === JSON.stringify(full), 'first pass must check evidence and write status');
if (once === '1') {
  assert(trace.length === full.length && statuses.length === 1, 'run-once must return after one pass');
} else {
  const passes = [[]];
  for (const entry of trace) { if (entry.startsWith('sleep ')) passes.push([]); else passes.at(-1).push(entry); }
  assert(passes.length === 3, 'expected three identical passes separated by two half pauses');
  assert(passes.every(pass => pass.includes('pending') && !pass.includes('switch')), 'every pass must check demand; no demand means no switch');
  assert(passes[1].includes('receiver') && passes[1].includes('base') && passes[1].includes('chain'), 'every pass must check receiver, base and chain even when empty');
  assert(passes[1].includes('upload 000000010000000000000002') === (scenario !== 'empty'), 'every pass must collect every completed segment');
  assert(passes[2].includes('pending') && passes[2].includes('chain'), 'empty pass must recheck the chain');
  assert(fault ? !passes[2].includes('backlog') : passes[2].includes('backlog'), 'a failed chain must abort before the backlog read');
  assert(statuses.length === passes.length, 'every pass must write status');
  assert(statuses.map(s => s.observed_at_utc).join() === '2026-09-20T00:00:00Z,2026-09-20T00:01:00Z,2026-09-20T00:02:00Z', 'status observations must be fresh each time');
  assert(statuses.map(s => s.state).join() === (fault ? 'ok,failed,failed' : 'ok,ok,ok'), 'chain failure must not become fresh ok');
  if (!fault) {
    assert(passes[1].includes('backlog'), 'empty pass must still read current backlog');
    assert(statuses[1].last_archived_wal_file === (scenario === 'empty' ? '000000010000000000000001' : '000000010000000000000002'), 'status must contain newly read progress');
  }
}
const cycles = fs.readFileSync(cyclesPath, 'utf8').trim().split('\n');
assert(cycles.length === statuses.length, 'exactly one journal summary per cycle');
assert(cycles.every(line => /^WAL cycle: duration_seconds=\d+ uploaded_segments=\d+ reconciled_archives=\d+ switch_requested=[01] result=\d+$/.test(line)), 'journal fields must be bounded metrics only');
ASSERT
    done
  done
done
printf 'Cadence evidence: identical demand-driven passes at half pauses; fresh checked status each time, failure stays failed, run-once unchanged, odd intervals exact, lock free during pauses.\n'
CADENCE_TESTS

bash -euo pipefail -s -- "$REPOSITORY_ROOT" "$TEST_ROOT" <<'SWITCH_TESTS'
source "$1/infrastructure/backup/taptime-wal-archiver"
WAL_SPOOL_DIRECTORY="$2/switch-spool"
mkdir "$WAL_SPOOL_DIRECTORY"
fixture_current='000000010000000000000003'
older='000000010000000000000002'
trace="$2/switch-trace"
fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
pending_wal_files() { printf '%s\n' "$fixture_pending"; }
database_query() {
  if [[ "$1" == *pg_switch_wal* ]]; then
    [[ "$1" == *"WHERE pg_catalog.pg_walfile_name(pg_catalog.pg_current_wal_insert_lsn()) = '$fixture_current'"* ]] || return 1
    printf 'switch\n' >> "$trace"
    [[ "$scenario" == race ]] || printf '%s\n' "$fixture_current"
  else
    [[ "$1" == 'SELECT pg_catalog.pg_walfile_name(pg_catalog.pg_current_wal_insert_lsn());' ]] || return 1
    printf '%s\n' "$fixture_current"
  fi
}
sleep() {
  [[ "$1" == 1 ]] || fail 'receiver wait must use one-second polls'
  polls=$((polls + 1)); SECONDS=$((SECONDS + 1))
  if [[ "$scenario" == arrives ]] && (( polls == 3 )); then
    mv "$WAL_SPOOL_DIRECTORY/$fixture_current.partial" "$WAL_SPOOL_DIRECTORY/$fixture_current"
  fi
}
for scenario in idle closed arrives timeout race; do
  : > "$trace"; rm -f "$WAL_SPOOL_DIRECTORY/"*
  : > "$WAL_SPOOL_DIRECTORY/$fixture_current.partial"
  fixture_pending="$fixture_current"; polls=0; switch_requested=0
  if [[ "$scenario" == idle ]]; then fixture_pending=''; fi
  if [[ "$scenario" == closed ]]; then fixture_pending="$older"; fi
  close_required_segment
  case "$scenario" in
    idle|closed) [[ ! -s "$trace" && "$switch_requested" == 0 && "$polls" == 0 ]] || fail 'no open demand must not switch or wait' ;;
    arrives) [[ "$switch_requested" == 1 && "$polls" == 3 && -f "$WAL_SPOOL_DIRECTORY/$fixture_current" ]] || fail 'must wait for renamed complete segment' ;;
    timeout) [[ "$switch_requested" == 1 && "$polls" == 10 ]] || fail 'partial segment must stop waiting at ten seconds' ;;
    race) [[ "$switch_requested" == 0 && "$polls" == 0 ]] || fail 'natural closure before switch must not wait' ;;
  esac
done
printf 'Segment-switch evidence: no idle/closed-demand switch, partial files await completion, bounded ten-second wait, natural closure rechecked.\n'
SWITCH_TESTS

bash -euo pipefail -s -- "$REPOSITORY_ROOT" "$TEST_ROOT" <<'RECEIPT_TESTS'
source "$1/infrastructure/backup/taptime-wal-archiver"
trace="$2/receipt-trace"
CLUSTER_ARCHIVE_IDENTIFIER='0123456789abcdef'
WAL_FILE='000000010000000000000001'
BORG_REPOSITORY='unused-local-fixture'
registered_wal_checksum() { if [[ "$scenario" == receipted ]]; then printf '%064d\n' 0; fi; }
borg() {
  printf '%s\n' "$1" >> "$trace"
  [[ "$1" == extract && "$2" == --stdout && "$4" == "$WAL_FILE" ]] || return 1
  [[ "$scenario" != unreadable ]] || return 1
  printf 'synthetic WAL bytes\n'
}
record_archive_receipt() {
  [[ "$1" == "$WAL_FILE" && "$2" == "wal-$CLUSTER_ARCHIVE_IDENTIFIER-$WAL_FILE" \
    && "$3" == "$(printf 'synthetic WAL bytes\n' | sha256sum | cut -d ' ' -f 1)" ]]
  printf 'receipt\n' >> "$trace"
}
for scenario in receipted missing unreadable; do
  : > "$trace"
  if ensure_wal_receipt "$WAL_FILE" > "$2/receipt-output" 2>&1; then
    [[ "$scenario" != unreadable ]]
  else
    [[ "$scenario" == unreadable ]]
  fi
  case "$scenario" in
    receipted) [[ ! -s "$trace" ]] ;;
    missing) [[ "$(cat "$trace")" == $'extract\nreceipt' ]] ;;
    unreadable) [[ "$(cat "$trace")" == extract ]] ;;
  esac
done
printf 'Receipt evidence: zero remote calls with receipt; missing receipt still requires read-back, unreadable bytes never create a receipt.\n'
RECEIPT_TESTS
