#!/usr/bin/env bash
set -euo pipefail

TEST_ROOT="$(mktemp -d)"
readonly TEST_ROOT
trap 'rm -rf -- "$TEST_ROOT"' EXIT
readonly CALL_LOG="$TEST_ROOT/calls.log"
readonly CLUSTER_IDENTIFIER='0123456789abcdef'

# shellcheck source=../backup/taptime-restore-verify
source "$(dirname "$0")/../backup/taptime-restore-verify"

export RESTORE_ARCHIVE_IDENTIFIER="$CLUSTER_IDENTIFIER"
export BORG_REPOSITORY='synthetic-repository'
export BASE_BACKUP_KEEP_HOURLY='1'
export BASE_BACKUP_KEEP_DAILY='1'
export BASE_BACKUP_KEEP_WEEKLY='1'
export BASE_BACKUP_KEEP_MONTHLY='1'
RETENTION_FAILURE=''
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
export TZ=UTC
newest="base-$CLUSTER_IDENTIFIER-20260916T110000Z"
previous="base-$CLUSTER_IDENTIFIER-20260915T230000Z"
obsolete="base-$CLUSTER_IDENTIFIER-20260915T090000Z"
anchor="base-$CLUSTER_IDENTIFIER-20260914T000000Z"
reset_archives() {
  rm -rf -- "$TEST_ROOT/archives"
  mkdir "$TEST_ROOT/archives"
  for archive in "$newest" "$previous" "$obsolete" "$anchor"; do
    mkdir -p "$TEST_ROOT/archives/$archive/manifest"
    wal=000000010000000000000005
    [[ "$archive" != "$newest" ]] || wal=000000020000000000000003
    printf '%s\n' "$wal" > "$TEST_ROOT/archives/$archive/manifest/base-start-wal-file"
  done
  for archive in "$newest" "$previous" "$obsolete"; do mkdir "$TEST_ROOT/archives/verified-$archive"; done
  for wal in 000000010000000000000004 000000010000000000000005 000000020000000000000002 000000020000000000000003; do
    mkdir "$TEST_ROOT/archives/wal-$CLUSTER_IDENTIFIER-$wal"
  done
}

production_base_is_registered() { return 0; }

# Guard against re-introducing a literal "sh:" prefix: Borg 1.2 and 1.4 document
# --glob-archives as "sh: rules apply (without actually using the sh: prefix)".
if grep --quiet --extended-regexp "glob-archives ['\"]sh:" \
    "$(dirname "$0")/../backup/taptime-wal-archiver" \
    "$(dirname "$0")/../backup/taptime-restore-verify"; then
  printf 'A --glob-archives pattern carries a literal sh: prefix and would match nothing.\n' >&2
  exit 1
fi

# The EXIT trap (finish/cleanup) runs after main() has returned. Everything it reads must
# therefore be a global; a function-local variable is unbound there under `set -u`
# (production failure on 18.09.2026: `line 791: container: unbound variable`).
for trap_variable in restore_state stage container write_canonical_status; do
  if ! declare -p "$trap_variable" >/dev/null 2>&1; then
    printf 'restore-verify: %s must be a global for the EXIT trap.\n' "$trap_variable" >&2
    exit 1
  fi
  if grep --quiet --extended-regexp "^  local .*\b${trap_variable}\b" \
      "$(dirname "$0")/../backup/taptime-restore-verify"; then
    printf 'restore-verify: main() declares %s as a local variable again.\n' "$trap_variable" >&2
    exit 1
  fi
done

borg() {
  printf '%s\n' "$*" >> "$CALL_LOG"
  local op="$1" target='' arg
  shift
  for arg in "$@"; do [[ "$arg" != *'::'* ]] || target="${arg##*::}"; done
  case "$op" in
    info) [[ -d "$TEST_ROOT/archives/$target" ]];;
    compact) return 0;;
    prune)
      if [[ " $* " == *' --dry-run '* ]]; then
        case "$RETENTION_FAILURE" in
          preview-empty) return 0;;
          preview-failed) return 1;;
          preview-unknown) printf 'Unknown output\n' >&2; return 0;;
          preview-marker) printf 'Would prune: verified-%s Wed, 2026-09-16 11:00:00 [fixture]\n' "$newest" >&2; return 0;;
        esac
      fi
      node "$REPO/infrastructure/tests/fake-borg-retention.mjs" "$TEST_ROOT/archives" prune "$@"
      if [[ " $* " == *' --dry-run '* && "$RETENTION_FAILURE" == preview-trailing ]]; then
        printf 'Unexpected footer\n' >&2
      fi
      ;;
    list)
      case "$*" in
        *'--glob-archives verified-base-'*) [[ "$RETENTION_FAILURE" != marker-list ]] || return 1;;
        *'--glob-archives base-'*)
          [[ "$RETENTION_FAILURE" != base-list ]] || return 1
          if [[ "$RETENTION_FAILURE" == base-incomplete ]]; then printf '%s\n' "$previous"; return 0; fi;;
        *'--glob-archives wal-'*) [[ "$RETENTION_FAILURE" != wal-list ]] || return 1;;
      esac
      node "$REPO/infrastructure/tests/fake-borg-retention.mjs" "$TEST_ROOT/archives" list "$@";;
    extract)
      [[ "$RETENTION_FAILURE" != base-extract ]] || return 1
      cat "$TEST_ROOT/archives/$target/${*: -1}";;
    delete) rm -rf -- "$TEST_ROOT/archives/$target";;
    *) return 1;;
  esac
}

reset_archives
: > "$CALL_LOG"
prune_after_verified_restore
deleted_archives="$(sed -n 's/^delete synthetic-repository:://p' "$CALL_LOG" | sort)"
expected="$(printf '%s\n' "verified-$obsolete" "wal-$CLUSTER_IDENTIFIER-000000010000000000000004" "wal-$CLUSTER_IDENTIFIER-000000020000000000000002" | sort)"
[[ "$deleted_archives" == "$expected" ]]
[[ -d "$TEST_ROOT/archives/verified-$previous" && -d "$TEST_ROOT/archives/verified-$newest" ]]
[[ ! -d "$TEST_ROOT/archives/$obsolete" ]]
printf 'Timeline retention: real prune, each retained base supplies its own WAL floor.\n'

for RETENTION_FAILURE in base-list base-extract base-incomplete wal-list marker-list; do
  reset_archives
  : > "$CALL_LOG"
  if prune_after_verified_restore > "$TEST_ROOT/failure.log" 2>&1; then
    printf 'Accepted %s inventory failure\n' "$RETENTION_FAILURE" >&2; exit 1
  fi
  if grep -q '^delete ' "$CALL_LOG"; then exit 1; fi
done
printf 'Incomplete base, WAL or marker inventory: no WAL or marker deletion.\n'

for RETENTION_FAILURE in preview-empty preview-failed preview-unknown preview-marker preview-trailing; do
  reset_archives
  : > "$CALL_LOG"
  if prune_after_verified_restore > "$TEST_ROOT/preview.log" 2>&1; then exit 1; fi
  if grep -Eq '^(delete|compact) |^prune --list' "$CALL_LOG"; then exit 1; fi
  [[ -d "$TEST_ROOT/archives/$obsolete" ]]
done
printf 'Empty, failed or unrecognized previews: no destructive operation.\n'

# The existing CI entry point includes the chronological T-093 regression matrix.
bash "$REPO/infrastructure/tests/taptime-retention-week.test"
