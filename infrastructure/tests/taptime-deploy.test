printf 'Forced wrong-version fail-closed evidence:\n'
grep --extended-regexp 'Lege absichtlich|Archivvertrag ist aktiv|Manual recovery' "$OUTPUT_FILE"
sed -n '/activate-web aaaaaaa/,$p' "$LOG_FILE"

: > "$LOG_FILE"
# The single-quoted program is evaluated by the child Bash, not this test process.
# shellcheck disable=SC2016
expect_status 137 env \
  TAPTIME_DEPLOY_ALLOW_TEST_HOOKS=1 \
  TAPTIME_DEPLOY_TEST_ABORT_AFTER_MIGRATION=1 \
  bash -c '
    source "$1"
    TEST_CALL_LOG="$2"
    record() { printf "%s\n" "$*" >> "$TEST_CALL_LOG"; }
    require_root() { :; }
    acquire_deploy_lock() { :; }
    hold_backup_timer() { :; }
    preflight_deploy() { :; }
preflight_operator_dns() { :; }
    pull_image() { record "pull $1"; }
    prepare_admin_web_release() { record "prepare-web $1 $2"; }
operator_web_capability() { printf "1\n"; }
prepare_operator_web_versions() { record "prepare-operator-versions $DESIRED_VERSION $PREVIOUS_VERSION"; }
select_operator_web_release() { ACTIVE_OPERATOR_WEB_VERSION="$1"; record "activate-operator $1 $2"; }
    deploy_operations_release() { record "install-operations $1 $2"; }
    verify_local_rehearsal_image() { record "verify-local $1 $2"; }
    image_supports_archive_ack_contract() { return 0; }
    select_migration_version() { printf "%s\n" "$DESIRED_VERSION"; }
    run_restore_verification() { record "restore-and-rehearsal $1 ${2:-0}"; }
    run_backup() { record backup; }
    wal_archive_mount_state() { printf "active\n"; }
    archive_contract_is_active() { return 0; }
    ensure_wal_archive_runtime() { record ensure-wal-runtime; }
    prepare_offsite_wal_for_restore() { record "prepare-offsite-wal ${1:-0}"; }
    complete_wal_archive_cutover() { record complete-wal-cutover; }
    sync_migration_sources() { record "sync $1"; }
    migrate_production() { record migrate-production; }
    start_backend() { record "start $1"; }
    activate_admin_web_release() { record "activate-web $1"; }
    landing_web_capability() { printf "%s\n" "${TEST_LANDING_CAPABILITY:-1}"; }
initialize_landing_auth() { :; }
prepare_landing_web_versions() { :; }
select_landing_web_release() { :; }
verify_landing_or_disable() { :; }
save_running_caddy() { [[ "${FAIL_CADDY_SNAPSHOT:-0}" != 1 ]] || return 61; CADDY_RECOVERY_READY=1; }
    restart_caddy() { record "restart-caddy $1"; }
    wait_for_health() { record "health $1"; }
    write_current_version() { record "write-version $1"; }
    mark_known_version() { :; }
    publish_protected_versions() { record "publish-protected $1 $2 $3"; }
    main bbbbbbb
  ' bash "$(dirname "$0")/../deploy" "$LOG_FILE"
grep --quiet '^migrate-production$' "$LOG_FILE"
if grep --quiet -E '^(start|write-version) ' "$LOG_FILE"; then
  printf 'The forced migration/start interruption changed the application image.\n' >&2
  exit 1
fi
test "$(tr -d '[:space:]' < "$TAPTIME_DEPLOY_VERSION_STATE_FILE")" = 'aaaaaaa'
printf 'Forced interruption evidence (exit 137):\n'
cat "$LOG_FILE"
printf 'No start or version write occurred; current-version is still aaaaaaa.\n'

printf 'Deployment orchestration tests passed.\n'
