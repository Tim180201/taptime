#!/usr/bin/env bash
set -euo pipefail

TEST_ROOT="$(mktemp -d)"
readonly TEST_ROOT
readonly LOG_FILE="$TEST_ROOT/calls.log"
readonly OUTPUT_FILE="$TEST_ROOT/output.log"
trap 'rm -rf -- "$TEST_ROOT"' EXIT

export TAPTIME_DEPLOY_COMPOSE_FILE="$TEST_ROOT/docker-compose.yml"
export TAPTIME_DEPLOY_BACKUP_CONFIG="$TEST_ROOT/backup.conf"
export TAPTIME_DEPLOY_VERSION_STATE_FILE="$TEST_ROOT/current-version"
export TAPTIME_DEPLOY_OPERATIONS_VERSION_STATE_FILE="$TEST_ROOT/operations-version"
export TAPTIME_DEPLOY_POSTGRES_VOLUME_STATE_FILE="$TEST_ROOT/postgres-volume"
export TAPTIME_DEPLOY_KNOWN_VERSIONS_FILE="$TEST_ROOT/known-versions"
export TAPTIME_DEPLOY_PROTECTED_VERSIONS_FILE="$TEST_ROOT/ghcr-protected-versions.json"
export TAPTIME_DEPLOY_HEALTH_URL='https://health.invalid/health'
export TAPTIME_DEPLOY_ADMIN_WEB_VERSION_URL='https://admin.invalid/version.txt'
export TAPTIME_DEPLOY_ADMIN_WEB_ROOT="$TEST_ROOT/admin-web"
export TAPTIME_DEPLOY_OPERATOR_WEB_ROOT="$TEST_ROOT/operator-web"
export TAPTIME_DEPLOY_OPERATOR_WEB_VERSION_URL="https://operator.invalid/version.txt"
printf 'services: {}\n' > "$TAPTIME_DEPLOY_COMPOSE_FILE"
printf '%s\n' \
  "BORG_REPOSITORY='ssh://synthetic@offsite.invalid:23/./taptime'" \
  "BORG_RSH='ssh -p 23 -i /synthetic-key -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile=/synthetic-known-hosts -o StrictHostKeyChecking=yes'" \
  "DATABASE_CONTAINER=taptime-database" \
  "DATABASE_NAME=taptime" \
  "WAL_SPOOL_DIRECTORY=/var/lib/taptime-wal" \
  "WAL_CONTAINER_DIRECTORY=/var/lib/postgresql/wal-archive" \
  "WAL_REPLICATION_SLOT=taptime_offsite_archive" \
  "WAL_ARCHIVE_INTERVAL_SECONDS=1" \
  "WAL_ARCHIVE_MISSED_CYCLES=2" \
  "WAL_ARCHIVE_STATUS_FILE=/var/lib/taptime-monitor/wal-archive-status.json" \
  "WAL_ARCHIVE_CACHE_DIRECTORY=/var/cache/taptime-wal-archive" \
  "BASE_BACKUP_KEEP_HOURLY=1" \
  "BASE_BACKUP_KEEP_DAILY=1" \
  "BASE_BACKUP_KEEP_WEEKLY=1" \
  "BASE_BACKUP_KEEP_MONTHLY=1" \
  "RESTORE_RECOVERY_TIMEOUT_SECONDS=14400" \
  "RESTORE_RECOVERY_POLL_SECONDS=1" \
  > "$TAPTIME_DEPLOY_BACKUP_CONFIG"
printf 'aaaaaaa\n' > "$TAPTIME_DEPLOY_VERSION_STATE_FILE"
printf 'ddddddd\n' > "$TAPTIME_DEPLOY_OPERATIONS_VERSION_STATE_FILE"

# shellcheck source=../deploy
source "$(dirname "$0")/../deploy"

hostname() {
  if [[ "${1:-}" == '-I' ]]; then
    printf '192.0.2.10 10.0.0.10\n'
  else
    printf 'synthetic-local\n'
  fi
}

getent() {
  [[ "${1:-}" == 'ahostsv4' ]] || return 1
  case "${2:-}" in
    offsite.invalid)
      printf '198.51.100.23 STREAM offsite.invalid\n'
      ;;
    local-alias.invalid)
      printf '192.0.2.10 STREAM local-alias.invalid\n'
      ;;
    *)
      return 2
      ;;
  esac
}
export -f hostname getent

printf 'unexpected-volume\n' > "$TAPTIME_DEPLOY_POSTGRES_VOLUME_STATE_FILE"
set +e
invalid_volume_output="$(selected_postgres_volume 2> "$TEST_ROOT/invalid-volume.log")"
invalid_volume_status=$?
set -e
(( invalid_volume_status != 0 ))
[[ -z "$invalid_volume_output" ]]
grep --quiet 'Invalid PostgreSQL volume state' "$TEST_ROOT/invalid-volume.log"
printf 'taptime-postgres-data\n' > "$TAPTIME_DEPLOY_POSTGRES_VOLUME_STATE_FILE"
[[ "$(selected_postgres_volume)" == 'taptime-postgres-data' ]]
printf 'PostgreSQL volume-state evidence: invalid state fails without a compose fallback.\n'

BROKEN_OPERATIONS_RELEASE="$TEST_ROOT/broken-operations"
readonly BROKEN_OPERATIONS_RELEASE
mkdir -p "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin"
printf '#!/usr/bin/env bash\n:\n' > "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin/taptime-landing-password"
printf '#!/usr/bin/env bash\n:\n' > "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin/taptime-operator-grant"
printf '#!/usr/bin/env bash\n:\n' > "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin/taptime-operator-db-login"
printf '#!/usr/bin/env bash\n:\n' > "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin/taptime-backup"
printf '#!/usr/bin/env bash\nif (\n' > "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin/taptime-restore-verify"
printf '#!/usr/bin/env bash\n:\n' > "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin/taptime-immediate-monitor"
printf '#!/usr/bin/env bash\n:\n' > "$BROKEN_OPERATIONS_RELEASE/usr/local/sbin/taptime-daily-monitor"

mkdir -p "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/status" \
  "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/assets" \
  "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/aaaaaaa" \
  "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/bbbbbbb"
printf 'persistent-status\n' > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/status/proof.txt"
printf '<script src="/assets/t006.js"></script>\n' > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/index.html"
printf 't006\n' > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/assets/t006.js"
printf 'aaaaaaa\n' > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/aaaaaaa/version.txt"
printf 'bbbbbbb\n' > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/bbbbbbb/version.txt"
mkdir -p "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/aaaaaaa/assets" \
  "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/bbbbbbb/assets"
printf '<script src="/releases/aaaaaaa/assets/old.js"></script>\n' \
  > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/aaaaaaa/index.html"
printf '<script src="/releases/bbbbbbb/assets/new.js"></script>\n' \
  > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/bbbbbbb/index.html"
printf 'old\n' > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/aaaaaaa/assets/old.js"
printf 'new\n' > "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/bbbbbbb/assets/new.js"
status_before="$(cksum "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/status/proof.txt")"
legacy_asset_before="$(cksum "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/assets/t006.js")"
# The production definition is loaded by the source command above.
# shellcheck disable=SC2218
activate_admin_web_release bbbbbbb >/dev/null
test "$(readlink "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/current")" = 'releases/bbbbbbb'
grep --quiet '/assets/t006.js' "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/index.html"
test "$(cksum "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/assets/t006.js")" = "$legacy_asset_before"
test -f "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/aaaaaaa/assets/old.js"
grep --quiet '/releases/aaaaaaa/assets/old.js' \
  "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/releases/aaaaaaa/index.html"
test "$(cksum "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/status/proof.txt")" = "$status_before"
# The production definition is loaded by the source command above.
# shellcheck disable=SC2218
activate_admin_web_release aaaaaaa >/dev/null
test "$(readlink "$TAPTIME_DEPLOY_ADMIN_WEB_ROOT/current")" = 'releases/aaaaaaa'

printf 'aaaaaaa\nccccccc\n' > "$TAPTIME_DEPLOY_KNOWN_VERSIONS_FILE"
test "$(select_operations_version bbbbbbb aaaaaaa ddddddd 0)" = ddddddd
test "$(select_operations_version bbbbbbb aaaaaaa ddddddd)" = bbbbbbb
test "$(select_operations_version ccccccc aaaaaaa ddddddd)" = ddddddd
test "$(select_operations_version aaaaaaa aaaaaaa ddddddd)" = ddddddd
printf 'Operations selection evidence: new app uses its release; known rollback keeps current operations.\n'
# The production definition is loaded by the source command above.
# shellcheck disable=SC2218
publish_protected_versions bbbbbbb aaaaaaa ddddddd
node -e '
  const snapshot = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  if (snapshot.current_version !== "bbbbbbb" || snapshot.previous_version !== "aaaaaaa") process.exit(1);
  if (snapshot.operations_version !== "ddddddd") process.exit(1);
  if (snapshot.known_versions.join(",") !== "aaaaaaa,bbbbbbb,ccccccc") process.exit(1);
' "$TAPTIME_DEPLOY_PROTECTED_VERSIONS_FILE"

record() {
  printf '%s\n' "$*" >> "$LOG_FILE"
}

require_root() { :; }
acquire_deploy_lock() { :; }
hold_backup_timer() { trap 'finish_deploy $?' EXIT; }
preflight_deploy() { :; }
preflight_operator_dns() { :; }
pull_image() { record "pull $1"; }
prepare_admin_web_release() { record "prepare-web $1 $2"; }
operator_web_capability() { printf "1\n"; }
prepare_operator_web_versions() { record "prepare-operator-versions $DESIRED_VERSION $PREVIOUS_VERSION"; }
select_operator_web_release() { ACTIVE_OPERATOR_WEB_VERSION="$1"; record "activate-operator $1 $2"; }
deploy_operations_release() {
  record "install-operations $1 $2"
  if [[ "${INSTALL_MISSING_COMPOSE:-0}" == '1' ]]; then
    printf 'services: {}\n' > "$COMPOSE_FILE"
  fi
  if [[ "${FAIL_OPERATIONS:-0}" == '1' ]]; then
    validate_operations_scripts "$BROKEN_OPERATIONS_RELEASE"
  fi
}
verify_local_rehearsal_image() { record "verify-local $1 $2"; }
image_supports_archive_ack_contract() {
  [[ "${TEST_IMAGE_ARCHIVE_CAPABLE:-1}" == '1' ]]
}
select_migration_version() { printf '%s\n' "$DESIRED_VERSION"; }
run_restore_verification() {
  record "restore-and-rehearsal $1 ${2:-0}"
  [[ "${FAIL_REHEARSAL:-0}" != '1' ]]
}
run_backup() { record backup; }
wal_archive_mount_state() { printf '%s\n' "${TEST_WAL_MOUNT_STATE:-active}"; }
archive_contract_is_active() { [[ "${TEST_ARCHIVE_CONTRACT_ACTIVE:-1}" == '1' ]]; }
ensure_wal_archive_runtime() { record ensure-wal-runtime; }
begin_wal_archive_cutover() {
  export ARCHIVE_CUTOVER_ACTIVE=1
  trap 'rollback_started_image $?' EXIT
  record begin-wal-cutover
}
activate_wal_receiver() { record activate-wal-receiver; }
prepare_offsite_wal_for_restore() { record "prepare-offsite-wal ${1:-0}"; }
complete_wal_archive_cutover() { record complete-wal-cutover; }
sync_migration_sources() { record "sync $1"; }
migrate_production() { record migrate-production; }
start_backend() { record "start $1"; }
ACTIVE_ADMIN_WEB_VERSION='aaaaaaa'
ACTIVE_OPERATOR_WEB_VERSION='aaaaaaa'
activate_admin_web_release() {
  ACTIVE_ADMIN_WEB_VERSION="$1"
  record "activate-web $1"
}
landing_web_capability() { printf "%s\n" "${TEST_LANDING_CAPABILITY:-1}"; }
initialize_landing_auth() { :; }
prepare_landing_web_versions() { :; }
select_landing_web_release() { :; }
verify_landing_or_disable() { :; }
# shellcheck disable=SC2034
save_running_caddy() { [[ "${FAIL_CADDY_SNAPSHOT:-0}" != 1 ]] || return 61; CADDY_RECOVERY_READY=1; }
# shellcheck disable=SC2317,SC2329
wait_for_edge() { :; }
restart_caddy() { record "restart-caddy $1"; }
wait_for_health() {
  record "health $1"
  [[ "$ACTIVE_ADMIN_WEB_VERSION" == "$1" && "$ACTIVE_OPERATOR_WEB_VERSION" == "$1" && "$1" != "${FAIL_HEALTH_VERSION:-}" ]]
}
write_current_version() { record "write-version $1"; }
mark_known_version() { :; }
publish_protected_versions() { record "publish-protected $1 $2 $3"; }

expect_status() {
  local expected="$1"
  shift
  local actual

  set +e
  ( "$@" ) >"$OUTPUT_FILE" 2>&1
  actual=$?
  set -e
  if (( actual != expected )); then
    printf 'Expected status %s, got %s for: %s\n' "$expected" "$actual" "$*" >&2
    cat "$OUTPUT_FILE" >&2
    exit 1
  fi
}

export BORG_RSH='ssh -p 23 -i /synthetic-key -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile=/synthetic-known-hosts -o StrictHostKeyChecking=yes'
export BORG_REPOSITORY="$TEST_ROOT/local-borg-repository"
expect_status 1 validate_offsite_borg_repository
grep --quiet 'must use non-local ssh:// storage' "$OUTPUT_FILE"
export BORG_REPOSITORY='ssh://synthetic@localhost:23/./taptime'
expect_status 1 validate_offsite_borg_repository
grep --quiet 'must not resolve by configuration to this host' "$OUTPUT_FILE"
export BORG_REPOSITORY='ssh://synthetic@local-alias.invalid:23/./taptime'
expect_status 1 validate_offsite_borg_repository
grep --quiet 'resolves to a local interface address' "$OUTPUT_FILE"
export BORG_REPOSITORY='ssh://synthetic@offsite.invalid:23/./taptime'
expect_status 0 validate_offsite_borg_repository
printf 'Offsite repository evidence: local paths, localhost and local aliases are rejected.\n'

assert_log() {
  local expected="$1"
  local actual
  actual="$(cat "$LOG_FILE" 2>/dev/null || true)"
  if [[ "$actual" != "$expected" ]]; then
    printf 'Unexpected call log.\nExpected:\n%s\nActual:\n%s\n' "$expected" "$actual" >&2
    exit 1
  fi
}

run_real_archive_barrier() {
  bash -c '
    set -euo pipefail
    source "$1"
    WAL_ARCHIVE_BOOTSTRAP=1
    ensure_wal_archive_runtime() { :; }
    prepare_offsite_wal_for_restore() { :; }
    docker() {
      if [[ "$*" == *pg_switch_wal* ]]; then
        printf "123456789|0/FFFFFF|000000010000000000000001\n"
      elif [[ "$*" == *offline_wal_requirement_is_archived_v1* ]]; then
        [[ "$*" == *"123456789'"'"'::bigint, '"'"'0/FFFFFF'"'"'::pg_lsn"* ]]
        printf "t\n"
      else
        return 1
      fi
    }
    complete_wal_archive_cutover
  ' bash "$(dirname "$0")/../deploy"
}

run_real_wal_preparation() {
  local preparation_log="$TEST_ROOT/wal-preparation.log"

  : > "$preparation_log"
  TAPTIME_DEPLOY_BACKUP_CONFIG="$TAPTIME_DEPLOY_BACKUP_CONFIG" \
    TAPTIME_DEPLOY_WAL_ARCHIVER_COMMAND=fake_archiver \
    bash -c '
      set -euo pipefail
      source "$1"
      preparation_log="$2"
      require_file() { :; }
      systemctl() { printf "systemctl %s\n" "$*" >> "$preparation_log"; }
      fake_archiver() {
        printf "archiver upload-only=%s run-once=%s\n" \
          "$TAPTIME_WAL_ARCHIVE_UPLOAD_ONLY" "$TAPTIME_WAL_ARCHIVE_RUN_ONCE" \
          >> "$preparation_log"
      }
      prepare_offsite_wal_for_restore 1
      prepare_offsite_wal_for_restore 0
    ' bash "$(dirname "$0")/../deploy" "$preparation_log"
  [[ "$(< "$preparation_log")" == "systemctl stop taptime-wal-archiver.service
archiver upload-only=1 run-once=1
systemctl stop taptime-wal-archiver.service
archiver upload-only=0 run-once=1
systemctl enable --now taptime-wal-archiver.service" ]]
}

run_real_health_probe() {
  local served_version="$1"
  local configuration="${2:-configured}"
  local issuer_line="${3:-SUPABASE_ISSUER=https://syntheticproject.supabase.co/auth/v1}"
  local env_file="$TEST_ROOT/backend.env"
  printf 'DATABASE_PASSWORD=never-printed\n%s\n' "$issuer_line" > "$env_file"
  TAPTIME_DEPLOY_BACKEND_ENV_FILE="$env_file" \
    SERVED_ADMIN_WEB_VERSION="$served_version" \
    SERVED_ADMIN_WEB_CONFIGURATION="$configuration" bash -c '
    set -euo pipefail
    source "$1"
    compose() { printf "synthetic-backend-container\n"; }
    docker() {
      if [[ "$3" == "{{.Config.Image}}" ]]; then
        printf "ghcr.io/tim180201/taptime-backend-api:bbbbbbb\n"
      else
        printf "healthy\n"
      fi
    }
    curl() {
      local url="${!#}"
      if [[ "$url" == https://operator.invalid/* ]]; then
        printf "404"
      elif [[ "$url" == "$ADMIN_WEB_VERSION_URL" ]]; then
        printf "%s\n" "$SERVED_ADMIN_WEB_VERSION"
      elif [[ "$url" == "${ADMIN_WEB_VERSION_URL%version.txt}" ]]; then
        printf "<script type=\"module\" src=\"/releases/bbbbbbb/assets/application.js\"></script>\n"
      elif [[ "$url" == "${ADMIN_WEB_VERSION_URL%version.txt}releases/bbbbbbb/assets/application.js" ]]; then
        case "$SERVED_ADMIN_WEB_CONFIGURATION" in
          configured)
            printf "const origin=\"https://syntheticproject.supabase.co\";const key=\"sb_publishable_synthetic_public_value\";\n" ;;
          foreign)
            printf "const origin=\"https://otherproject.supabase.co\";const key=\"sb_publishable_synthetic_public_value\";\n" ;;
          ambiguous)
            printf "const a=\"https://syntheticproject.supabase.co\";const b=\"https://otherproject.supabase.co\";const key=\"sb_publishable_synthetic_public_value\";\n" ;;
          *)
            printf "const origin=\"\";const key=\"\";\n" ;;
        esac
      fi
    }
    sleep() { :; }
    wait_for_health bbbbbbb
  ' bash "$(dirname "$0")/../deploy"
}

expect_status 1 run_real_health_probe aaaaaaa
grep --quiet 'Version bbbbbbb did not become healthy' "$OUTPUT_FILE"
printf 'Wrong Admin Web health evidence: expected=bbbbbbb served=aaaaaaa result=rejected\n'
expect_status 1 run_real_health_probe bbbbbbb missing
grep --quiet 'Admin Web bundle has no valid configured Supabase origin' "$OUTPUT_FILE"
printf 'Unconfigured Admin Web startup evidence: version=bbbbbbb configuration=missing result=rejected\n'
expect_status 0 run_real_health_probe bbbbbbb
grep --quiet 'Backend und startfähiges Admin-Web belegen gemeinsam Version bbbbbbb' "$OUTPUT_FILE"
printf 'Matching startable Admin Web evidence: expected=bbbbbbb served=bbbbbbb result=accepted\n'

# T-039: a valid-looking Supabase origin is not enough. The bundle must be built for the
# issuer the backend trusts, and for no other project.
expect_status 1 run_real_health_probe bbbbbbb foreign
grep --quiet 'built for a Supabase origin the backend does not trust' "$OUTPUT_FILE"
grep --quiet 'bundle: https://otherproject.supabase.co' "$OUTPUT_FILE"
grep --quiet 'backend: https://syntheticproject.supabase.co' "$OUTPUT_FILE"
printf 'Foreign issuer evidence: bundle=otherproject backend=syntheticproject result=rejected\n'
expect_status 1 run_real_health_probe bbbbbbb ambiguous
grep --quiet 'built for a Supabase origin the backend does not trust' "$OUTPUT_FILE"
printf 'Ambiguous issuer evidence: two origins in one bundle result=rejected\n'
expect_status 1 run_real_health_probe bbbbbbb configured 'UNRELATED=1'
grep --quiet 'SUPABASE_ISSUER is not set' "$OUTPUT_FILE"
printf 'Unknown issuer evidence: no SUPABASE_ISSUER in backend environment result=rejected\n'
expect_status 0 run_real_health_probe bbbbbbb configured \
  'SUPABASE_ISSUER="https://syntheticproject.supabase.co/auth/v1/"'
printf 'Quoted issuer with trailing slash: normalized and accepted\n'
expect_status 1 run_real_health_probe bbbbbbb configured \
  'SUPABASE_ISSUER=https://syntheticproject.supabase.co'
grep --quiet 'must be exactly' "$OUTPUT_FILE"
expect_status 1 run_real_health_probe bbbbbbb configured \
  'SUPABASE_ISSUER=https://syntheticproject.supabase.co/auth/v1garbage'
grep --quiet 'must be exactly' "$OUTPUT_FILE"
expect_status 1 run_real_health_probe bbbbbbb configured \
  'SUPABASE_ISSUER=https://syntheticproject.supabase.co/rest/v1'
grep --quiet 'must be exactly' "$OUTPUT_FILE"
printf 'Issuer shape evidence: bare origin, trailing garbage and other paths are rejected (review round 2)\n'
if grep --quiet 'never-printed' "$OUTPUT_FILE"; then
  printf 'The deploy leaked a value from the backend environment file.\n' >&2
  exit 1
fi
printf 'Environment file evidence: only SUPABASE_ISSUER was read, nothing else surfaced\n'

expect_status 64 main
grep --quiet '^Usage: .* <seven-character-commit-hash>$' "$OUTPUT_FILE"

expect_status 1 main latest
grep --quiet 'Version must be exactly one seven-character lowercase commit hash' "$OUTPUT_FILE"

expect_status 0 run_real_archive_barrier
grep --quiet 'Externe WAL-Barriere belegt' "$OUTPUT_FILE"
printf 'WAL barrier evidence: the cluster-bound three-argument SQL contract was used.\n'

expect_status 0 run_real_wal_preparation
printf 'WAL bootstrap evidence: upload-only keeps the normal archiver stopped until migration.\n'

: > "$LOG_FILE"
TEST_LANDING_CAPABILITY=0 expect_status 0 main bbbbbbb
# bbbbbbb is not in known-versions. Its already published old operations image is unusable;
# the controller must select the installed current operations before any old image pull.
grep --quiet '^install-operations ghcr.io/tim180201/taptime-backend-api:operations-ddddddd ddddddd$' "$LOG_FILE"
if grep --quiet 'operations-bbbbbbb' "$LOG_FILE"; then
  printf 'Historical target attempted its incompatible immutable operations image.\n' >&2
  exit 1
fi
printf 'Historical target without landing keeps compatible operations even when not previously deployed.\n'

: > "$LOG_FILE"
FAIL_CADDY_SNAPSHOT=1 expect_status 61 main bbbbbbb
if grep --quiet -E '^(install-operations|migrate-production|start|restart-caddy|activate-web) ' "$LOG_FILE"; then
  printf 'Snapshot failure allowed a switch.\n' >&2
  exit 1
fi
printf 'Caddy snapshot failure stops before operations, migrations and traffic switches.\n'

: > "$LOG_FILE"
TEST_IMAGE_ARCHIVE_CAPABLE=0 expect_status 1 main bbbbbbb
grep --quiet 'cannot honor delayed archive acknowledgement' "$OUTPUT_FILE"
assert_log "pull ghcr.io/tim180201/taptime-backend-api:bbbbbbb
pull ghcr.io/tim180201/taptime-backend-api:aaaaaaa
pull ghcr.io/tim180201/taptime-backend-api:admin-web-bbbbbbb
pull ghcr.io/tim180201/taptime-backend-api:admin-web-aaaaaaa
pull ghcr.io/tim180201/taptime-backend-api:operations-bbbbbbb"
printf 'Archive-contract image evidence: an incapable target was rejected before installation.\n'

: > "$LOG_FILE"
TEST_ARCHIVE_CONTRACT_ACTIVE=0 expect_status 0 main bbbbbbb
cutover_line="$(grep --line-number '^begin-wal-cutover$' "$LOG_FILE" | cut -d: -f1)"
upload_only_line="$(grep --line-number '^prepare-offsite-wal 1$' "$LOG_FILE" | cut -d: -f1)"
migration_line="$(grep --line-number '^migrate-production$' "$LOG_FILE" | cut -d: -f1)"
normal_archive_line="$(grep --line-number '^prepare-offsite-wal 0$' "$LOG_FILE" | cut -d: -f1)"
[[ "$cutover_line" -lt "$upload_only_line" \
  && "$upload_only_line" -lt "$migration_line" \
  && "$migration_line" -lt "$normal_archive_line" ]]
if grep --quiet '^ensure-wal-runtime$' "$LOG_FILE"; then
  printf 'A database without the archive contract started the normal archiver too early.\n' >&2
  exit 1
fi
printf 'Historical-contract bootstrap evidence: active mount still stops old ingestion and uploads WAL before migration.\n'
ACTIVE_ADMIN_WEB_VERSION='aaaaaaa'
ACTIVE_OPERATOR_WEB_VERSION='aaaaaaa'

: > "$LOG_FILE"
rm -f "$TAPTIME_DEPLOY_COMPOSE_FILE"
INSTALL_MISSING_COMPOSE=1 FAIL_OPERATIONS=1 expect_status 2 main bbbbbbb
grep --quiet 'unexpected end of file' "$OUTPUT_FILE"
test -f "$TAPTIME_DEPLOY_COMPOSE_FILE"
assert_log "pull ghcr.io/tim180201/taptime-backend-api:bbbbbbb
pull ghcr.io/tim180201/taptime-backend-api:aaaaaaa
pull ghcr.io/tim180201/taptime-backend-api:admin-web-bbbbbbb
pull ghcr.io/tim180201/taptime-backend-api:admin-web-aaaaaaa
pull ghcr.io/tim180201/taptime-backend-api:operations-bbbbbbb
prepare-web ghcr.io/tim180201/taptime-backend-api:admin-web-bbbbbbb bbbbbbb
