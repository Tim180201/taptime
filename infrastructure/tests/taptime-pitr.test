#!/usr/bin/env bash
set -euo pipefail
umask 0077

REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly REPOSITORY_ROOT
# shellcheck source=../backup/taptime-restore-verify
source "$REPOSITORY_ROOT/infrastructure/backup/taptime-restore-verify"

readonly IMAGE="${TAPTIME_PITR_TEST_IMAGE:-postgres:17.10-bookworm}"
readonly RECOVERY_TIMEOUT_SECONDS="${TAPTIME_PITR_TEST_TIMEOUT_SECONDS:-120}"
readonly RECOVERY_POLL_SECONDS="${TAPTIME_PITR_TEST_POLL_SECONDS:-1}"
[[ "$RECOVERY_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ \
  && "$RECOVERY_POLL_SECONDS" =~ ^[1-9][0-9]*$ ]]
POSTGRES_UID="$(docker run --rm --network none "$IMAGE" id -u postgres)"
readonly POSTGRES_UID
POSTGRES_GID="$(docker run --rm --network none "$IMAGE" id -g postgres)"
readonly POSTGRES_GID
[[ "$POSTGRES_UID" =~ ^[0-9]+$ && "$POSTGRES_GID" =~ ^[0-9]+$ ]] || {
  printf 'PostgreSQL image returned no valid runtime identity.\n' >&2
  exit 1
}
RESTORE_IMAGE="$IMAGE"
# Keep bind-mounted evidence below the checkout so macOS container runtimes and Linux CI
# observe the same files; system temporary directories are not necessarily shared into a VM.
readonly TEST_ROOT="$(mktemp -d "$REPOSITORY_ROOT/.taptime-pitr.XXXXXX")"
readonly SOURCE_CONTAINER="taptime-pitr-source-$$"
readonly LATEST_RESTORE_CONTAINER="taptime-pitr-latest-$$"
readonly HISTORICAL_RESTORE_CONTAINER="taptime-pitr-historical-$$"
readonly SOURCE_VOLUME="taptime-pitr-source-$$"
readonly BASE_DIRECTORY="$TEST_ROOT/base"
readonly WAL_DIRECTORY="$TEST_ROOT/wal"
readonly LATEST_RESTORE_DIRECTORY="$TEST_ROOT/latest-restore"
readonly HISTORICAL_RESTORE_DIRECTORY="$TEST_ROOT/historical-restore"
readonly HOST_UID="$(id -u)"
readonly HOST_GID="$(id -g)"
readonly EARLIER_CHANGE='earlier-change'
readonly LATER_CHANGE='later-change'

cleanup() {
  local status="$?"

  docker rm --force "$SOURCE_CONTAINER" "$LATEST_RESTORE_CONTAINER" \
    "$HISTORICAL_RESTORE_CONTAINER" >/dev/null 2>&1 || true
  docker volume rm "$SOURCE_VOLUME" >/dev/null 2>&1 || true
  docker run --rm --user root --network none --volume "$TEST_ROOT:/test" \
    "$IMAGE" chown -R "$HOST_UID:$HOST_GID" /test >/dev/null 2>&1 || true
  if (( status != 0 )) && [[ "${TAPTIME_PITR_TEST_KEEP_FAILURE:-0}" == '1' ]]; then
    printf 'Failed PITR evidence retained at %s.\n' "$TEST_ROOT" >&2
    return "$status"
  fi
  rm -rf -- "$TEST_ROOT"
  return "$status"
}
trap cleanup EXIT

wait_for_postgres() {
  local container="$1"
  local deadline recovery_complete='f'

  deadline=$(( $(date +%s) + RECOVERY_TIMEOUT_SECONDS ))
  while (( $(date +%s) < deadline )); do
    if docker exec --user postgres "$container" pg_isready --dbname=postgres \
      >/dev/null 2>&1; then
      recovery_complete="$(docker exec --user postgres "$container" psql \
        --tuples-only --no-align --dbname=postgres --set ON_ERROR_STOP=on \
        --command 'SELECT NOT pg_catalog.pg_is_in_recovery();' 2>/dev/null || true)"
      [[ "$recovery_complete" == 't' ]] && return 0
    fi
    sleep "$RECOVERY_POLL_SECONDS"
  done
  docker logs "$container" >&2 || true
  return 1
}

install -d -m 0777 "$BASE_DIRECTORY" "$WAL_DIRECTORY"
docker run --rm --user root --network none \
  --volume "$BASE_DIRECTORY:/base" --volume "$WAL_DIRECTORY:/archive" \
  "$IMAGE" chown -R "$POSTGRES_UID:$POSTGRES_GID" /base /archive
docker volume create "$SOURCE_VOLUME" >/dev/null

docker run --detach --name "$SOURCE_CONTAINER" --network none \
  --env POSTGRES_HOST_AUTH_METHOD=trust \
  --volume "$SOURCE_VOLUME:/var/lib/postgresql/data" \
  --volume "$BASE_DIRECTORY:/base" \
  --volume "$WAL_DIRECTORY:/archive" \
  "$IMAGE" postgres \
    -c wal_level=replica \
    -c archive_mode=on \
    -c 'archive_command=test ! -f /archive/%f && cp %p /archive/%f' \
  >/dev/null
wait_for_postgres "$SOURCE_CONTAINER"

docker exec --user postgres "$SOURCE_CONTAINER" psql --set ON_ERROR_STOP=on \
  --dbname=postgres --command '
    CREATE TABLE public.pitr_proof (
      proof_key text PRIMARY KEY,
      created_at timestamptz NOT NULL DEFAULT pg_catalog.clock_timestamp()
    );
  ' >/dev/null

docker exec --user postgres "$SOURCE_CONTAINER" pg_basebackup \
  --dbname='dbname=postgres' --pgdata=/base --format=plain --wal-method=stream \
  --checkpoint=fast --manifest-checksums=SHA256

docker exec --user postgres "$SOURCE_CONTAINER" psql --set ON_ERROR_STOP=on \
  --dbname=postgres --command \
  "INSERT INTO public.pitr_proof (proof_key) VALUES ('$EARLIER_CHANGE');" >/dev/null
recovery_target="$(docker exec --user postgres "$SOURCE_CONTAINER" psql \
  --tuples-only --no-align --dbname=postgres --command \
  "SELECT to_char(pg_catalog.clock_timestamp() AT TIME ZONE 'UTC',
    'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"');")"
[[ "$recovery_target" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]] || {
  printf 'Could not derive a recovery target between the changes.\n' >&2
  exit 1
}
docker exec --user postgres "$SOURCE_CONTAINER" psql --set ON_ERROR_STOP=on \
  --dbname=postgres --command \
  "INSERT INTO public.pitr_proof (proof_key) VALUES ('$LATER_CHANGE');" >/dev/null
changed_wal="$(docker exec --user postgres "$SOURCE_CONTAINER" psql \
  --tuples-only --no-align --dbname=postgres --command \
  "SELECT pg_catalog.pg_walfile_name(pg_catalog.pg_current_wal_lsn());")"
[[ "$changed_wal" =~ ^[0-9A-F]{24}$ ]] || {
  printf 'PostgreSQL returned an invalid changed WAL filename.\n' >&2
  exit 1
}
docker exec --user postgres "$SOURCE_CONTAINER" psql --set ON_ERROR_STOP=on \
  --dbname=postgres --command 'SELECT pg_catalog.pg_switch_wal();' >/dev/null
docker exec --user postgres "$SOURCE_CONTAINER" psql --set ON_ERROR_STOP=on \
  --dbname=postgres --command \
  "INSERT INTO public.pitr_proof (proof_key) VALUES ('archive-padding-one');
   SELECT pg_catalog.pg_switch_wal();" >/dev/null
docker exec --user postgres "$SOURCE_CONTAINER" psql --set ON_ERROR_STOP=on \
  --dbname=postgres --command \
  "INSERT INTO public.pitr_proof (proof_key) VALUES ('archive-padding-two');" >/dev/null
final_wal="$(docker exec --user postgres "$SOURCE_CONTAINER" psql \
  --tuples-only --no-align --dbname=postgres --command \
  "SELECT pg_catalog.pg_walfile_name(pg_catalog.pg_current_wal_lsn());")"
docker exec --user postgres "$SOURCE_CONTAINER" psql --set ON_ERROR_STOP=on \
  --dbname=postgres --command 'SELECT pg_catalog.pg_switch_wal();' >/dev/null

archive_deadline=$(( $(date +%s) + RECOVERY_TIMEOUT_SECONDS ))
while [[ ! -f "$WAL_DIRECTORY/$changed_wal" \
  || ! -f "$WAL_DIRECTORY/$final_wal" ]]; do
  if (( $(date +%s) >= archive_deadline )); then
    printf 'The WAL segments containing the proof changes were not archived.\n' >&2
    docker logs "$SOURCE_CONTAINER" >&2 || true
    exit 1
  fi
  sleep "$RECOVERY_POLL_SECONDS"
done

start_wal_lsn="$(docker exec --user postgres "$SOURCE_CONTAINER" sed -n \
  's/^START WAL LOCATION: \([^ ]*\) .*/\1/p' /base/backup_label)"
start_wal_file="$(docker exec --user postgres "$SOURCE_CONTAINER" sed -n \
  's/^START WAL LOCATION: .* (file \([0-9A-F]\{24\}\))$/\1/p' \
  /base/backup_label)"

docker stop "$SOURCE_CONTAINER" >/dev/null
docker rm "$SOURCE_CONTAINER" >/dev/null
docker run --rm --user root --network none --volume "$TEST_ROOT:/test" \
  "$IMAGE" chown -R "$HOST_UID:$HOST_GID" /test/base /test/wal
find "$WAL_DIRECTORY" -type d -exec chmod 0755 {} +
find "$WAL_DIRECTORY" -type f -exec chmod 0444 {} +

latest_wal_file="$(validate_wal_chain \
  "$start_wal_file" "$WAL_DIRECTORY" "$BASE_DIRECTORY")"
latest_record_lsn="$(latest_wal_record_lsn \
  "$WAL_DIRECTORY" "$start_wal_lsn" "$start_wal_file" "$latest_wal_file")"

mkdir "$TEST_ROOT/gap-wal"
cp -a "$WAL_DIRECTORY/." "$TEST_ROOT/gap-wal/"
missing_wal=''
while IFS= read -r candidate_wal; do
  if [[ "$candidate_wal" > "$start_wal_file" \
    && "$candidate_wal" < "$latest_wal_file" ]]; then
    missing_wal="$candidate_wal"
    rm "$TEST_ROOT/gap-wal/$candidate_wal"
    break
  fi
done < <({
  for candidate_path in "$WAL_DIRECTORY"/*; do
    [[ -f "$candidate_path" ]] || continue
    candidate_name="${candidate_path##*/}"
    [[ "$candidate_name" =~ ^[0-9A-F]{24}$ ]] && printf '%s\n' "$candidate_name"
  done
} | sort)
[[ -n "$missing_wal" ]] || {
  printf 'The PITR fixture produced no intermediate WAL segment for the gap proof.\n' >&2
  exit 1
}
if validate_wal_chain "$start_wal_file" "$TEST_ROOT/gap-wal" "$BASE_DIRECTORY" \
  >/dev/null 2>&1; then
  printf 'WAL chain validation accepted a missing real intermediate segment.\n' >&2
  exit 1
fi

mkdir "$LATEST_RESTORE_DIRECTORY"
cp -a "$BASE_DIRECTORY/." "$LATEST_RESTORE_DIRECTORY/"
docker run --rm --network none --volume "$LATEST_RESTORE_DIRECTORY:/backup:ro" \
  "$IMAGE" pg_verifybackup /backup
unset TAPTIME_RESTORE_TARGET_TIME
configure_point_in_time_recovery "$LATEST_RESTORE_DIRECTORY" "$latest_record_lsn"
docker run --rm --user root --network none \
  --volume "$LATEST_RESTORE_DIRECTORY:/restore" \
  "$IMAGE" chown -R "$POSTGRES_UID:$POSTGRES_GID" /restore

docker run --detach --name "$LATEST_RESTORE_CONTAINER" --network none --read-only \
  --volume "$LATEST_RESTORE_DIRECTORY:/var/lib/postgresql/data" \
  --volume "$WAL_DIRECTORY:/var/lib/postgresql/wal-restore:ro" \
  --tmpfs "/var/run/postgresql:rw,noexec,nosuid,size=64m,uid=$POSTGRES_UID,gid=$POSTGRES_GID,mode=0775" \
  "$IMAGE" >/dev/null
wait_for_postgres "$LATEST_RESTORE_CONTAINER"

latest_proof="$(docker exec --user postgres "$LATEST_RESTORE_CONTAINER" psql \
  --tuples-only --no-align --dbname=postgres --set ON_ERROR_STOP=on --command \
  "SELECT EXISTS (
      SELECT FROM public.pitr_proof WHERE proof_key = '$EARLIER_CHANGE'
    ) AND EXISTS (
      SELECT FROM public.pitr_proof WHERE proof_key = '$LATER_CHANGE'
    ) AND pg_catalog.pg_last_wal_replay_lsn() >= '$latest_record_lsn'::pg_lsn;")"
[[ "$latest_proof" == 't' ]] || {
  printf 'Latest restore did not preserve both changes through the last WAL record.\n' >&2
  exit 1
}
docker rm --force "$LATEST_RESTORE_CONTAINER" >/dev/null

mkdir "$HISTORICAL_RESTORE_DIRECTORY"
cp -a "$BASE_DIRECTORY/." "$HISTORICAL_RESTORE_DIRECTORY/"
docker run --rm --network none --volume "$HISTORICAL_RESTORE_DIRECTORY:/backup:ro" \
  "$IMAGE" pg_verifybackup /backup
TAPTIME_RESTORE_TARGET_TIME="$recovery_target" \
  configure_point_in_time_recovery "$HISTORICAL_RESTORE_DIRECTORY"
docker run --rm --user root --network none \
  --volume "$HISTORICAL_RESTORE_DIRECTORY:/restore" \
  "$IMAGE" chown -R "$POSTGRES_UID:$POSTGRES_GID" /restore

docker run --detach --name "$HISTORICAL_RESTORE_CONTAINER" --network none --read-only \
  --volume "$HISTORICAL_RESTORE_DIRECTORY:/var/lib/postgresql/data" \
  --volume "$WAL_DIRECTORY:/var/lib/postgresql/wal-restore:ro" \
  --tmpfs "/var/run/postgresql:rw,noexec,nosuid,size=64m,uid=$POSTGRES_UID,gid=$POSTGRES_GID,mode=0775" \
  "$IMAGE" >/dev/null
wait_for_postgres "$HISTORICAL_RESTORE_CONTAINER"

historical_proof="$(docker exec --user postgres "$HISTORICAL_RESTORE_CONTAINER" psql \
  --tuples-only --no-align --dbname=postgres --set ON_ERROR_STOP=on --command \
  "SELECT EXISTS (
      SELECT FROM public.pitr_proof WHERE proof_key = '$EARLIER_CHANGE'
    ) AND NOT EXISTS (
      SELECT FROM public.pitr_proof WHERE proof_key = '$LATER_CHANGE'
    );")"
[[ "$historical_proof" == 't' ]] || {
  printf 'Point-in-time restore did not preserve only the earlier change.\n' >&2
  exit 1
}

printf 'Latest restore evidence: both changes present through the last WAL record.\n'
printf 'Point-in-time restore evidence: earlier change present; later change absent.\n'
