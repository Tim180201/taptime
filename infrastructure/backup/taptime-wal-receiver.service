[Unit]
Description=TapTim.e continuous PostgreSQL WAL receiver
Wants=docker.service
After=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/taptime-wal-receiver
User=root
Group=root
UMask=0077
Restart=always
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/taptime-wal /var/run/docker.sock

[Install]
WantedBy=multi-user.target
