[Unit]
Description=TapTim.e encrypted PostgreSQL backup to Storage Box
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
TimeoutStartSec=70min
TimeoutStopSec=30s
ExecStart=/usr/local/sbin/taptime-backup
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CacheDirectory=taptime-borg
CacheDirectoryMode=0700
StateDirectory=taptime-monitor taptime-borg taptime-backup
StateDirectoryMode=0700
ReadWritePaths=/var/lib/taptime-backup /run/lock /opt/taptime/admin-web
