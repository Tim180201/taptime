[Unit]
Description=TapTim.e automatic isolated Borg restore verification
Wants=docker.service
After=docker.service taptime-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/taptime-restore-verify
User=root
Group=root
UMask=0077
RuntimeDirectory=taptime-backup
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
StateDirectory=taptime-monitor
StateDirectoryMode=0700
ReadWritePaths=/run/taptime-backup /run/lock /var/lib/docker /var/lib/taptime-monitor /var/run/docker.sock
