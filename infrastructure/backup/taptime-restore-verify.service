[Unit]
Description=TapTim.e automatic isolated Borg restore verification
Wants=docker.service
After=docker.service taptime-backup.service

[Service]
Type=oneshot
TimeoutStartSec=110min
TimeoutStopSec=30s
ExecStart=/usr/local/sbin/taptime-restore-verify
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CacheDirectory=taptime-borg
CacheDirectoryMode=0700
StateDirectory=taptime-monitor taptime-borg taptime-backup
StateDirectoryMode=0700
ReadWritePaths=/var/lib/taptime-backup /run/lock /var/lib/docker /var/lib/taptime-monitor /var/run/docker.sock
