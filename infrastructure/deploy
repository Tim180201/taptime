verify_local_rehearsal_image() {
  local image="$1"
  local expected_version="$2"
  local revision

  docker image inspect "$image" >/dev/null ||
    fail "Local rehearsal image does not exist: $image"
  revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")"
  [[ "$revision" == "$expected_version"* ]] ||
    fail "Local rehearsal image revision does not match migration version $expected_version."
  say "[Test] Verwende lokal abgeleitetes Probe-Abbild $image."
}

image_has_migrator() {
  docker run --rm --entrypoint test "$1" -f /app/schema/migrate.js
}

image_supports_archive_ack_contract() {
  docker run --rm --entrypoint test "$1" \
    -f /app/contracts/lifecycle-archive-ack-v1
}

select_migration_version() {
  local desired_image="$1"
  local previous_image="$2"

  if image_has_migrator "$desired_image"; then
    printf '%s\n' "$DESIRED_VERSION"
    return 0
  fi
  if [[ -f "$KNOWN_VERSIONS_FILE" ]] &&
    grep --fixed-strings --line-regexp --quiet "$DESIRED_VERSION" "$KNOWN_VERSIONS_FILE" &&
    image_has_migrator "$previous_image"; then
    say "Rücknahme-Abbild $DESIRED_VERSION stammt von vor T-014; Migrationen laufen mit $PREVIOUS_VERSION." >&2
    printf '%s\n' "$PREVIOUS_VERSION"
    return 0
  fi
  fail "Target image $desired_image has no migration runner and is not a known rollback version." >&2
}

docker_hook() {
  set -euo pipefail

  local real_docker="${TAPTIME_REAL_DOCKER:?TAPTIME_REAL_DOCKER is required}"
  if [[ "${1:-}" == 'rm' && "${2:-}" == '--force' &&
    "${3:-}" == taptime-restore-verify-* ]]; then
    local container="$3"
    local start_ns end_ns duration_ms migration_status=0
    start_ns="$(date +%s%N)"
    set +e
    "$real_docker" run --rm --network "container:$container" \
      --env "B3_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/${TAPTIME_HOOK_DATABASE_NAME:?}" \
      --entrypoint node "${TAPTIME_HOOK_MIGRATION_IMAGE:?}" schema/migrate.js \
      >"${TAPTIME_HOOK_LOG:?}" 2>&1
    migration_status=$?
    set -e
    end_ns="$(date +%s%N)"
    duration_ms=$(( (end_ns - start_ns) / 1000000 ))
    if (( migration_status == 0 )); then
      printf 'ok %s\n' "$duration_ms" >"${TAPTIME_HOOK_STATUS:?}"
    else
      printf 'failed %s\n' "$duration_ms" >"${TAPTIME_HOOK_STATUS:?}"
    fi
  fi
  exec "$real_docker" "$@"
}

run_restore_verification() (
  set -euo pipefail

  local image="$1"
  local rehearsal_only="${2:-0}"
  local base_archive="${3:?A deployment must pin its own physical base}"
  local restore_status hook_directory hook_status hook_log before after real_docker script_path
  local verify_status=0 hook_state duration_ms

  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  restore_status="${RESTORE_STATUS_FILE:-$RESTORE_STATUS_FILE_DEFAULT}"
  : "${DATABASE_NAME:?DATABASE_NAME must be configured}"
  [[ "$rehearsal_only" == '0' || "$rehearsal_only" == '1' ]] ||
    fail 'Restore rehearsal mode must be 0 or 1.'
  require_file "$RESTORE_VERIFY_COMMAND"
  install -d -m 0700 /run/taptime-backup
  [[ "$(findmnt -n -o FSTYPE --target /run/taptime-backup)" == 'tmpfs' ]] ||
    fail '/run/taptime-backup must be a tmpfs; refusing migration rehearsal.'

  hook_directory="$(mktemp -d /run/taptime-backup/deploy-hook.XXXXXX)"
  hook_status="$hook_directory/status"
  hook_log="$hook_directory/migration.log"
  script_path="$(readlink -f "${BASH_SOURCE[0]}")"
  real_docker="$(command -v docker)"
  ln -s "$script_path" "$hook_directory/docker"
  # Invoked by the EXIT trap below.
  # shellcheck disable=SC2317,SC2329
  cleanup_hook() {
    if [[ "$hook_directory" == /run/taptime-backup/deploy-hook.* && -d "$hook_directory" ]]; then
      rm -rf -- "$hook_directory"
    fi
  }
  trap cleanup_hook EXIT

  before="$(status_fingerprint "$restore_status")"
  say "[1/7] T-007 stellt die eigene Basis $base_archive wieder her; Migrationen laufen vor deren Cleanup."
  set +e
  PATH="$hook_directory:$PATH" \
    TAPTIME_REAL_DOCKER="$real_docker" \
    TAPTIME_HOOK_DATABASE_NAME="$DATABASE_NAME" \
    TAPTIME_HOOK_MIGRATION_IMAGE="$image" \
    TAPTIME_HOOK_STATUS="$hook_status" \
    TAPTIME_HOOK_LOG="$hook_log" \
    TAPTIME_RESTORE_REHEARSAL_ONLY="$rehearsal_only" \
    TAPTIME_RESTORE_BASE_ARCHIVE="$base_archive" \
    "$RESTORE_VERIFY_COMMAND"
  verify_status=$?
  set -e
  [[ ! -s "$hook_log" ]] || cat "$hook_log"
  (( verify_status == 0 )) || fail 'T-007 restore verification failed.'

  after="$(status_fingerprint "$restore_status")"
  [[ "$after" != "$before" ]] || fail 'T-007 did not produce a fresh status record.'
  grep --quiet '"state":"ok"' "$restore_status" || fail 'T-007 did not finish successfully.'
  require_file "$hook_status"
  read -r hook_state duration_ms < "$hook_status"
  [[ "$hook_state" == 'ok' ]] || fail "Migration rehearsal failed after ${duration_ms:-unknown} ms."
  say "[1/7] Migrations-Generalprobe im T-007-Container erfolgreich: $duration_ms ms."
)

validate_wal_archive_configuration() (
  set -euo pipefail

  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  : "${DATABASE_CONTAINER:?DATABASE_CONTAINER must be configured}"
  : "${DATABASE_NAME:?DATABASE_NAME must be configured}"
  : "${WAL_SPOOL_DIRECTORY:?WAL_SPOOL_DIRECTORY must be configured}"
  : "${WAL_CONTAINER_DIRECTORY:?WAL_CONTAINER_DIRECTORY must be configured}"
  : "${WAL_REPLICATION_SLOT:?WAL_REPLICATION_SLOT must be configured}"
  : "${WAL_ARCHIVE_INTERVAL_SECONDS:?WAL_ARCHIVE_INTERVAL_SECONDS must be configured}"
  : "${WAL_ARCHIVE_MISSED_CYCLES:?WAL_ARCHIVE_MISSED_CYCLES must be configured}"
  : "${WAL_ARCHIVE_STATUS_FILE:?WAL_ARCHIVE_STATUS_FILE must be configured}"
  : "${WAL_ARCHIVE_CACHE_DIRECTORY:?WAL_ARCHIVE_CACHE_DIRECTORY must be configured}"
  : "${BASE_BACKUP_KEEP_HOURLY:?BASE_BACKUP_KEEP_HOURLY must be configured}"
  : "${BASE_BACKUP_KEEP_DAILY:?BASE_BACKUP_KEEP_DAILY must be configured}"
  : "${BASE_BACKUP_KEEP_WEEKLY:?BASE_BACKUP_KEEP_WEEKLY must be configured}"
  : "${BASE_BACKUP_KEEP_MONTHLY:?BASE_BACKUP_KEEP_MONTHLY must be configured}"
  : "${RESTORE_RECOVERY_TIMEOUT_SECONDS:?RESTORE_RECOVERY_TIMEOUT_SECONDS must be configured}"
  : "${RESTORE_RECOVERY_POLL_SECONDS:?RESTORE_RECOVERY_POLL_SECONDS must be configured}"
  validate_offsite_borg_repository
  [[ "$WAL_SPOOL_DIRECTORY" == '/var/lib/taptime-wal' ]] ||
    fail 'WAL_SPOOL_DIRECTORY must match the systemd and Compose path.'
  [[ "$WAL_CONTAINER_DIRECTORY" == '/var/lib/postgresql/wal-archive' ]] ||
    fail 'WAL_CONTAINER_DIRECTORY must match the Compose path.'
  [[ "$WAL_ARCHIVE_STATUS_FILE" == '/var/lib/taptime-monitor/wal-archive-status.json' ]] ||
    fail 'WAL_ARCHIVE_STATUS_FILE must match the monitoring service path.'
  [[ "$WAL_ARCHIVE_CACHE_DIRECTORY" == '/var/cache/taptime-wal-archive' ]] ||
    fail 'WAL_ARCHIVE_CACHE_DIRECTORY must match the archiver service path.'
  [[ "$WAL_REPLICATION_SLOT" =~ ^[a-z0-9_]+$ ]] ||
    fail 'WAL_REPLICATION_SLOT contains unsafe characters.'
  for value in \
    "$WAL_ARCHIVE_INTERVAL_SECONDS" \
    "$WAL_ARCHIVE_MISSED_CYCLES" \
    "$BASE_BACKUP_KEEP_HOURLY" \
    "$BASE_BACKUP_KEEP_DAILY" \
    "$BASE_BACKUP_KEEP_WEEKLY" \
    "$BASE_BACKUP_KEEP_MONTHLY" \
    "$RESTORE_RECOVERY_TIMEOUT_SECONDS" \
    "$RESTORE_RECOVERY_POLL_SECONDS"; do
    [[ "$value" =~ ^[1-9][0-9]*$ ]] ||
      fail 'Archive cadence and retention values must be positive integers.'
  done
)

wal_archive_mount_state() (
  set -euo pipefail
  local mount_record

  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  mount_record="$(docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql/wal-archive"}}{{.Type}}|{{.Source}}|{{.RW}}{{end}}{{end}}' \
    "$DATABASE_CONTAINER")"
  if [[ -z "$mount_record" ]]; then
    printf 'missing\n'
  elif [[ "$mount_record" == "bind|$WAL_SPOOL_DIRECTORY|true" ]]; then
    printf 'active\n'
  else
    fail "Database WAL mount is not the configured writable bind: $mount_record"
  fi
)

archive_contract_is_active() {
  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  [[ "$(docker exec --user postgres "$DATABASE_CONTAINER" psql \
    --tuples-only --no-align --set ON_ERROR_STOP=on --dbname="$DATABASE_NAME" \
    --command "SELECT pg_catalog.to_regprocedure(
      'taptime_server.record_lifecycle_event_archive_requirement_v1(uuid,uuid)'
    ) IS NOT NULL;")" == 't' ]]
}

begin_wal_archive_cutover() {
  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  ARCHIVE_CUTOVER_ACTIVE=1
  say '[Archiv] Halte das bisherige Backend an, bevor die neue Sicherungskette beginnt.'
  compose "$PREVIOUS_VERSION" stop backend-api
  docker exec --user postgres "$DATABASE_CONTAINER" \
    pg_receivewal --dbname="dbname=$DATABASE_NAME" --slot="$WAL_REPLICATION_SLOT" \
      --create-slot --if-not-exists --no-password
}

wait_for_database_health() {
  local container="$1"
  local deadline="$2"
  local health

  while (( $(date +%s) <= deadline )); do
    health="$(docker inspect --format \
      '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
      "$container")"
    [[ "$health" == 'healthy' ]] && return 0
    [[ "$health" == 'unhealthy' || "$health" == 'exited' || "$health" == 'dead' ]] && break
    sleep 1
  done
  fail 'Database did not become healthy inside the configured archive window.'
}

wait_for_wal_receiver() {
  local deadline="$1"
  local slot_active=''

  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  while (( $(date +%s) <= deadline )); do
    if systemctl is-active --quiet taptime-wal-receiver.service; then
      slot_active="$(docker exec --user postgres "$DATABASE_CONTAINER" psql \
        --tuples-only --no-align --dbname="$DATABASE_NAME" --command \
        "SELECT active FROM pg_catalog.pg_replication_slots
         WHERE slot_name = '$WAL_REPLICATION_SLOT' AND slot_type = 'physical';")"
      [[ "$slot_active" == 't' ]] && return 0
    fi
    sleep 1
  done
  fail 'WAL receiver did not activate its physical replication slot.'
}

activate_wal_receiver() {
  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  local deadline container

  install -d -m 0700 "$WAL_SPOOL_DIRECTORY"
  chown 999:999 "$WAL_SPOOL_DIRECTORY"
  compose "$PREVIOUS_VERSION" up --detach --no-deps --force-recreate database
  container="$(compose "$PREVIOUS_VERSION" ps --quiet database)"
  [[ -n "$container" ]] || fail 'Recreated database container is not running.'
  deadline=$(( $(date +%s) + WAL_ARCHIVE_INTERVAL_SECONDS * WAL_ARCHIVE_MISSED_CYCLES ))
  wait_for_database_health "$container" "$deadline"
  [[ "$(wal_archive_mount_state)" == 'active' ]] ||
    fail 'Recreated database does not expose the configured WAL bind mount.'

  systemctl enable --now taptime-wal-receiver.service
  wait_for_wal_receiver "$deadline"
}

ensure_wal_archive_runtime() {
  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  local deadline

  [[ "$(wal_archive_mount_state)" == 'active' ]] ||
    fail 'Database does not expose the configured WAL bind mount.'
  systemctl enable --now taptime-wal-receiver.service taptime-wal-archiver.service
  deadline=$(( $(date +%s) + WAL_ARCHIVE_INTERVAL_SECONDS * WAL_ARCHIVE_MISSED_CYCLES ))
  wait_for_wal_receiver "$deadline"
  systemctl is-active --quiet taptime-wal-archiver.service ||
    fail 'WAL archiver is not active.'
}

complete_wal_archive_cutover() {
  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  local barrier cluster_system_identifier barrier_lsn wal_file archived deadline

  ensure_wal_archive_runtime
  (( WAL_ARCHIVE_BOOTSTRAP == 1 )) || return 0

  # The restore just created the verification marker. Register it synchronously before
  # starting the barrier's normal archive window; do not charge first registration to it.
  prepare_offsite_wal_for_restore 0 || return

  barrier="$(docker exec --user postgres "$DATABASE_CONTAINER" psql \
    --tuples-only --no-align --dbname="$DATABASE_NAME" --command \
    "WITH switched AS (SELECT pg_catalog.pg_switch_wal() AS next_lsn)
     SELECT control.system_identifier::text || '|' ||
            (next_lsn - 1)::text || '|' ||
            pg_catalog.pg_walfile_name(next_lsn - 1)
     FROM switched CROSS JOIN pg_catalog.pg_control_system() AS control;")"
  IFS='|' read -r cluster_system_identifier barrier_lsn wal_file <<< "$barrier"
  [[ "$cluster_system_identifier" =~ ^-?[0-9]+$ \
    && "$barrier_lsn" =~ ^[0-9A-F]+/[0-9A-F]+$ \
    && "$wal_file" =~ ^[0-9A-F]{24}$ ]] ||
    fail 'PostgreSQL returned an invalid WAL barrier filename.'
  deadline=$(( $(date +%s) + WAL_ARCHIVE_INTERVAL_SECONDS * WAL_ARCHIVE_MISSED_CYCLES ))
  while (( $(date +%s) <= deadline )); do
    archived="$(docker exec --user postgres "$DATABASE_CONTAINER" psql \
      --tuples-only --no-align --dbname="$DATABASE_NAME" --command \
      "SELECT taptime_server.offline_wal_requirement_is_archived_v1(
         '$cluster_system_identifier'::bigint, '$barrier_lsn'::pg_lsn, '$wal_file'
       );")"
    if [[ "$archived" == 't' ]]; then
      say "[Archiv] Externe WAL-Barriere belegt: $wal_file"
      return 0
    fi
    sleep 1
  done
  fail "WAL barrier was not archived inside the configured archive window: $wal_file"
}

run_backup() {
  local status_file cursor completed

  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  status_file="${STATUS_FILE:?STATUS_FILE must be configured}"
  # Capture a journal boundary before starting. A stopped timer no longer pins the
  # completed service in systemd's memory, so its InvocationID may already be gone.
  cursor="$(journalctl --quiet --no-pager --unit=taptime-backup.service \
    --lines=1 --show-cursor --output=cat | sed -n 's/^-- cursor: //p')" || return
  [[ -n "$cursor" && "$cursor" != *$'\n'* ]] || {
    fail 'No backup journal boundary is available.'; return 1;
  }
  say '[2/7] Erzeuge eine frische Sicherung und warte auf ihren Erfolg.'
  run_fresh_oneshot taptime-backup.service "$status_file" || return
  completed="$(journalctl --quiet --no-pager --output=cat \
    --unit=taptime-backup.service "--after-cursor=$cursor" \
    --grep='^Physical base backup completed: ' | \
    sed -n 's/^Physical base backup completed: \(base-[0-9a-f]\{16\}-[0-9]\{8\}T[0-9]\{6\}Z\) (starts at WAL [0-9A-F]\{24\})$/\1/p')" || return
  [[ "$completed" =~ ^base-[0-9a-f]{16}-[0-9]{8}T[0-9]{6}Z$ ]] || {
    fail 'Fresh backup did not report exactly one completed physical base.'; return 1;
  }
  DEPLOY_BASE_ARCHIVE="$completed"
}

prepare_offsite_wal_for_restore() {
  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  local upload_only="${1:-0}"
  local deadline archive_status

  require_file "$WAL_ARCHIVER_COMMAND"
  [[ "$upload_only" == '0' || "$upload_only" == '1' ]] ||
    fail 'WAL upload-only mode must be 0 or 1.'
  systemctl stop taptime-wal-archiver.service
  deadline=$(( $(date +%s) + WAL_ARCHIVE_INTERVAL_SECONDS * WAL_ARCHIVE_MISSED_CYCLES ))
  while (( $(date +%s) <= deadline )); do
    set +e
    TAPTIME_WAL_ARCHIVE_RUN_ONCE=1 \
      TAPTIME_WAL_ARCHIVE_UPLOAD_ONLY="$upload_only" \
      "$WAL_ARCHIVER_COMMAND"
    archive_status=$?
    set -e
    if (( archive_status == 0 )); then
      if [[ "$upload_only" == '0' ]]; then
        systemctl enable --now taptime-wal-archiver.service
      fi
      say '[Archiv] Der Start-WAL der frischen Basis liegt geprüft extern vor.'
      return 0
    fi
    sleep "$WAL_ARCHIVE_INTERVAL_SECONDS"
  done
  if [[ "$upload_only" == '0' ]]; then
    systemctl enable --now taptime-wal-archiver.service || true
  fi
  fail 'Fresh physical base WAL was not archived inside the configured archive window.'
}

sync_migration_sources() (
  set -euo pipefail

  local image="$1"
  local holder=''
  local staged=''
  local previous=''
  local parent

  # shellcheck disable=SC1090
  source "$BACKUP_CONFIG"
  : "${MIGRATIONS_DIRECTORY:?MIGRATIONS_DIRECTORY must be configured}"
  [[ "$MIGRATIONS_DIRECTORY" == /opt/taptime/*/migrations ||
    "$MIGRATIONS_DIRECTORY" == \
      "$(operations_target opt/taptime/source/apps/backend-schema/migrations)" ]] ||
    fail "Unsafe migration directory: $MIGRATIONS_DIRECTORY"
  parent="$(dirname "$MIGRATIONS_DIRECTORY")"
  require_file "$MIGRATIONS_DIRECTORY/001_foundation.sql"
  if [[ -L "$MIGRATIONS_DIRECTORY" &&
    "$(readlink "$MIGRATIONS_DIRECTORY")" == \
      "$OPERATIONS_ROOT/current/opt/taptime/source/apps/backend-schema/migrations" ]]; then
    say '[3/7] Die versionierten Migrationsquellen sind bereits mit dem Betriebsstand installiert.'
    return 0
  fi

  # Invoked by the EXIT trap below.
  # shellcheck disable=SC2317,SC2329
  cleanup_sources() {
    [[ -z "$holder" ]] || docker rm --force "$holder" >/dev/null 2>&1 || true
    if [[ -n "$staged" && "$staged" == "$parent"/.deploy-migrations.* && -d "$staged" ]]; then
      rm -rf -- "$staged"
    fi
  }
  trap cleanup_sources EXIT

  holder="$(docker create "$image")"
  staged="$(mktemp -d "$parent/.deploy-migrations.XXXXXX")"
  docker cp "$holder:/app/migrations/." "$staged"
  require_file "$staged/001_foundation.sql"
  find "$staged" -maxdepth 1 -type f -name '[0-9][0-9][0-9]_*.sql' -print -quit | grep --quiet . ||
    fail 'Target image contains no schema migrations.'

  previous="$parent/.previous-migrations.$$"
  mv "$MIGRATIONS_DIRECTORY" "$previous"
  if ! mv "$staged" "$MIGRATIONS_DIRECTORY"; then
    mv "$previous" "$MIGRATIONS_DIRECTORY"
    fail 'Could not install migration sources from target image.'
  fi
  staged=''
  rm -rf -- "$previous"
  say '[3/7] Das Zielabbild liegt lokal; seine eingefrorenen Migrationsquellen sind installiert.'
)

migrate_production() {
  say '[4/7] Spiele ausstehende Migrationen in der Produktion transaktional ein.'
  compose "$MIGRATION_VERSION" run --rm migration
}

start_backend() {
  local version="$1"
  compose "$version" up --detach --no-deps backend-api
}

restart_caddy() {
  local version="$1"
  compose "$version" up --detach --no-deps --force-recreate caddy
}

read_running_caddy() {
  docker exec "$1" wget -q -T 5 -Y off -O - http://127.0.0.1:2019/config/ 2>/dev/null
}

validate_caddy_snapshot() (
  local snapshot="$1" container="$2" holder=''
  # Validate JSON with the running service's mounted files; never print its contents.
  trap '[[ -z "$holder" ]] || docker rm --force "$holder" >/dev/null 2>&1 || true' EXIT
  holder="$(docker create --volumes-from "$container:ro" caddy:2.10.2-alpine \
    caddy validate --config /tmp/taptime-running.json)" || return
  docker cp "$snapshot" "$holder:/tmp/taptime-running.json" >/dev/null 2>&1 || return
  docker start --attach "$holder" >/dev/null 2>&1
)

save_running_caddy() {
  local container temporary
  CADDY_RECOVERY_READY=0
  install -d -m 0700 "$CADDY_STATE_DIRECTORY" || return
  container="$(compose "$PREVIOUS_VERSION" ps --all --quiet caddy)" || return
  [[ -n "$container" && "$container" != *$'\n'* ]] || {
    fail 'Running Caddy could not be identified before switching.'; return 1;
  }
  temporary="$(mktemp "$CADDY_STATE_DIRECTORY/.running.XXXXXX")" || return
  if ! read_running_caddy "$container" > "$temporary" || [[ ! -s "$temporary" ]] ||
    ! chmod 0600 "$temporary" || ! validate_caddy_snapshot "$temporary" "$container" ||
    ! mv -f "$temporary" "$CADDY_STATE_DIRECTORY/running.json"; then
    rm -f -- "$temporary"
    fail 'Running Caddy configuration could not be saved and validated; nothing switched.'
    return 1
  fi
  CADDY_RECOVERY_READY=1
  say '[Vorbereitung] Laufende Caddy-Konfiguration privat gesichert und auf Ladbarkeit geprueft.'
}

caddy_snapshot_matches() (
  local container="$1" snapshot="$CADDY_STATE_DIRECTORY/running.json" actual
  actual="$(mktemp "$CADDY_STATE_DIRECTORY/.readback.XXXXXX")" || return
  trap 'rm -f -- "$actual"' EXIT
  # GET serializes the raw config deterministically, including its trailing newline.
  for _ in $(seq 1 10); do
    if read_running_caddy "$container" > "$actual" && cmp -s "$snapshot" "$actual"; then return 0; fi
    sleep 1
  done
  return 1
)

restore_caddy_configuration() {
  local container running snapshot="$CADDY_STATE_DIRECTORY/running.json" override
  (( CADDY_RECOVERY_READY == 1 )) && [[ -s "$snapshot" ]] || return 1
  container="$(compose "$DESIRED_VERSION" ps --all --quiet caddy)" || return
  [[ "$container" != *$'\n'* ]] || return 1
  running='false'
  if [[ -n "$container" ]]; then
    running="$(docker inspect --format '{{.State.Running}}' "$container")" || return
  fi
  if [[ "$running" == true ]]; then
    # Transport errors and restart loops are ambiguous: only GET/cmp proves recovery.
    docker exec -i "$container" caddy reload --config - --force < "$snapshot" >/dev/null 2>&1 || true
    caddy_snapshot_matches "$container" || true
    # Reload changes only the running config. Persist the same verified recovery input
    # in the service command too, so a later daemon/host restart cannot undo recovery.
  fi
  # Also recover a running/restarting container whose admin API cannot be reached.
  # The override persists until the next ordinary deploy. Never restart a dependency.
  override="$CADDY_STATE_DIRECTORY/recovery.compose.yml"
  (umask 077; cat > "$override" <<'EOF_CADDY_RECOVERY'
services:
  caddy:
    command: ["caddy", "run", "--config", "/etc/caddy/taptime-recovery.json"]
    volumes:
      - type: bind
        source: ${TAPTIME_CADDY_RECOVERY_FILE:?}
        target: /etc/caddy/taptime-recovery.json
        read_only: true
EOF_CADDY_RECOVERY
  ) || return
  TAPTIME_CADDY_RECOVERY_FILE="$snapshot" compose "$DESIRED_VERSION" --file "$override" \
    up --detach --no-deps --force-recreate caddy >/dev/null 2>&1 || return
  container="$(compose "$DESIRED_VERSION" ps --all --quiet caddy)" || return
  [[ -n "$container" && "$container" != *$'\n'* ]] || return 1
  caddy_snapshot_matches "$container"
}

edge_is_healthy() {
  local version="$1" available="$2" actual status path base_url
  curl --fail --silent --show-error --max-time 5 "$HEALTH_URL" >/dev/null || return
  actual="$(curl --fail --silent --show-error --max-time 5 \
    --header 'Cache-Control: no-cache' "$ADMIN_WEB_VERSION_URL")" || return
  [[ "$actual" == "$version" ]] || return 1
  if (( available == 1 )); then
    actual="$(curl --fail --silent --show-error --max-time 5 \
      --header 'Cache-Control: no-cache' "$OPERATOR_WEB_VERSION_URL")" || return
    [[ "$actual" == "$version" ]] || return 1
  else
    base_url="${OPERATOR_WEB_VERSION_URL%version.txt}"
    for path in '' version.txt v1/operator/session; do
      status="$(curl --silent --show-error --max-time 5 --output /dev/null \
        --write-out '%{http_code}' "${base_url}${path}")" || return
      [[ "$status" == 404 ]] || return 1
    done
  fi
}

wait_for_edge() {
  # All three hosts share this retry budget, including a delayed certificate (T-071).
  for _ in $(seq 1 30); do
    if edge_is_healthy "$1" "$2"; then return 0; fi
    sleep 2
  done
  fail 'Caddy edge did not serve the expected API/Admin/Operator responses.'
}

recover_caddy_edge() {
  # Independent of the backend/archive rollback fence. Do not start/stop the backend.
  CADDY_SWITCH_STARTED=0
  if activate_admin_web_release "$PREVIOUS_VERSION" &&
    select_operator_web_release "$PREVIOUS_VERSION" "$PREVIOUS_OPERATOR_WEB" &&
    select_landing_web_release "$PREVIOUS_VERSION" "$PREVIOUS_LANDING_WEB" &&
    restore_caddy_configuration && wait_for_edge "$PREVIOUS_VERSION" "$PREVIOUS_OPERATOR_WEB"; then
    say '[Ruecknahme] Alte Caddy-Kante wiederhergestellt und geprueft; Backend unveraendert.' >&2
  else
    fail 'Caddy-Ruecknahme fehlgeschlagen; manuelle Wiederherstellung erforderlich.'
    return 1
  fi
}

activate_caddy_edge() {
  local status=0
  (( CADDY_RECOVERY_READY == 1 )) || { fail 'No validated running Caddy snapshot.'; return 1; }
  CADDY_SWITCH_STARTED=1
  restart_caddy "$1" || status=$?
  if (( status == 0 )); then wait_for_edge "$1" "$DESIRED_OPERATOR_WEB" || status=$?; fi
  if (( status != 0 )); then
    recover_caddy_edge || true
    return "$status"
  fi
  CADDY_SWITCH_STARTED=0
  say '[6/7] Caddy-Kante fuer API, Verwaltung und Betreiber geprueft.'
}

# T-039: derive the Supabase project origin the backend actually trusts from SUPABASE_ISSUER.
# Reads that one key only; never prints or exports anything else from the environment file.
trusted_supabase_origin() {
  local issuer origin
  [[ -f "$BACKEND_ENV_FILE" ]] ||
    { fail "Backend environment file is missing; the trusted issuer is unknown."; return 1; }
  issuer="$(sed -n 's/^SUPABASE_ISSUER=//p' "$BACKEND_ENV_FILE" | tail -n 1 | tr -d '"'"'"' \r')"
  [[ -n "$issuer" ]] ||
    { fail 'SUPABASE_ISSUER is not set in the backend environment; the trusted issuer is unknown.'; return 1; }
  # The backend expects the exact Auth issuer; anything else (a bare origin, a different
  # path, trailing garbage) would pass a naive origin extraction yet break token verification.
  [[ "$issuer" =~ ^(https://[a-z0-9]+\.supabase\.co)/auth/v1/?$ ]] ||
    { fail 'SUPABASE_ISSUER must be exactly https://<project>.supabase.co/auth/v1.'; return 1; }
  origin="${BASH_REMATCH[1]}"
  printf '%s\n' "$origin"
}

# Runs as an `if` condition, where bash ignores errexit — so every refusal exits explicitly.
# Before T-039 the gate relied on errexit here and only rejected a bundle when its LAST check
# failed; a wrong-but-present origin with a valid key slipped through.
web_bundle_is_startable() (
  set -uo pipefail

  local version="$1" label="$2" version_url="$3"
  local base_url script_path
  local temporary_directory index_file bundle_file
  local trusted_origin bundle_origins

  refuse() { fail "$@"; exit 1; }

  base_url="${version_url%version.txt}"
  [[ "$base_url" != "$version_url" ]] ||
    refuse "$label version URL must end in version.txt."

  temporary_directory="$(mktemp -d)"
  trap 'rm -rf -- "$temporary_directory"' EXIT
  index_file="$temporary_directory/index.html"
  bundle_file="$temporary_directory/application.js"

  curl --fail --silent --show-error --max-time 5 \
    --header 'Cache-Control: no-cache' "$base_url" > "$index_file" ||
    refuse "$label index could not be fetched."
  [[ "$(grep -Eo '<script([[:space:]>])' "$index_file" | wc -l | tr -d ' ')" == 1 ]] ||
    refuse "$label index must load exactly one application bundle."
  script_path="$(sed -n 's/.*<script[^>]* src="\([^"]*\)"[^>]*>.*/\1/p' "$index_file")"
  [[ -n "$script_path" && "$script_path" != *$'\n'* ]] ||
    refuse "$label index must load exactly one application bundle."
  [[ "$script_path" =~ ^/releases/$version/assets/[A-Za-z0-9._-]+\.js$ ]] ||
    refuse "$label index does not load the application bundle for version $version."

  curl --fail --silent --show-error --max-time 5 \
    --header 'Cache-Control: no-cache' \
    "${base_url%/}$script_path" > "$bundle_file" ||
    refuse "$label bundle could not be fetched."
  LC_ALL=C grep --extended-regexp --quiet \
    'https://[a-z0-9]+[.]supabase[.]co([^A-Za-z0-9._~:/?#@!$&()*+,;=%-]|$)' \
    "$bundle_file" ||
    refuse "$label bundle has no valid configured Supabase origin."
  # T-039: any Supabase origin is not enough — it must be the one the backend trusts, and
  # nothing else. A bundle built against a second project passes tokens the backend rejects.
  trusted_origin="$(trusted_supabase_origin)" || exit 1
  bundle_origins="$(LC_ALL=C grep --extended-regexp --only-matching \
    'https://[a-z0-9]+[.]supabase[.]co' "$bundle_file" | sort -u)"
  [[ "$bundle_origins" == "$trusted_origin" ]] ||
    refuse "$label bundle is built for a Supabase origin the backend does not trust (bundle: $(tr '\n' ' ' <<< "$bundle_origins")| backend: $trusted_origin)."
  LC_ALL=C grep --extended-regexp --quiet \
    'sb_publishable_[A-Za-z0-9_-]{20,}([^A-Za-z0-9_-]|$)' "$bundle_file" ||
    refuse "$label bundle has no valid configured public application key."
)

admin_web_bundle_is_startable() { web_bundle_is_startable "$1" 'Admin Web' "$ADMIN_WEB_VERSION_URL"; }
operator_web_bundle_is_startable() { web_bundle_is_startable "$1" 'Operator Web' "$OPERATOR_WEB_VERSION_URL"; }

wait_for_health() {
  local version="$1"
  local operator_available="${2:-$DESIRED_OPERATOR_WEB}"
  local container health running_image admin_web_version

  say "[6/7] Prüfe Backend und ausgeliefertes Admin-Web für Version $version."
  container="$(compose "$version" ps --quiet backend-api)"
  [[ -n "$container" ]] || fail 'Backend container is not running.'
  running_image="$(docker inspect --format '{{.Config.Image}}' "$container")"
  [[ "$running_image" == "$(image_for_version "$version")" ]] ||
    fail "Running backend image $running_image does not match version $version."

  for _ in $(seq 1 30); do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container")"
    admin_web_version=''
    if [[ "$health" == 'healthy' ]] &&
      curl --fail --silent --show-error --max-time 5 "$HEALTH_URL" >/dev/null &&
      admin_web_version="$(curl --fail --silent --show-error --max-time 5 \
        --header 'Cache-Control: no-cache' "$ADMIN_WEB_VERSION_URL")" &&
      [[ "$admin_web_version" == "$version" ]]; then
      if admin_web_bundle_is_startable "$version" && operator_web_health "$version" "$operator_available"; then
        say "[6/7] Backend und startfähiges Admin-Web belegen gemeinsam Version $version."
        say "[6/7] Betreiber-Web: Version $version oder geprüfte Deaktivierung belegt."
        return 0
      fi
    fi
    [[ "$health" == 'unhealthy' || "$health" == 'exited' || "$health" == 'dead' ]] && break
    sleep 2
  done
  fail "Version $version did not become healthy."
}

write_current_version() {
  local directory temporary

  directory="$(dirname "$VERSION_STATE_FILE")"
  install -d -m 0755 "$directory"
  temporary="$(mktemp "$directory/current-version.XXXXXX")"
  printf '%s\n' "$1" > "$temporary"
  chmod 0644 "$temporary"
  mv "$temporary" "$VERSION_STATE_FILE"
}

mark_known_version() {
  local directory

  directory="$(dirname "$KNOWN_VERSIONS_FILE")"
  install -d -m 0755 "$directory"
  touch "$KNOWN_VERSIONS_FILE"
  chmod 0644 "$KNOWN_VERSIONS_FILE"
  if ! grep --fixed-strings --line-regexp --quiet "$1" "$KNOWN_VERSIONS_FILE"; then
    printf '%s\n' "$1" >> "$KNOWN_VERSIONS_FILE"
  fi
}

publish_protected_versions() {
  local current="$1"
  local previous="$2"
  local operations="$3"
  local directory temporary version first=1

  validate_version "$current"
  validate_version "$previous"
  validate_version "$operations"
  require_file "$KNOWN_VERSIONS_FILE"
  while IFS= read -r version; do
    [[ -n "$version" ]] || continue
    validate_version "$version"
  done < <(printf '%s\n%s\n' "$current" "$previous"; cat "$KNOWN_VERSIONS_FILE")

  directory="$(dirname "$PROTECTED_VERSIONS_FILE")"
  install -d -m 0755 "$directory"
  temporary="$(mktemp "$directory/ghcr-protected-versions.XXXXXX")"
  {
    printf '{"schema_version":1,"current_version":"%s","previous_version":"%s","operations_version":"%s","known_versions":[' \
      "$current" "$previous" "$operations"
    while IFS= read -r version; do
      [[ -n "$version" ]] || continue
      if (( first == 0 )); then
        printf ','
      fi
      printf '"%s"' "$version"
      first=0
    done < <({ printf '%s\n%s\n' "$current" "$previous"; cat "$KNOWN_VERSIONS_FILE"; } | sort --unique)
    printf ']}\n'
  } > "$temporary"
  chmod 0644 "$temporary"
  mv "$temporary" "$PROTECTED_VERSIONS_FILE"
}

acquire_deploy_lock() {
  local inherited_fd="${TAPTIME_DEPLOY_LOCK_FD:-}"
  local inherited_target

  if [[ -n "$inherited_fd" ]]; then
    [[ "$inherited_fd" =~ ^[0-9]+$ ]] || fail 'Inherited deploy lock descriptor is invalid.'
    inherited_target="$(readlink "/proc/$$/fd/$inherited_fd" 2>/dev/null || true)"
    [[ "$inherited_target" == "$DEPLOY_LOCK_FILE" ]] ||
      fail 'Inherited deploy lock does not reference the deployment lock.'
    flock -n "$inherited_fd" || fail 'Inherited deployment lock is not held.'
    return 0
  fi
  exec 9>"$DEPLOY_LOCK_FILE"
  flock -n 9 || fail 'Another deployment is already running.'
}

rollback_started_image() {
  local status="$1"

  if (( ARCHIVE_CUTOVER_ACTIVE == 1 || ARCHIVE_CONTRACT_ACTIVE == 1 )); then
    if (( ARCHIVE_CONTRACT_ACTIVE == 1 )); then
      say '[7/7] Archivvertrag ist aktiv; keine automatische Rücknahme auf das alte Backend.' >&2
    else
      say '[7/7] Archiv-Cutover begonnen; das alte Backend bleibt zur Verlustvermeidung gestoppt.' >&2
    fi
    say 'ERROR: Manual recovery with the current image is required before traffic resumes.' >&2
  elif (( NEW_IMAGE_STARTED == 1 )); then
    say "[7/7] Neuer Stand fehlgeschlagen; setze Backend und Admin-Web auf $PREVIOUS_VERSION zurück." >&2
    if activate_admin_web_release "$PREVIOUS_VERSION" &&
      select_operator_web_release "$PREVIOUS_VERSION" "$PREVIOUS_OPERATOR_WEB" &&
      select_landing_web_release "$PREVIOUS_VERSION" "$PREVIOUS_LANDING_WEB" &&
      start_backend "$PREVIOUS_VERSION" && restart_caddy "$PREVIOUS_VERSION" &&
      wait_for_health "$PREVIOUS_VERSION" "$PREVIOUS_OPERATOR_WEB"; then
      say "[7/7] Rücknahme erfolgreich; Backend und Admin-Web belegen Version $PREVIOUS_VERSION." >&2
    else
      say "ERROR: Automatic image rollback to $PREVIOUS_VERSION also failed." >&2
    fi
  fi
  exit "$status"
}

finish_deploy() {
  local status="$1"
  trap - EXIT INT TERM HUP
  if (( CADDY_SWITCH_STARTED == 1 )); then
    recover_caddy_edge || true
  fi
  if (( BACKUP_TIMER_HELD == 1 )); then
    if ! systemctl start taptime-backup.timer; then
      fail 'Could not restore backup timer; operator intervention required.'
      status=1
    fi
    BACKUP_TIMER_HELD=0
  fi
  if (( status != 0 && DEPLOY_SUCCEEDED == 0 && LANDING_ONLY_FAILURE == 0 && (NEW_IMAGE_STARTED == 1 || ARCHIVE_CUTOVER_ACTIVE == 1) )); then
    rollback_started_image "$status"
  fi
  if (( status == 0 && DEPLOY_SUCCEEDED == 1 )); then
    say "[7/7] Auslieferung abgeschlossen: $PREVIOUS_VERSION -> $DESIRED_VERSION."
  fi
  exit "$status"
}

# Missing historical capability metadata denotes source before operator-web existed.
# A failed inspect/pull is never interpreted as absence; known new images must be complete.
operator_web_capability() {
  local label
  label="$(docker image inspect --format '{{index .Config.Labels "io.taptime.operator-web"}}' "$1")" || return
  case "$label" in
    true) printf '1\n';;
    false|''|'<no value>') printf '0\n';;
    *) fail 'Invalid operator-web capability in backend image.'; return 1;;
  esac
}

preflight_operator_dns() {
  local host addresses
  [[ "$OPERATOR_WEB_VERSION_URL" =~ ^https://([a-zA-Z0-9.-]+)/version[.]txt$ ]] ||
    { fail 'Invalid Operator Web version URL.'; return 1; }
  host="${BASH_REMATCH[1]}"
  addresses="$(getent ahosts "$host" 2>/dev/null)" ||
    { fail "DNS-Eintrag für $host fehlt"; return 1; }
  [[ -n "$addresses" ]] || { fail "DNS-Eintrag für $host fehlt"; return 1; }
  say "[Vorprüfung] DNS-Eintrag für $host vorhanden."
}

prepare_operator_web_versions() {
  local image
  if (( PREVIOUS_OPERATOR_WEB == 0 && DESIRED_OPERATOR_WEB == 1 )); then
    say '[Vorbereitung] Betreiber-Web wird erstmals installiert; keine Rücknahmeversion'
  fi
  if (( DESIRED_OPERATOR_WEB == 1 )); then
    image="$IMAGE_REPOSITORY:operator-web-$DESIRED_VERSION"
    pull_image "$image" || return
    prepare_operator_web_release "$image" "$DESIRED_VERSION" || return
  fi
  if (( PREVIOUS_OPERATOR_WEB == 1 )); then
    image="$IMAGE_REPOSITORY:operator-web-$PREVIOUS_VERSION"
    pull_image "$image" || return
    prepare_operator_web_release "$image" "$PREVIOUS_VERSION" || return
  fi
}

validate_web_release_bundle() {
  local directory="$1" version="$2" script_path count
  [[ -s "$directory/index.html" ]] || { fail 'Operator Web index is missing.'; return 1; }
  count="$(grep -Eo '<script([[:space:]>])' "$directory/index.html" | wc -l | tr -d ' ')" || return
  [[ "$count" == 1 ]] || { fail 'Operator Web requires exactly one application bundle.'; return 1; }
  script_path="$(sed -n 's/.*<script[^>]* src="\([^" ]*\)"[^>]*>.*/\1/p' "$directory/index.html")"
  [[ "$script_path" =~ ^/releases/$version/assets/[A-Za-z0-9._-]+[.]js$ ]] ||
    { fail 'Operator Web bundle path does not match the release.'; return 1; }
  [[ -s "$directory/${script_path#/releases/"$version"/}" ]] ||
    { fail 'Operator Web bundle is missing.'; return 1; }
}

deactivate_operator_web() {
  [[ ! -e "$OPERATOR_WEB_ROOT/current" || -L "$OPERATOR_WEB_ROOT/current" ]] ||
    { fail 'Operator Web current is not a managed symlink.'; return 1; }
  rm -f -- "$OPERATOR_WEB_ROOT/current" || return
  [[ ! -e "$OPERATOR_WEB_ROOT/current" && ! -L "$OPERATOR_WEB_ROOT/current" ]] ||
    { fail 'Operator Web could not be deactivated.'; return 1; }
  say '[5/7] Betreiber-Web deaktiviert; keine Oberfläche für diese Version.'
}

select_operator_web_release() {
  if (( $2 == 1 )); then activate_operator_web_release "$1"; else deactivate_operator_web; fi
}

operator_web_health() {
  local version="$1" available="$2" actual status path base_url
  if (( available == 1 )); then
    actual="$(curl --fail --silent --show-error --max-time 5 --header 'Cache-Control: no-cache' "$OPERATOR_WEB_VERSION_URL")" || return
    [[ "$actual" == "$version" ]] || { fail 'Operator Web serves the wrong version.'; return 1; }
    operator_web_bundle_is_startable "$version" || return
  else
    [[ ! -e "$OPERATOR_WEB_ROOT/current" && ! -L "$OPERATOR_WEB_ROOT/current" ]] ||
      { fail 'Operator Web is unexpectedly active.'; return 1; }
    base_url="${OPERATOR_WEB_VERSION_URL%version.txt}"
    for path in '' version.txt v1/operator/session; do
      status="$(curl --silent --show-error --max-time 5 --output /dev/null --write-out '%{http_code}' "${base_url}${path}")" || return
      [[ "$status" == 404 ]] || { fail 'Operator Web must return 404 when deactivated.'; return 1; }
    done
  fi
}

prepare_landing_web_release() (
  set -euo pipefail

  local image="$1"
  local version="$2"
  local releases_directory release_directory staged holder=''

  releases_directory="$LANDING_WEB_ROOT/releases"
  release_directory="$releases_directory/$version"
  install -d -m 0755 "$LANDING_WEB_ROOT" "$releases_directory" || return

  if [[ -d "$release_directory" ]]; then
    [[ "$(read_web_release_version "$release_directory")" == "$version" ]] ||
      { fail "Prepared Landing Web release $release_directory has the wrong version."; return 1; }
    validate_landing_release_bundle "$release_directory" "$version" || return
    say "[Vorbereitung] Startseite $version liegt bereits unveränderlich bereit."
    return 0
  fi

  staged="$(mktemp -d "$releases_directory/.deploy-landing-web.XXXXXX")" || return
  # Invoked by the EXIT trap below.
  # shellcheck disable=SC2317,SC2329
  cleanup_landing_web_stage() {
    [[ -z "$holder" ]] || docker rm --force "$holder" >/dev/null 2>&1 || true
    if [[ "$staged" == "$releases_directory"/.deploy-landing-web.* && -d "$staged" ]]; then
      rm -rf -- "$staged"
    fi
  }
  trap cleanup_landing_web_stage EXIT

  holder="$(docker create "$image")" || return
  docker cp "$holder:/landing-web/." "$staged" || return
  require_file "$staged/index.html" || return
  [[ "$(read_web_release_version "$staged")" == "$version" ]] ||
    { fail "Landing Web image $image does not contain version $version."; return 1; }
  validate_landing_release_bundle "$staged" "$version" || return
  chmod -R u=rwX,go=rX "$staged" || return
  chmod -R a-w "$staged" || return
  mv "$staged" "$release_directory" || return
  staged=''
  say "[Vorbereitung] Startseite $version liegt vollständig und unveränderlich bereit."
)

activate_landing_web_release() {
  local version="$1"
  local release_directory switch_directory moved=0

  release_directory="$LANDING_WEB_ROOT/releases/$version"
  [[ "$(read_web_release_version "$release_directory")" == "$version" ]] ||
    { fail "Landing Web release $version is not prepared correctly."; return 1; }

  validate_landing_release_bundle "$release_directory" "$version" || return
  switch_directory="$(mktemp -d "$LANDING_WEB_ROOT/.deploy-switch.XXXXXX")" || return
  ln -s "releases/$version" "$switch_directory/current" || return
  if mv --help 2>&1 | grep --quiet -- '--no-target-directory'; then
    if mv -Tf "$switch_directory/current" "$LANDING_WEB_ROOT/current"; then moved=1; fi
  else
    if mv -fh "$switch_directory/current" "$LANDING_WEB_ROOT/current"; then moved=1; fi
  fi
  if (( moved == 0 )) || [[ "$(readlink "$LANDING_WEB_ROOT/current" 2>/dev/null || true)" != "releases/$version" ]]; then
    rm -rf -- "$switch_directory"
    fail "Could not activate Landing Web release $version."
    return 1
  fi
  rmdir "$switch_directory" || return
  say "[5/7] Startseite $version wurde in einem Zug aktiviert."
}

landing_web_capability() {
  local label
  label="$(docker image inspect --format '{{index .Config.Labels "io.taptime.landing-web"}}' "$1")" || return
  case "$label" in
    true) printf '1\n';;
    false|''|'<no value>') printf '0\n';;
    *) fail 'Invalid landing-web capability in backend image.'; return 1;;
  esac
}

prepare_landing_web_versions() {
  local image
  if (( PREVIOUS_LANDING_WEB == 0 && DESIRED_LANDING_WEB == 1 )); then
    say '[Vorbereitung] Startseite wird erstmals installiert; keine Rücknahmeversion'
  fi
  if (( DESIRED_LANDING_WEB == 1 )); then
    image="$IMAGE_REPOSITORY:landing-web-$DESIRED_VERSION"
    pull_image "$image" || return
    prepare_landing_web_release "$image" "$DESIRED_VERSION" || return
  fi
  if (( PREVIOUS_LANDING_WEB == 1 )); then
    image="$IMAGE_REPOSITORY:landing-web-$PREVIOUS_VERSION"
    pull_image "$image" || return
    prepare_landing_web_release "$image" "$PREVIOUS_VERSION" || return
  fi
}

deactivate_landing_web() {
  [[ ! -e "$LANDING_WEB_ROOT/current" || -L "$LANDING_WEB_ROOT/current" ]] ||
    { fail 'Landing Web current is not a managed symlink.'; return 1; }
  rm -f -- "$LANDING_WEB_ROOT/current" || return
  [[ ! -e "$LANDING_WEB_ROOT/current" && ! -L "$LANDING_WEB_ROOT/current" ]] ||
    { fail 'Landing Web could not be deactivated.'; return 1; }
  say '[5/7] Startseite deaktiviert; keine Oberfläche für diese Version.'
}

select_landing_web_release() {
  if (( $2 == 1 )); then activate_landing_web_release "$1"; else deactivate_landing_web; fi
}

validate_landing_release_bundle() {
  local directory="$1" version="$2" file
  validate_web_release_bundle "$directory" "$version" || return
  for file in tag.html robots.txt tag-assets/tag.css tag-assets/fonts.css; do
    [[ -s "$directory/$file" ]] || { fail "Landing Web file missing: $file"; return 1; }
  done
}

initialize_landing_auth() (
  set +x
  umask 077
  local temporary password
  install -d -m 0755 "$LANDING_WEB_ROOT" || return
  [[ ! -L "$LANDING_AUTH_DIRECTORY" ]] || return 1
  install -d -m 0700 "$LANDING_AUTH_DIRECTORY" || return
  if [[ -e "$LANDING_AUTH_DIRECTORY/password.hash" ]]; then
    [[ -f "$LANDING_AUTH_DIRECTORY/password.hash" && ! -L "$LANDING_AUTH_DIRECTORY/password.hash" \
      && "$(file_mode "$LANDING_AUTH_DIRECTORY/password.hash")" == 600 ]] || return 1
    return 0
  fi
  temporary="$(mktemp "$LANDING_AUTH_DIRECTORY/.locked.XXXXXX")" || return
  trap 'rm -f -- "$temporary"' EXIT
  password="$(od -An -v -N32 -tx1 /dev/urandom | tr -d ' \n')" || return
  [[ "$password" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$password" | docker run --rm -i caddy:2.10.2-alpine caddy hash-password > "$temporary" 2>/dev/null || return
  unset password
  [[ -s "$temporary" ]] || return 1
  chmod 600 "$temporary" || return
  mv -f -- "$temporary" "$LANDING_AUTH_DIRECTORY/password.hash"
)

landing_web_health() {
  local version="$1" available="$2" status path actual
  if (( available == 0 )); then
    [[ ! -e "$LANDING_WEB_ROOT/current" && ! -L "$LANDING_WEB_ROOT/current" ]]
    return
  fi
  actual="$(curl --fail --silent --max-time 5 --header 'Cache-Control: no-cache' "$LANDING_WEB_ORIGIN/version.txt")" || return
  [[ "$actual" == "$version" ]] || return 1
  for path in / /tag /robots.txt; do
    status="$(curl --silent --max-time 5 --output /dev/null --write-out '%{http_code}' "$LANDING_WEB_ORIGIN$path")" || return
    if [[ "$path" == / ]]; then [[ "$status" == 401 ]] || return 1;
    else [[ "$status" == 200 ]] || return 1; fi
  done
}

verify_landing_or_disable() {
  local attempt
  for (( attempt=0; attempt<30; attempt++ )); do
    if landing_web_health "$DESIRED_VERSION" "$DESIRED_LANDING_WEB"; then return 0; fi
    sleep 2
  done
  # Separate failure domain: keep the already verified api/admin/operator edge and backend.
  LANDING_ONLY_FAILURE=1
  deactivate_landing_web || { fail 'Startseite konnte nicht deaktiviert werden.'; return 1; }
  fail 'Startseiten-Prüfung fehlgeschlagen; nur die Startseite wurde deaktiviert.'
}

main() {
  local step_status admin_web_version_to_activate wal_mount_state

  if (( $# != 1 )); then
    printf 'Usage: %s <seven-character-commit-hash>\n' "${0##*/}" >&2
    return 64
  fi

  DESIRED_VERSION="$1"
  validate_version "$DESIRED_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  require_root
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  preflight_operator_dns
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  require_file "$BACKUP_CONFIG"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  require_file "$VERSION_STATE_FILE"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  require_file "$OPERATIONS_VERSION_STATE_FILE"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi

  PREVIOUS_VERSION="$(tr -d '[:space:]' < "$VERSION_STATE_FILE")"
  validate_version "$PREVIOUS_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  OPERATIONS_VERSION="$(tr -d '[:space:]' < "$OPERATIONS_VERSION_STATE_FILE")"
  validate_version "$OPERATIONS_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi

  validate_wal_archive_configuration
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  if archive_contract_is_active; then
    ARCHIVE_CONTRACT_ACTIVE=1
  else
    # A historical restore can already expose the WAL bind mount while predating the
    # versioned delayed-acknowledgement contract. Keep the old backend stopped and use
    # upload-only archiving until the migration installs that contract.
    WAL_ARCHIVE_BOOTSTRAP=1
  fi
  wal_mount_state="$(wal_archive_mount_state)"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  if [[ "$wal_mount_state" == 'missing' ]]; then
    WAL_ARCHIVE_BOOTSTRAP=1
  fi

  acquire_deploy_lock
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi

  hold_backup_timer
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  preflight_deploy
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi

  local desired_image previous_image desired_admin_web_image previous_admin_web_image desired_operations_image
  local migration_image rehearsal_image
  desired_image="$(image_for_version "$DESIRED_VERSION")"
  previous_image="$(image_for_version "$PREVIOUS_VERSION")"
  desired_admin_web_image="$(admin_web_image_for_version "$DESIRED_VERSION")"
  previous_admin_web_image="$(admin_web_image_for_version "$PREVIOUS_VERSION")"

  pull_image "$desired_image"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  pull_image "$previous_image"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  pull_image "$desired_admin_web_image"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  pull_image "$previous_admin_web_image"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  DESIRED_LANDING_WEB="$(landing_web_capability "$desired_image")" || return
  OPERATIONS_VERSION="$(select_operations_version \
    "$DESIRED_VERSION" "$PREVIOUS_VERSION" "$OPERATIONS_VERSION" "$DESIRED_LANDING_WEB")" || return
  desired_operations_image="$(operations_image_for_version "$OPERATIONS_VERSION")"
  pull_image "$desired_operations_image"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  image_supports_archive_ack_contract "$desired_image"
  step_status=$?
  if (( step_status != 0 )); then
    fail "Target image $desired_image cannot honor delayed archive acknowledgement."
    return 1
  fi
  prepare_admin_web_release "$desired_admin_web_image" "$DESIRED_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  prepare_admin_web_release "$previous_admin_web_image" "$PREVIOUS_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  DESIRED_OPERATOR_WEB="$(operator_web_capability "$desired_image")" || return
  PREVIOUS_OPERATOR_WEB="$(operator_web_capability "$previous_image")" || return
  prepare_operator_web_versions
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  PREVIOUS_LANDING_WEB="$(landing_web_capability "$previous_image")" || return
  prepare_landing_web_versions || return
  initialize_landing_auth || return
  save_running_caddy
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  deploy_operations_release "$desired_operations_image" "$OPERATIONS_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  require_file "$COMPOSE_FILE"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  MIGRATION_VERSION="$(select_migration_version "$desired_image" "$previous_image")"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  migration_image="$(image_for_version "$MIGRATION_VERSION")"
  rehearsal_image="${TAPTIME_DEPLOY_TEST_REHEARSAL_IMAGE:-$migration_image}"
  if [[ "$rehearsal_image" != "$migration_image" && "${TAPTIME_DEPLOY_ALLOW_TEST_HOOKS:-0}" != '1' ]]; then
    fail 'A rehearsal image override requires TAPTIME_DEPLOY_ALLOW_TEST_HOOKS=1.'
    return 1
  fi
  if [[ "$rehearsal_image" != "$desired_image" && "$rehearsal_image" != "$previous_image" ]]; then
    verify_local_rehearsal_image "$rehearsal_image" "$MIGRATION_VERSION"
    step_status=$?
    if (( step_status != 0 )); then return "$step_status"; fi
  fi

  if (( WAL_ARCHIVE_BOOTSTRAP == 1 )); then
    begin_wal_archive_cutover
    step_status=$?
    if (( step_status != 0 )); then return "$step_status"; fi
    activate_wal_receiver
  else
    ensure_wal_archive_runtime
  fi
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  sync_migration_sources "$migration_image"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  run_backup
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  prepare_offsite_wal_for_restore "$WAL_ARCHIVE_BOOTSTRAP"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  run_restore_verification "$rehearsal_image" 1 "$DEPLOY_BASE_ARCHIVE"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  migrate_production
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  ARCHIVE_CONTRACT_ACTIVE=1
  run_backup
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  prepare_offsite_wal_for_restore 0
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  run_restore_verification "$rehearsal_image" 0 "$DEPLOY_BASE_ARCHIVE"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  complete_wal_archive_cutover
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  mark_known_version "$PREVIOUS_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi

  if [[ "${TAPTIME_DEPLOY_TEST_ABORT_AFTER_MIGRATION:-0}" == '1' ]]; then
    [[ "${TAPTIME_DEPLOY_ALLOW_TEST_HOOKS:-0}" == '1' ]] ||
      { fail 'The migration/start abort hook requires TAPTIME_DEPLOY_ALLOW_TEST_HOOKS=1.'; return 1; }
    say '[Test] Erzwinge harten Abbruch zwischen Migration und Anwendungsstart.'
    kill -KILL "$$"
  fi

  admin_web_version_to_activate="$DESIRED_VERSION"
  if [[ "${TAPTIME_DEPLOY_TEST_WRONG_ADMIN_WEB_VERSION:-0}" == '1' ]]; then
    [[ "${TAPTIME_DEPLOY_ALLOW_TEST_HOOKS:-0}" == '1' ]] ||
      { fail 'The wrong Admin Web version hook requires TAPTIME_DEPLOY_ALLOW_TEST_HOOKS=1.'; return 1; }
    admin_web_version_to_activate="$PREVIOUS_VERSION"
    say "[Test] Lege absichtlich die falsche Oberflächenversion $PREVIOUS_VERSION ab."
  fi

  say "[5/7] Aktiviere Backend und Admin-Web für Version $DESIRED_VERSION."
  NEW_IMAGE_STARTED=1
  activate_admin_web_release "$admin_web_version_to_activate"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  select_operator_web_release "$DESIRED_VERSION" "$DESIRED_OPERATOR_WEB"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  select_landing_web_release "$DESIRED_VERSION" "$DESIRED_LANDING_WEB" || return
  start_backend "$DESIRED_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  activate_caddy_edge "$DESIRED_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  wait_for_health "$DESIRED_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  verify_landing_or_disable || return
  mark_known_version "$DESIRED_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  publish_protected_versions "$DESIRED_VERSION" "$PREVIOUS_VERSION" "$OPERATIONS_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  write_current_version "$DESIRED_VERSION"
  step_status=$?
  if (( step_status != 0 )); then return "$step_status"; fi
  NEW_IMAGE_STARTED=0
  ARCHIVE_CUTOVER_ACTIVE=0
  DEPLOY_SUCCEEDED=1
}

if [[ "${0##*/}" == 'docker' ]]; then
  docker_hook "$@"
elif [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
