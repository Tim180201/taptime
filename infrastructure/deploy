operations_static_file_paths() {
  operations_paths | grep --fixed-strings --invert-match \
    'opt/taptime/source/apps/backend-schema/migrations'
}

is_operations_directory_path() {
  [[ "$1" == 'opt/taptime/source/apps/backend-schema/migrations' ]]
}

operations_target() {
  local relative="$1"
  if [[ -n "$OPERATIONS_TARGET_ROOT" ]]; then
    printf '%s/%s\n' "${OPERATIONS_TARGET_ROOT%/}" "$relative"
  else
    printf '/%s\n' "$relative"
  fi
}

read_operations_release_version() {
  local release="$1"
  local actual

  require_file "$release/version.txt"
  actual="$(tr -d '\r\n' < "$release/version.txt")"
  validate_version "$actual"
  printf '%s\n' "$actual"
}

validate_caddy_candidate() (
  set -euo pipefail
  local candidate="$1" version="$2" postgres_volume
  require_file "$candidate" || return
  postgres_volume="$(selected_postgres_volume)" || return
  # Derive every mount from the candidate service itself, including its relative Caddyfile.
  # No service ports and no dependencies are started by this disposable validation.
  TAPTIME_VERSION="$version" TAPTIME_POSTGRES_VOLUME="$postgres_volume" \
    docker compose --file "$candidate" run --rm --no-deps --entrypoint caddy \
      caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || {
        fail 'Caddy candidate with service mounts could not be validated.'; return 1;
      }
)

validate_compose_candidate() {
  local candidate="$1"
  local version="$2"

  TAPTIME_VERSION="$version" docker compose --file "$candidate" config --quiet
}

validate_systemd_candidates() (
  set -euo pipefail

  local release="$1"
  local validation_directory

  grep --fixed-strings --line-regexp --quiet \
    'ExecStart=/usr/local/sbin/taptime-backup' \
    "$release/etc/systemd/system/taptime-backup.service"
  grep --fixed-strings --line-regexp --quiet \
    'ExecStart=/usr/local/sbin/taptime-restore-verify' \
    "$release/etc/systemd/system/taptime-restore-verify.service"
  grep --fixed-strings --line-regexp --quiet \
    'ExecStart=/usr/local/sbin/taptime-wal-receiver' \
    "$release/etc/systemd/system/taptime-wal-receiver.service"
  grep --fixed-strings --line-regexp --quiet \
    'ExecStart=/usr/local/sbin/taptime-wal-archiver' \
    "$release/etc/systemd/system/taptime-wal-archiver.service"
  grep --fixed-strings --line-regexp --quiet \
    'ExecStart=/usr/local/sbin/taptime-immediate-monitor' \
    "$release/etc/systemd/system/taptime-immediate-monitor.service"
  grep --fixed-strings --line-regexp --quiet \
    'ExecStart=/usr/local/sbin/taptime-daily-monitor' \
    "$release/etc/systemd/system/taptime-daily-monitor.service"

  validation_directory="$(mktemp -d)"
  # Invoked by the EXIT trap below.
  # shellcheck disable=SC2317,SC2329
  cleanup_systemd_validation() {
    rm -rf -- "$validation_directory"
  }
  trap cleanup_systemd_validation EXIT
  cp "$release"/etc/systemd/system/*.service "$validation_directory/"
  cp "$release"/etc/systemd/system/*.timer "$validation_directory/"
  sed -i 's#^ExecStart=/usr/local/sbin/.*#ExecStart=/bin/true#' \
    "$validation_directory"/*.service

  systemd-analyze verify \
    "$validation_directory"/*.service \
    "$validation_directory"/*.timer
)

validate_operations_scripts() {
  local release="$1"
  local script

  for script in \
    taptime-landing-password \
    taptime-operator-grant \
    taptime-operator-db-login \
    taptime-backup \
    taptime-restore-verify \
    taptime-restore-activate \
    taptime-wal-receiver \
    taptime-wal-archiver \
    taptime-immediate-monitor \
    taptime-daily-monitor; do
    bash -n "$release/usr/local/sbin/$script" || return
  done
}

validate_operations_release() {
  local release="$1"
  local version="$2"
  local expected actual relative mode migration_directory migration_file

  [[ "$(read_operations_release_version "$release")" == "$version" ]] ||
    fail "Operations release does not contain version $version."
  if find "$release" -mindepth 1 -type l -print -quit | grep --quiet .; then
    fail 'Operations release contains a symbolic link.'
    return 1
  fi
  expected="$(operations_static_file_paths; printf 'version.txt\n')"
  actual="$(cd "$release" && find . -type f \
    ! -path './opt/taptime/source/apps/backend-schema/migrations/*' \
    -print | sed 's#^\./##' | sort)"
  [[ "$actual" == "$(printf '%s\n' "$expected" | sort)" ]] || {
    fail 'Operations release file inventory is incomplete or contains an unexpected file.'
    return 1
  }
  migration_directory="$release/opt/taptime/source/apps/backend-schema/migrations"
  require_file "$migration_directory/001_foundation.sql"
  if find "$migration_directory" -mindepth 1 ! -type f -print -quit | grep --quiet .; then
    fail 'Operations release migrations contain an unexpected entry.'
    return 1
  fi
  while IFS= read -r migration_file; do
    [[ "${migration_file##*/}" =~ ^[0-9]{3}_[a-z0-9_]+\.sql$ ]] || {
      fail "Operations release contains an invalid migration filename: ${migration_file##*/}"
      return 1
    }
  done < <(find "$migration_directory" -mindepth 1 -maxdepth 1 -type f -print | sort)
  [[ "$(tr -d '\r\n' < "$release/var/lib/taptime-deploy/operations-version")" == "$version" ]] || {
    fail 'Operations release state file does not match its version.'
    return 1
  }

  while IFS=' ' read -r mode relative; do
    [[ "$(file_mode "$release/$relative")" == "$mode" ]] || {
      fail "Operations release has the wrong mode for $relative."
      return 1
    }
  done <<'EOF_OPERATIONS_MODES'
700 usr/local/sbin/taptime-landing-password
700 usr/local/sbin/taptime-operator-grant
700 usr/local/sbin/taptime-operator-db-login
700 usr/local/sbin/taptime-backup
700 usr/local/sbin/taptime-restore-verify
700 usr/local/sbin/taptime-restore-activate
700 usr/local/sbin/taptime-wal-receiver
700 usr/local/sbin/taptime-wal-archiver
755 usr/local/sbin/taptime-immediate-monitor
755 usr/local/sbin/taptime-daily-monitor
EOF_OPERATIONS_MODES

  validate_operations_scripts "$release"
  validate_systemd_candidates "$release"
  validate_compose_candidate \
    "$release/opt/taptime/source/infrastructure/docker-compose.server.yml" "$version"
  validate_caddy_candidate "$release/opt/taptime/source/infrastructure/docker-compose.server.yml" "$version"
}

prepare_operations_release() (
  set -euo pipefail

  local image="$1"
  local version="$2"
  local releases_directory release staged holder=''

  releases_directory="$OPERATIONS_ROOT/releases"
  release="$releases_directory/$version"
  install -d -m 0755 "$OPERATIONS_ROOT" "$releases_directory"
  if [[ -d "$release" ]]; then
    validate_operations_release "$release" "$version"
    say "[Vorbereitung] Betriebsdateien $version liegen bereits unveränderlich bereit."
    return 0
  fi

  staged="$(mktemp -d "$releases_directory/.deploy-operations.XXXXXX")"
  # Invoked by the EXIT trap below.
  # shellcheck disable=SC2317,SC2329
  cleanup_operations_stage() {
    [[ -z "$holder" ]] || docker rm --force "$holder" >/dev/null 2>&1 || true
    if [[ "$staged" == "$releases_directory"/.deploy-operations.* && -d "$staged" ]]; then
      rm -rf -- "$staged"
    fi
  }
  trap cleanup_operations_stage EXIT

  holder="$(docker create "$image")"
  docker cp "$holder:/operations/." "$staged"
  validate_operations_release "$staged" "$version"
  mv "$staged" "$release"
  staged=''
  say "[Vorbereitung] Betriebsdateien $version sind vollständig validiert."
)

operations_targets_are_linked() {
  local relative target expected

  while IFS= read -r relative; do
    target="$(operations_target "$relative")"
    expected="$OPERATIONS_ROOT/current/$relative"
    [[ -L "$target" && "$(readlink "$target")" == "$expected" ]] || return 1
  done < <(operations_paths)
}

operations_target_matches_release() {
  local release="$1"
  local relative="$2"
  local target

  target="$(operations_target "$relative")"
  if is_operations_directory_path "$relative"; then
    diff --recursive --brief "$release/$relative" "$target" >/dev/null
  else
    cmp --silent "$release/$relative" "$target"
  fi
}

reload_operations_runtime() {
  local units_changed="$1"
  local journald_changed="$2"
  local unit

  if (( units_changed == 1 )); then
    systemctl daemon-reload
    for unit in \
      taptime-backup.timer \
      taptime-restore-verify.timer \
      taptime-immediate-monitor.timer \
      taptime-daily-monitor.timer; do
      if systemctl is-active --quiet "$unit"; then
        systemctl restart "$unit"
      fi
    done
  fi
  # The service path is stable while the linked script changes with every operations release.
  for unit in taptime-wal-receiver.service taptime-wal-archiver.service; do
    if systemctl is-active --quiet "$unit"; then
      systemctl restart "$unit"
    fi
  done
  if (( journald_changed == 1 )); then
    systemctl restart systemd-journald.service
  fi
}

install_operations_release() (
  set -euo pipefail

  local version="$1"
  local release="$OPERATIONS_ROOT/releases/$version"
  local previous_current='' current_existed=0 current_switched=0 committed=0
  local backup_directory switch_directory relative target candidate temporary
  local units_changed=0 journald_changed=0 index=0
  local -a targets=() backups=() existed=()

  validate_operations_release "$release" "$version"
  if [[ "$(readlink "$OPERATIONS_ROOT/current" 2>/dev/null || true)" == "releases/$version" ]] &&
    operations_targets_are_linked; then
    say "[Vorbereitung] Installierte Betriebsdateien belegen bereits Version $version."
    return 0
  fi

  while IFS= read -r relative; do
    target="$(operations_target "$relative")"
    candidate="$release/$relative"
    if [[ "$relative" == etc/systemd/system/* ]] && ! cmp --silent "$candidate" "$target" 2>/dev/null; then
      units_changed=1
    fi
    if [[ "$relative" == 'etc/systemd/journald.conf.d/60-taptime.conf' ]] &&
      ! cmp --silent "$candidate" "$target" 2>/dev/null; then
      journald_changed=1
    fi
    if [[ -d "$target" && ! -L "$target" ]] && ! is_operations_directory_path "$relative"; then
      fail "Operations target is unexpectedly a directory: $target"
      return 1
    fi
    install -d -m 0755 "$(dirname "$target")"
  done < <(operations_paths)

  install -d -m 0700 "$OPERATIONS_RUNTIME_ROOT"
  backup_directory="$(mktemp -d "$OPERATIONS_RUNTIME_ROOT/rollback.XXXXXX")"

  # Invoked by the EXIT trap below.
  # shellcheck disable=SC2317,SC2329
  finish_operations_install() {
    local status=$?
    local rollback_index rollback_target rollback_temporary
    trap - EXIT
    if (( status != 0 && committed == 0 )); then
      for (( rollback_index=${#targets[@]} - 1; rollback_index >= 0; rollback_index-- )); do
        rollback_target="${targets[$rollback_index]}"
        if [[ "${existed[$rollback_index]}" == 'directory' ]]; then
          rm -f -- "$rollback_target"
          mv "${backups[$rollback_index]}" "$rollback_target"
        elif [[ "${existed[$rollback_index]}" == '1' ]]; then
          rollback_temporary="${rollback_target}.taptime-rollback.$$"
          copy_preserving_link "${backups[$rollback_index]}" "$rollback_temporary"
          move_replace_no_target "$rollback_temporary" "$rollback_target"
        else
          rm -f -- "$rollback_target"
        fi
      done
      if (( current_switched == 1 )); then
        if (( current_existed == 1 )); then
          switch_directory="$(mktemp -d "$OPERATIONS_ROOT/.rollback-current.XXXXXX")"
          ln -s "$previous_current" "$switch_directory/current"
          move_replace_no_target "$switch_directory/current" "$OPERATIONS_ROOT/current"
          rmdir "$switch_directory"
        else
          rm -f -- "$OPERATIONS_ROOT/current"
        fi
      fi
      reload_operations_runtime "$units_changed" "$journald_changed" >/dev/null 2>&1 || true
    fi
    rm -rf -- "$backup_directory"
    exit "$status"
  }
  trap finish_operations_install EXIT

  if [[ -L "$OPERATIONS_ROOT/current" ]]; then
    current_existed=1
    previous_current="$(readlink "$OPERATIONS_ROOT/current")"
  elif [[ -e "$OPERATIONS_ROOT/current" ]]; then
    fail "$OPERATIONS_ROOT/current is not a symbolic link."
    return 1
  fi

  switch_directory="$(mktemp -d "$OPERATIONS_ROOT/.deploy-current.XXXXXX")"
  ln -s "releases/$version" "$switch_directory/current"
  move_replace_no_target "$switch_directory/current" "$OPERATIONS_ROOT/current"
  rmdir "$switch_directory"
  current_switched=1

  while IFS= read -r relative; do
    target="$(operations_target "$relative")"
    targets+=("$target")
    backups+=("$backup_directory/$index")
    if [[ -d "$target" && ! -L "$target" ]]; then
      existed+=(directory)
      mv "$target" "$backup_directory/$index"
    elif [[ -e "$target" || -L "$target" ]]; then
      copy_preserving_link "$target" "$backup_directory/$index"
      existed+=(1)
    else
      existed+=(0)
    fi
    temporary="${target}.taptime-operations.$$"
    ln -s "$OPERATIONS_ROOT/current/$relative" "$temporary"
    move_replace_no_target "$temporary" "$target"
    index=$((index + 1))
  done < <(operations_paths)

  reload_operations_runtime "$units_changed" "$journald_changed"
  operations_targets_are_linked || fail 'Not every operations target points to the selected release.'
  while IFS= read -r relative; do
    operations_target_matches_release "$release" "$relative" || {
      fail "Installed operations file differs from release: $relative"
      return 1
    }
  done < <(operations_paths)

  committed=1
  say "[Vorbereitung] Betriebsskripte, Einheiten, Compose und Caddy belegen Version $version."
)

deploy_operations_release() {
  local image="$1"
