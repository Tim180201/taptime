say() {
  printf '%s\n' "$*"
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  return 1
}

validate_offsite_borg_repository() {
  local repository_path authority host local_host resolved_addresses
  local local_address_text address local_address
  local -a local_addresses

  [[ "${BORG_REPOSITORY:-}" == ssh://* ]] || {
    fail 'BORG_REPOSITORY must use non-local ssh:// storage.'
    return 1
  }
  repository_path="${BORG_REPOSITORY#ssh://}"
  [[ "$repository_path" == */?* ]] || {
    fail 'BORG_REPOSITORY must name a remote archive path.'
    return 1
  }
  authority="${repository_path%%/*}"
  host="${authority#*@}"
  host="${host%%:*}"
  [[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] || {
    fail 'BORG_REPOSITORY must use a DNS name or IPv4 host.'
    return 1
  }
  local_host="$(hostname 2>/dev/null)" || {
    fail 'Could not determine the local host for offsite validation.'
    return 1
  }
  local_host="$(printf '%s' "$local_host" | tr '[:upper:]' '[:lower:]')"
  host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  [[ "$host" != 'localhost' && "$host" != '0.0.0.0' \
    && "$host" != 127.* && "$host" != "$local_host" ]] || {
    fail 'BORG_REPOSITORY must not resolve by configuration to this host.'
    return 1
  }
  resolved_addresses="$(getent ahostsv4 "$host" 2>/dev/null \
    | awk '{print $1}')" || {
    fail 'BORG_REPOSITORY host could not be resolved for offsite validation.'
    return 1
  }
  [[ -n "$resolved_addresses" ]] || {
    fail 'BORG_REPOSITORY host resolved to no IPv4 address.'
    return 1
  }
  local_address_text="$(hostname -I 2>/dev/null)" || {
    fail 'Could not read local interface addresses for offsite validation.'
    return 1
  }
  [[ -n "$local_address_text" ]] || {
    fail 'No local interface address was available for offsite validation.'
    return 1
  }
  read -r -a local_addresses <<< "$local_address_text"
  while IFS= read -r address; do
    [[ "$address" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
      fail 'BORG_REPOSITORY host resolution returned invalid IPv4 evidence.'
      return 1
    }
    [[ "$address" != '0.0.0.0' && "$address" != 127.* ]] || {
      fail 'BORG_REPOSITORY must resolve only to non-local addresses.'
      return 1
    }
    for local_address in "${local_addresses[@]}"; do
      [[ "$address" != "$local_address" ]] || {
        fail 'BORG_REPOSITORY resolves to a local interface address.'
        return 1
      }
    done
  done <<< "$resolved_addresses"
  [[ -n "${BORG_RSH:-}" \
    && "$BORG_RSH" == *'BatchMode=yes'* \
    && "$BORG_RSH" == *'IdentitiesOnly=yes'* \
    && "$BORG_RSH" == *'StrictHostKeyChecking=yes'* \
    && "$BORG_RSH" == *'UserKnownHostsFile='* ]] || {
    fail 'BORG_RSH must enforce the configured key and verified host identity.'
    return 1
  }
}

require_file() {
  [[ -f "$1" ]] || fail "Required file is missing: $1"
}

require_root() {
  [[ "$(id -u)" == '0' ]] || fail 'Deployment must run as root on the production server.'
}

validate_version() {
  [[ "$1" =~ ^[0-9a-f]{7}$ ]] || fail 'Version must be exactly one seven-character lowercase commit hash.'
}

image_for_version() {
  printf '%s:%s\n' "$IMAGE_REPOSITORY" "$1"
}

admin_web_image_for_version() {
  printf '%s:admin-web-%s\n' "$IMAGE_REPOSITORY" "$1"
}

operations_image_for_version() {
  printf '%s:operations-%s\n' "$IMAGE_REPOSITORY" "$1"
}

select_operations_version() {
  local desired="$1"
  local current_application="$2"
  local current_operations="$3"
  local landing_capability="${4:-1}"

  # Sources before landing cannot satisfy this controller's operations inventory.
  # Keep the explicitly installed operations even for a previously unknown old target.
  if [[ "$landing_capability" == 0 ]]; then
    printf '%s\n' "$current_operations"
  elif [[ "$desired" == "$current_application" ]] || {
    [[ -f "$KNOWN_VERSIONS_FILE" ]] &&
      grep --fixed-strings --line-regexp --quiet "$desired" "$KNOWN_VERSIONS_FILE"
  }; then
    printf '%s\n' "$current_operations"
  else
    printf '%s\n' "$desired"
  fi
}

selected_postgres_volume() {
  local volume='taptime-postgres-data'
  if [[ -f "$POSTGRES_VOLUME_STATE_FILE" ]]; then
    volume="$(tr -d '[:space:]' < "$POSTGRES_VOLUME_STATE_FILE")"
  fi
  [[ "$volume" == 'taptime-postgres-data' \
    || "$volume" =~ ^taptime-postgres-restored-[0-9]{8}T[0-9]{6}Z$ ]] ||
    {
      fail "Invalid PostgreSQL volume state: $volume"
      return 1
    }
  printf '%s\n' "$volume"
}

compose() {
  local postgres_volume
  postgres_volume="$(selected_postgres_volume)" || return
  TAPTIME_VERSION="$1" TAPTIME_POSTGRES_VOLUME="$postgres_volume" \
    docker compose --file "$COMPOSE_FILE" "${@:2}"
}

status_fingerprint() {
  if [[ -f "$1" ]]; then
    stat --format='%y:%s' "$1"
  else
    printf 'missing\n'
  fi
}

file_mode() {
  if stat --format='%a' "$1" >/dev/null 2>&1; then
    stat --format='%a' "$1"
  else
    stat -f '%Lp' "$1"
  fi
}

move_replace_no_target() {
  if mv --help 2>&1 | grep --quiet -- '--no-target-directory'; then
    mv -Tf "$1" "$2"
  else
    mv -fh "$1" "$2"
  fi
}

copy_preserving_link() {
  cp -a "$1" "$2"
}

run_fresh_oneshot() {
  local service="$1"
  local status_file="$2"
  local before after

  before="$(status_fingerprint "$status_file")" || return
  systemctl start "$service" || return
  after="$(status_fingerprint "$status_file")" || return
  [[ "$after" != "$before" ]] || {
    fail "$service did not produce a fresh status record."
    return 1
  }
  grep --quiet '"state":"ok"' "$status_file" || fail "$service did not finish successfully."
}

wait_for_running_backup() {
  local state deadline next_notice now
  [[ "$BACKUP_WAIT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
    fail 'Backup wait must be a positive number of seconds.'; return 1;
  }
  now="$(date +%s)"
  deadline=$((now + BACKUP_WAIT_SECONDS))
  next_notice=$now
  while true; do
    state="$(systemctl show taptime-backup.service --property=ActiveState --value)" || return
    case "$state" in
      inactive|failed) return 0;;
      activating|active|deactivating|reloading) ;;
      *) fail 'Unknown backup service state.'; return 1;;
    esac
    now="$(date +%s)"
    (( now < deadline )) || { fail 'Running backup exceeded the deploy wait deadline.'; return 1; }
    if (( now >= next_notice )); then
      say "[Vorprüfung] Sicherung läuft; warte noch höchstens $((deadline - now)) Sekunden."
      next_notice=$((now + 60))
    fi
    sleep 1
  done
}

hold_backup_timer() {
  local state
  state="$(systemctl show taptime-backup.timer --property=ActiveState --value)" || return
  [[ "$state" == active ]] || { fail 'Backup timer is not active.'; return 1; }
  # Arm cleanup before the stop: a signal or partially failed stop still restores the timer.
  BACKUP_TIMER_HELD=1
  trap 'finish_deploy $?' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  systemctl stop taptime-backup.timer || return
  wait_for_running_backup
}

preflight_deploy() {
  local state ended result exit_status unit available total used disk_limit
  local failed=0
  say "[Vorprüfung] Laufende Version: $PREVIOUS_VERSION."
  say "[Vorprüfung] Ziel: $DESIRED_VERSION."
  state="$(systemctl show taptime-backup.service --property=ActiveState --value)" || return
  ended="$(systemctl show taptime-backup.service --property=InactiveEnterTimestamp --value)" || return
  result="$(systemctl show taptime-backup.service --property=Result --value)" || return
  exit_status="$(systemctl show taptime-backup.service --property=ExecMainStatus --value)" || return
  say "[Vorprüfung] Sicherung: Zustand=$state; letztes Ende=${ended:-unbekannt}; Ergebnis=$result/$exit_status."
  [[ "$state" == inactive && -n "$ended" && "$result" == success && "$exit_status" == 0 ]] || failed=1
  for unit in taptime-wal-archiver.service taptime-wal-receiver.service; do
    state="$(systemctl show "$unit" --property=ActiveState --value)" || return
    say "[Vorprüfung] $unit: $state."
    # Missing archive services are expected only on the explicitly detected first cutover.
    [[ "$state" == active || "$WAL_ARCHIVE_BOOTSTRAP" == 1 ]] || failed=1
  done
  disk_limit="$(sed -n 's/^readonly DISK_USAGE_THRESHOLD_PERCENT=\([0-9][0-9]*\)$/\1/p' "$DAILY_MONITOR_COMMAND")" || return
  read -r total available used < <(df -Pk / | awk 'NR == 2 {gsub(/%/, "", $5); print $2, $4, $5}')
  say "[Vorprüfung] Plattenplatz: ${available:-unbekannt} KiB frei von ${total:-unbekannt} KiB."
  [[ "$total" =~ ^[1-9][0-9]*$ && "$available" =~ ^[0-9]+$ \
    && "$used" =~ ^[0-9]+$ && "$disk_limit" =~ ^[1-9][0-9]*$ ]] || failed=1
  if (( failed == 0 )); then
    # Derive the existing red condition from the installed daily monitor, without running it.
    (( used < disk_limit )) || failed=1
  fi
  (( failed == 0 )) || { fail 'Deploy preflight failed before preparation.'; return 1; }
}

pull_image() {
  local image="$1"
  local version revision

  say "[Vorbereitung] Lade ausdrücklich angefordertes Abbild $image."
  docker pull "$image" || return
  docker image inspect "$image" >/dev/null || return
  version="${image##*:}"
  version="${version#admin-web-}"
  version="${version#operator-web-}"
  version="${version#landing-web-}"
  version="${version#operations-}"
  validate_version "$version" || return
  revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")" || return
  [[ "$revision" == "$version"* ]] ||
    fail "Image revision label does not match requested version $version."
}

