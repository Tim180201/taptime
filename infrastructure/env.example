# HTTP listen port. Optional; the backend defaults to 3000.
PORT=3000

# Supabase Auth issuer URL used to validate access tokens.
SUPABASE_ISSUER=https://<project-reference>.supabase.co/auth/v1

# Each database URL must use a distinct LOGIN role with only the capability needed by that pool.
TAPTIME_SESSION_DATABASE_URL=postgresql://<session-role>:<password>@<host>:5432/<database>
TAPTIME_READ_MODEL_DATABASE_URL=postgresql://<read-model-role>:<password>@<host>:5432/<database>
TAPTIME_LIFECYCLE_DATABASE_URL=postgresql://<lifecycle-role>:<password>@<host>:5432/<database>
TAPTIME_ADMINISTRATION_DATABASE_URL=postgresql://<administration-role>:<password>@<host>:5432/<database>
TAPTIME_EMPLOYEE_INVITATION_DATABASE_URL=postgresql://<invitation-role>:<password>@<host>:5432/<database>
TAPTIME_EMPLOYEE_ENROLLMENT_DATABASE_URL=postgresql://<enrollment-role>:<password>@<host>:5432/<database>
TAPTIME_REASSIGNMENT_DATABASE_URL=postgresql://<reassignment-role>:<password>@<host>:5432/<database>
TAPTIME_OFFLINE_LEASE_DATABASE_URL=postgresql://<offline-lease-role>:<password>@<host>:5432/<database>
TAPTIME_OFFLINE_EVENT_DATABASE_URL=postgresql://<offline-event-role>:<password>@<host>:5432/<database>
TAPTIME_OFFLINE_RECONCILIATION_DATABASE_URL=postgresql://<offline-reconciliation-role>:<password>@<host>:5432/<database>
TAPTIME_TIME_ENTRY_EXPORT_DATABASE_URL=postgresql://<time-export-role>:<password>@<host>:5432/<database>
TAPTIME_TIME_REVIEW_READ_DATABASE_URL=postgresql://<time-review-read-role>:<password>@<host>:5432/<database>
TAPTIME_TIME_REVIEW_WRITE_DATABASE_URL=postgresql://<time-review-write-role>:<password>@<host>:5432/<database>
TAPTIME_MANUAL_LIFECYCLE_DATABASE_URL=postgresql://<manual-lifecycle-role>:<password>@<host>:5432/<database>
TAPTIME_MOBILE_OWN_TIME_DATABASE_URL=postgresql://<mobile-own-time-role>:<password>@<host>:5432/<database>
TAPTIME_MOBILE_TARGET_DATABASE_URL=postgresql://<mobile-target-role>:<password>@<host>:5432/<database>
TAPTIME_PROJECT_ADMINISTRATION_DATABASE_URL=postgresql://<project-administration-role>:<password>@<host>:5432/<database>

# Canonical unpadded base64url encoding of 32 random bytes; keep it server-side and secret.
TAPTIME_MOBILE_OWN_TIME_CURSOR_HMAC_KEY=<43-character-base64url-value>
