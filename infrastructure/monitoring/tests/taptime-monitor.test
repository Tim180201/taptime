#!/usr/bin/env bash
set -euo pipefail

REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
readonly REPOSITORY_ROOT
readonly IMMEDIATE_MONITOR="${TAPTIME_TEST_MONITOR:-$REPOSITORY_ROOT/infrastructure/monitoring/taptime-immediate-monitor}"
readonly DAILY_MONITOR="$REPOSITORY_ROOT/infrastructure/monitoring/taptime-daily-monitor"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

assert_equals() {
  local expected="$1"
  local actual="$2"
  local description="$3"
  [[ "$actual" == "$expected" ]] || fail "$description: expected [$expected], got [$actual]"
}

epoch_for() {
  node -e 'process.stdout.write(String(Date.parse(process.argv[1]) / 1000))' "$1"
}

# D-066: archive_timeout archives the archiver's own receipts even without taps.
# Only explicit demand in the open segment may request an early switch.
for compose_file in docker-compose.server.yml docker-compose.local.yml; do
  database_service="$(awk '
    /^  database:/ { database = 1; next }
    database && /^  [^ ]/ { exit }
    database { print }
  ' "$REPOSITORY_ROOT/infrastructure/$compose_file")"
  [[ -n "$database_service" ]] || fail "$compose_file has no database service"
  if grep --quiet 'archive_timeout' <<< "$database_service"; then
    fail "$compose_file database must not configure archive_timeout (D-066)"
  fi
done

# systemctl reads the local systemd socket; the deployed sandbox must permit that family.
grep '^RestrictAddressFamilies=.*AF_UNIX' \
  "$REPOSITORY_ROOT/infrastructure/monitoring/taptime-immediate-monitor.service" >/dev/null \
  || fail 'the immediate monitor must be able to read systemd through AF_UNIX'

mkdir -p "$test_root/bin" "$test_root/config" "$test_root/state" "$test_root/messages"
chmod 0700 "$test_root/config" "$test_root/state"

cat > "$test_root/bin/curl" <<'FAKE_CURL'
#!/usr/bin/env bash
set -euo pipefail
printf '%q ' "$@" >> "$FAKE_CURL_ARGUMENT_LOG"
printf '\n' >> "$FAKE_CURL_ARGUMENT_LOG"
arguments=" $* "
if [[ "$arguments" == *' https://api.test/health '* ]]; then
  exit "${FAKE_API_EXIT_STATUS:-0}"
fi
if [[ "$arguments" == *'/ntfy.curl '* ]]; then
  message_number="$(find "$FAKE_MESSAGE_DIRECTORY" -type f | wc -l | tr -d ' ')"
  cat > "$FAKE_MESSAGE_DIRECTORY/$message_number"
  if [[ "$arguments" != *' --output /dev/null '* ]]; then
    printf '%s\n' '{"topic":"test-only-secret-topic"}'
  fi
  exit "${FAKE_NTFY_EXIT_STATUS:-0}"
fi
if [[ "$arguments" == *'/healthchecks.curl '* ]]; then
  printf 'heartbeat\n' >> "$FAKE_HEARTBEAT_LOG"
fi
FAKE_CURL

cat > "$test_root/bin/df" <<'FAKE_DF'
#!/usr/bin/env bash
set -euo pipefail
printf 'Use%%\n%s%%\n' "${FAKE_DISK_PERCENT:-0}"
FAKE_DF

cat > "$test_root/bin/systemctl" <<'FAKE_SYSTEMCTL'
#!/usr/bin/env bash
set -euo pipefail
[[ "$*" == 'show taptime-backup.service --property=LoadState,ActiveState,InactiveExitTimestamp,InactiveEnterTimestamp' ]]
[[ "${FAKE_SYSTEMCTL_FAILURE:-0}" == 0 ]] || exit 1
if [[ -n "${FAKE_RACE_DIRECTORY:-}" ]]; then
  printf 'systemctl\n' >> "$FAKE_RACE_DIRECTORY/order"
  for file in status progress; do
    [[ ! -f "$FAKE_RACE_DIRECTORY/$file.next" ]] || cp "$FAKE_RACE_DIRECTORY/$file.next" "$(cat "$FAKE_RACE_DIRECTORY/$file.path")"
  done
  cp "$FAKE_RACE_DIRECTORY/next-clock" "$FAKE_RACE_DIRECTORY/clock"
fi
printf 'LoadState=loaded\nActiveState=%s\nInactiveExitTimestamp=%s\nInactiveEnterTimestamp=%s\n' \
  "${FAKE_BACKUP_STATE:-inactive}" "${FAKE_BACKUP_STARTED:-}" "${FAKE_BACKUP_ENDED:-}"
FAKE_SYSTEMCTL

cat > "$test_root/bin/date" <<'FAKE_DATE'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == '+%s' && -n "${FAKE_RACE_DIRECTORY:-}" ]]; then
  printf 'clock\n' >> "$FAKE_RACE_DIRECTORY/order"
  cat "$FAKE_RACE_DIRECTORY/clock"
else /bin/date "$@"; fi
FAKE_DATE
chmod 0755 "$test_root/bin/date"
chmod 0755 "$test_root/bin/curl" "$test_root/bin/df" "$test_root/bin/systemctl"

cat > "$test_root/config/ntfy.curl" <<'EOF_NTFY'
url = "https://ntfy.sh/test-only-secret-topic"
EOF_NTFY
cat > "$test_root/config/healthchecks.curl" <<'EOF_HEALTHCHECKS'
url = "https://hc-ping.com/00000000-0000-4000-8000-test-only-secret"
EOF_HEALTHCHECKS
chmod 0600 "$test_root/config/ntfy.curl" "$test_root/config/healthchecks.curl"

readonly BACKUP_STATUS="$test_root/backup-status.json"
readonly RESTORE_STATUS="$test_root/restore-status.json"
readonly WAL_ARCHIVE_STATUS="$test_root/wal-archive-status.json"
readonly BACKUP_CONFIG="$test_root/backup.conf"
cat > "$BACKUP_CONFIG" <<EOF_BACKUP
STATUS_FILE='$BACKUP_STATUS'
WAL_ARCHIVE_STATUS_FILE='$WAL_ARCHIVE_STATUS'
WAL_ARCHIVE_INTERVAL_SECONDS='60'
WAL_ARCHIVE_MISSED_CYCLES='2'
EOF_BACKUP
chmod 0600 "$BACKUP_CONFIG"
printf '{"state":"ok","observed_at_utc":"%s","oldest_required_at_utc":null,"oldest_required_wal_file":null,"last_archived_wal_file":null,"last_archived_at_utc":null,"pending_count":0}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$WAL_ARCHIVE_STATUS"

export PATH="$test_root/bin:$PATH"
export TAPTIME_MONITOR_CONFIG_DIRECTORY="$test_root/config"
export TAPTIME_MONITOR_STATE_DIRECTORY="$test_root/state"
export TAPTIME_API_HEALTH_URL='https://api.test/health'
export TAPTIME_BACKUP_CONFIG="$BACKUP_CONFIG"
export FAKE_CURL_ARGUMENT_LOG="$test_root/curl-arguments"
export FAKE_MESSAGE_DIRECTORY="$test_root/messages"
export FAKE_HEARTBEAT_LOG="$test_root/heartbeats"
: > "$FAKE_CURL_ARGUMENT_LOG"
: > "$FAKE_HEARTBEAT_LOG"

# T-089 uses a real local live process with a synthetic clock, never a server.
iso_for() { node -e 'process.stdout.write(new Date(Number(process.argv[1])*1000).toISOString().replace(".000Z","Z"))' "$1"; }
progress_file="$test_root/wal-archive-progress"
fixture_pid=$BASHPID
fixture_process_start="$(awk '{sub(/^.*\) /, ""); print $20}' "/proc/$fixture_pid/stat")"
fixture_boot_id="$(cat /proc/sys/kernel/random/boot_id)"
write_progress() {
  printf '{"cycle_started_at_utc":"%s","phase":"%s","observed_at_utc":"%s","pid":%s,"process_start_ticks":"%s","boot_id":"%s"}\n' \
    "$(iso_for "$1")" "${2:-base}" "$(iso_for "$3")" "$fixture_pid" "$fixture_process_start" "$fixture_boot_id" > "$progress_file"
  chmod 0600 "$progress_file"
}
# shellcheck disable=SC2030 # Intentionally isolate the exported fixture values in this scenario.
progress_case() (
  local -x FAKE_BACKUP_STATE=inactive FAKE_BACKUP_STARTED=''
  test_case="$1"
  now="$(epoch_for '2026-09-28T12:00:00Z')"
  observed=$((now - 140)); started=$((now - 82)); pending=0; oldest=$((now - 121))
  expected=''; state=ok
  case "$test_case" in
    active|race-status|race-progress) ;;
    boundary) started=$((now - 600)) ;;
    hung) started=$((now - 601)); expected='Durchlauf hängt seit 10 min (Phase base)' ;;
    hung-fresh) observed=$now; started=$((now - 601)); expected='Durchlauf hängt seit 10 min (Phase base)' ;;
    absent|dead|reused|reboot|future|bad-phase|public|symlink|malformed)
      observed=$((now - 121)); expected='Archivierer ohne Lebenszeichen seit 2 min' ;;
    pending) pending=1; expected='WAL-Segment wartet seit 2 min' ;;
    failed) state=failed; expected='Status nicht ok' ;;
    missing) expected='Status nicht ok' ;;
    backup)
      FAKE_BACKUP_STATE=activating
      FAKE_BACKUP_STARTED="$(iso_for "$((now - 841))")"
      printf '420\n' > "$test_root/state/backup-duration-seconds"
      expected='Sicherung läuft seit 14 min' ;;
    *) fail "unknown progress case: $test_case" ;;
  esac
  rm -f "$progress_file" "$progress_file.target"
  write_progress "$started" base "$now"
  case "$test_case" in
    absent) rm "$progress_file" ;;
    dead) sed -i 's/"pid":[0-9]*/"pid":99999999/' "$progress_file" ;;
    reused) sed -i 's/"process_start_ticks":"[0-9]*"/"process_start_ticks":"0"/' "$progress_file" ;;
    reboot) sed -i 's/"boot_id":"[^"]*"/"boot_id":"00000000-0000-0000-0000-000000000000"/' "$progress_file" ;;
    future) write_progress "$((now + 1))" base "$((now + 1))" ;;
    bad-phase) write_progress "$started" 'ssh://test-only-secret-topic/path' "$now" ;;
    public) chmod 0644 "$progress_file" ;;
    symlink) mv "$progress_file" "$progress_file.target"; ln -s "$progress_file.target" "$progress_file" ;;
    malformed) printf 'broken\n' > "$progress_file" ;;
  esac
  printf '{"state":"%s","observed_at_utc":"%s","pending_count":%s,"oldest_required_at_utc":"%s","oldest_required_wal_file":"000000010000000000000002"}\n' \
    "$state" "$(iso_for "$observed")" "$pending" "$(iso_for "$oldest")" > "$WAL_ARCHIVE_STATUS"
  [[ "$test_case" != missing ]] || rm "$WAL_ARCHIVE_STATUS"
  rm -f "$test_root/messages"/* "$test_root/state/wal-archive-down"
  if [[ "$test_case" == race-* ]]; then
    local -x FAKE_RACE_DIRECTORY="$test_root/race"
    mkdir -p "$FAKE_RACE_DIRECTORY"
    : > "$FAKE_RACE_DIRECTORY/order"
    printf '%s\n' "$now" > "$FAKE_RACE_DIRECTORY/clock"
    printf '%s\n' "$((now + 1))" > "$FAKE_RACE_DIRECTORY/next-clock"
    printf '%s\n' "$WAL_ARCHIVE_STATUS" > "$FAKE_RACE_DIRECTORY/status.path"
    printf '%s\n' "$progress_file" > "$FAKE_RACE_DIRECTORY/progress.path"
    if [[ "$test_case" == race-status ]]; then
      rm -f "$progress_file"
      printf '{"state":"ok","observed_at_utc":"%s","pending_count":0}\n' "$(iso_for "$((now + 1))")" > "$FAKE_RACE_DIRECTORY/status.next"
    else
      write_progress "$started" base "$((now + 1))"
      mv "$progress_file" "$FAKE_RACE_DIRECTORY/progress.next"
    fi
    env -u TAPTIME_MONITOR_NOW_EPOCH FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
    assert_equals $'systemctl\nclock' "$(cat "$FAKE_RACE_DIRECTORY/order")" 'clock must follow external observations'
    rm -f "$FAKE_RACE_DIRECTORY/"*.next
  else
    TAPTIME_MONITOR_NOW_EPOCH="$now" FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
  fi
  if [[ -z "$expected" ]]; then
    assert_equals 0 "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" "$test_case must stay silent"
  else
    assert_equals 1 "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" "$test_case must alert"
    assert_equals "WAL-Archivierung steht: $expected; at=2026-09-28T12:00:00Z" "$(cat "$test_root/messages/0")" "$test_case cause and UTC"
    if grep -Eq '/|@|test-only-secret|[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$test_root/messages/0"; then fail 'message leaked a path, address or secret'; fi
  fi
)
if [[ -n "${TAPTIME_TEST_PROGRESS_CASE:-}" ]]; then
  progress_case "$TAPTIME_TEST_PROGRESS_CASE"
  exit 0
fi
for progress_test in race-status race-progress active boundary hung hung-fresh absent dead reused reboot future bad-phase public symlink malformed pending failed missing backup; do
  progress_case "$progress_test"
done
rm -f "$progress_file" "$progress_file.target" "$test_root/state/wal-archive-down" "$test_root/state/backup-duration-seconds" "$test_root/messages"/*
: > "$FAKE_CURL_ARGUMENT_LOG"; : > "$FAKE_HEARTBEAT_LOG"
printf '{"state":"ok","observed_at_utc":"%s","pending_count":0}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$WAL_ARCHIVE_STATUS"

immediate_output="$(FAKE_API_EXIT_STATUS=1 "$IMMEDIATE_MONITOR")"
assert_equals '' "$immediate_output" \
  'the immediate monitor must discard the ntfy response body containing the topic'
assert_equals 'API antwortet nicht' "$(< "$test_root/messages/0")" \
  'the immediate alert must use the one fixed API message'
assert_equals '1' "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" \
  'the first API failure must send exactly one alert'
FAKE_API_EXIT_STATUS=1 "$IMMEDIATE_MONITOR"
assert_equals '1' "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" \
  'a continuing API failure must not repeat the alert'
FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
FAKE_API_EXIT_STATUS=1 "$IMMEDIATE_MONITOR"
assert_equals '2' "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" \
  'a new API failure after recovery must send one new alert'
assert_equals '4' "$(wc -l < "$FAKE_HEARTBEAT_LOG" | tr -d ' ')" \
  'every immediate run must send one dead-man heartbeat'
grep -q -- '--head' "$FAKE_CURL_ARGUMENT_LOG" || fail 'the dead-man heartbeat must use HEAD'
grep -q 'Priority:.*5' "$FAKE_CURL_ARGUMENT_LOG" || fail 'the API alert must use urgent priority'
if grep -Eq 'test-only-secret-topic|00000000-0000-4000-8000-test-only-secret' \
  "$FAKE_CURL_ARGUMENT_LOG"; then
  fail 'secret URLs must not appear in curl process arguments'
fi

printf '%s\n' '{"state":"failed","observed_at_utc":"2026-08-24T12:00:00Z","oldest_required_at_utc":null,"oldest_required_wal_file":null,"last_archived_wal_file":null,"last_archived_at_utc":null,"pending_count":0}' \
  > "$WAL_ARCHIVE_STATUS"
TAPTIME_MONITOR_NOW_EPOCH="$(epoch_for '2026-08-24T12:00:00Z')" \
  FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
assert_equals 'WAL-Archivierung steht: Status nicht ok; at=2026-08-24T12:00:00Z' "$({ find "$test_root/messages" -type f -print0 \
  | xargs -0 grep -l 'WAL-Archivierung steht'; } | head -n 1 | xargs cat)" \
  'an inactive receiver with no pending event must raise the WAL alert'

printf '{"state":"ok","observed_at_utc":"%s","oldest_required_at_utc":null,"oldest_required_wal_file":null,"last_archived_wal_file":null,"last_archived_at_utc":null,"pending_count":0}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$WAL_ARCHIVE_STATUS"
FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
rm -f "$test_root/messages"/*

# Fresh status must not hide an overdue requirement, and an old archive timestamp must
# not alarm on a new requirement. Derive the boundary from the monitor's actual config.
# shellcheck source=/dev/null
source "$BACKUP_CONFIG"
archive_window=$((WAL_ARCHIVE_INTERVAL_SECONDS * WAL_ARCHIVE_MISSED_CYCLES))
required_at='2026-08-24T12:00:00Z'
required_epoch="$(epoch_for "$required_at")"
for age in "$((archive_window - 1))" "$archive_window" "$((archive_window + 1))" "$((archive_window + 2))"; do
  observed_at="$(node -e 'process.stdout.write(new Date(Number(process.argv[1]) * 1000).toISOString().replace(".000Z", "Z"))' \
    "$((required_epoch + age))")"
  printf '{"state":"ok","observed_at_utc":"%s","oldest_required_at_utc":"%s","oldest_required_wal_file":"000000010000000000000002","last_archived_wal_file":"000000010000000000000001","last_archived_at_utc":"2026-08-23T12:00:00Z","pending_count":1}\n' \
    "$observed_at" "$required_at" > "$WAL_ARCHIVE_STATUS"
  TAPTIME_MONITOR_NOW_EPOCH="$((required_epoch + age))" \
    FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
  expected_alerts=0
  (( age <= archive_window )) || expected_alerts=1
  assert_equals "$expected_alerts" "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" \
    "a requirement aged $age seconds must respect the configured window and alert once"
done
assert_equals 'WAL-Archivierung steht: WAL-Segment wartet seit 2 min; at=2026-08-24T12:02:01Z' "$(< "$test_root/messages/0")" \
  'only the overdue requirement must raise the WAL alert with its cause'

# Recovery clears the latch before exercising the existing stale-status case.
printf '{"state":"ok","observed_at_utc":"%s","pending_count":0}\n' \
  "$observed_at" > "$WAL_ARCHIVE_STATUS"
TAPTIME_MONITOR_NOW_EPOCH="$((required_epoch + age))" FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
rm -f "$test_root/messages"/*

printf '%s\n' '{"state":"ok","observed_at_utc":"2026-08-24T11:50:00Z","oldest_required_at_utc":"2026-08-24T11:49:00Z","oldest_required_wal_file":"000000010000000000000002","last_archived_wal_file":"000000010000000000000001","last_archived_at_utc":"2026-08-24T11:48:00Z","pending_count":1}' \
  > "$WAL_ARCHIVE_STATUS"
TAPTIME_MONITOR_NOW_EPOCH="$(epoch_for '2026-08-24T12:00:00Z')" \
  FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
assert_equals 'WAL-Archivierung steht: Archivierer ohne Lebenszeichen seit 10 min; at=2026-08-24T12:00:00Z' "$({ find "$test_root/messages" -type f -print0 \
  | xargs -0 grep -l 'WAL-Archivierung steht'; } | head -n 1 | xargs cat)" \
  'a backlog beyond the configured cadence must raise the derived WAL alert'

printf '%s\n' '{"state":"failed","observed_at_utc":"2026-08-24T12:00:00Z","oldest_required_at_utc":null,"oldest_required_wal_file":null,"last_archived_wal_file":null,"last_archived_at_utc":null,"pending_count":0}' \
  > "$WAL_ARCHIVE_STATUS"
rm -f "$test_root/state/wal-archive-down"
heartbeat_count_before="$(wc -l < "$FAKE_HEARTBEAT_LOG" | tr -d ' ')"
set +e
TAPTIME_MONITOR_NOW_EPOCH="$(epoch_for '2026-08-24T12:00:00Z')" \
  FAKE_API_EXIT_STATUS=0 FAKE_NTFY_EXIT_STATUS=1 "$IMMEDIATE_MONITOR" \
  >/dev/null 2>&1
undelivered_status=$?
set -e
(( undelivered_status != 0 )) || fail 'an undeliverable WAL alert must fail the monitor run'
assert_equals "$heartbeat_count_before" \
  "$(wc -l < "$FAKE_HEARTBEAT_LOG" | tr -d ' ')" \
  'an undeliverable WAL alert must not send a success heartbeat'

rm -f "$test_root/messages"/*
printf '%s\n' '{"state":"ok","last_success_at_utc":"2026-08-24T10:30:00Z"}' > "$BACKUP_STATUS"
printf '%s\n' '{"state":"ok","last_attempt_at_utc":"2026-08-23T03:40:00Z"}' > "$RESTORE_STATUS"
export TAPTIME_RESTORE_STATUS_FILE="$RESTORE_STATUS"
export TAPTIME_MONITOR_NOW_EPOCH
TAPTIME_MONITOR_NOW_EPOCH="$(epoch_for '2026-08-24T12:00:00Z')"
export FAKE_DISK_PERCENT=79

"$DAILY_MONITOR"
assert_equals '0' "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" \
  'healthy daily checks must stay silent'

printf '%s\n' '{"state":"ok","last_attempt_at_utc":"2026-08-15T03:40:00Z"}' > "$RESTORE_STATUS"
"$DAILY_MONITOR"
assert_equals 'Wiederherstellungsprüfung fehlgeschlagen' "$(< "$test_root/messages/0")" \
  'a stale successful restore check must use the fixed restore-failure message'

rm -f "$test_root/messages"/*
printf '%s\n' '{"state":"ok","last_success_at_utc":"2026-08-24T09:00:00Z"}' > "$BACKUP_STATUS"
printf '%s\n' '{"state":"failed","last_attempt_at_utc":"2026-08-23T03:40:00Z"}' > "$RESTORE_STATUS"
daily_output="$(FAKE_DISK_PERCENT=80 "$DAILY_MONITOR")"
assert_equals '' "$daily_output" \
  'the daily monitor must discard the ntfy response body containing the topic'
expected_daily=$'Sicherung überfällig\nWiederherstellungsprüfung fehlgeschlagen\nPlatte über 80 Prozent'
assert_equals "$expected_daily" "$(< "$test_root/messages/0")" \
  'daily failures must be bundled from the three fixed normal-priority messages'
assert_equals '1' "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" \
  'daily failures must produce one bundled push'
grep -q 'Priority:.*3' "$FAKE_CURL_ARGUMENT_LOG" || fail 'the daily alert must use normal priority'

alert_messages="$(grep -Eoh \
  'API antwortet nicht|WAL-Archivierung steht|Sicherung überfällig|Wiederherstellungsprüfung fehlgeschlagen|Platte über 80 Prozent' \
  "$IMMEDIATE_MONITOR" "$DAILY_MONITOR" | sort -u)"
for expected_alert in \
  'API antwortet nicht' \
  'WAL-Archivierung steht' \
  'Sicherung überfällig' \
  'Wiederherstellungsprüfung fehlgeschlagen' \
  'Platte über 80 Prozent'; do
  printf '%s\n' "$alert_messages" | grep --fixed-strings --line-regexp --quiet "$expected_alert" \
    || fail "missing operational alert: $expected_alert"
done

# systemd Type=oneshot remains activating while ExecStart waits on flock. The start
# belongs to that activation, never the monitor's observation or a stale success file.
# shellcheck disable=SC2031 # Fresh values below are independent of isolated progress scenarios.
export FAKE_BACKUP_STATE FAKE_BACKUP_STARTED FAKE_BACKUP_ENDED
backup_start="$(epoch_for '2026-08-24T12:00:00Z')"
iso_for() { node -e 'process.stdout.write(new Date(Number(process.argv[1])*1000).toISOString().replace(".000Z","Z"))' "$1"; }
check_backup_alert() {
  local now="$1" expected="$2" description="$3"
  rm -f "$test_root/messages"/* "$test_root/state/wal-archive-down"
  TAPTIME_MONITOR_NOW_EPOCH="$now" FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
  assert_equals "$expected" "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" "$description"
  if (( expected )); then
    grep -Eq '^WAL-Archivierung steht: .+; at=[0-9TZ:-]+$' "$test_root/messages/0" || fail "$description message"
  fi
}
FAKE_BACKUP_STARTED="$(iso_for "$backup_start")"
FAKE_BACKUP_ENDED="$(iso_for "$((backup_start - 3600))")"
for FAKE_BACKUP_STATE in activating active deactivating; do
  for duration in 599 600 601; do
    # Even a fresh empty status cannot hide a backup exceeding the fixed ten minutes.
    printf '{"state":"ok","observed_at_utc":"%s","pending_count":0}\n' \
      "$(iso_for "$((backup_start + duration))")" > "$WAL_ARCHIVE_STATUS"
    expected=0; (( duration <= 600 )) || expected=1
    check_backup_alert "$((backup_start + duration))" "$expected" "$FAKE_BACKUP_STATE for $duration seconds"
  done
done
FAKE_BACKUP_STATE=activating
rm "$WAL_ARCHIVE_STATUS"
check_backup_alert "$((backup_start + 599))" 0 'a waiting backup pauses missing status at 9:59'
check_backup_alert "$((backup_start + 601))" 1 'a backup that never acquired the lock alarms at 10:01'

backup_end=$((backup_start + 120))
FAKE_BACKUP_STATE=inactive
FAKE_BACKUP_ENDED="$(iso_for "$backup_end")"
for requirement in "$((backup_start - 10))" "$((backup_start + 60))" "$((backup_end + 30))" "$((backup_end + 280))"; do
  for elapsed in 119 121 299 300 301 421; do
    now=$((backup_end + elapsed))
    # Observe freshly to isolate requirement age; requirements after backup keep their own clock.
    printf '{"state":"ok","observed_at_utc":"%s","oldest_required_at_utc":"%s","oldest_required_wal_file":"000000010000000000000002","last_archived_wal_file":"000000010000000000000001","pending_count":1}\n' \
      "$(iso_for "$now")" "$(iso_for "$requirement")" > "$WAL_ARCHIVE_STATUS"
    deadline=$((requirement + archive_window))
    (( deadline >= backup_end + 300 )) || deadline=$((backup_end + 300))
    expected=0; (( now <= deadline )) || expected=1
    check_backup_alert "$now" "$expected" "requirement=$requirement after backup elapsed=$elapsed"
  done
done
for observed_epoch in "$((backup_start - 10))" "$((backup_start + 60))" "$((backup_end + 30))" "$((backup_end + 280))"; do
  for elapsed in 119 121 299 300 301 421; do
    status_epoch=$observed_epoch
    (( status_epoch <= backup_end + elapsed )) || status_epoch=$((backup_end + elapsed))
    printf '{"state":"ok","observed_at_utc":"%s","pending_count":0}\n' \
      "$(iso_for "$status_epoch")" > "$WAL_ARCHIVE_STATUS"
    deadline=$((status_epoch + archive_window))
    (( deadline >= backup_end + 300 )) || deadline=$((backup_end + 300))
    expected=0; (( backup_end + elapsed <= deadline )) || expected=1
    check_backup_alert "$((backup_end + elapsed))" "$expected" "status=$observed_epoch after backup elapsed=$elapsed"
  done
done
# Grace changes age only: neither a failed status nor a gap becomes healthy after backup.
printf '{"state":"failed"}\n' > "$WAL_ARCHIVE_STATUS"
check_backup_alert "$((backup_end + 1))" 1 'backup end does not hide failed archive status'
printf '{"state":"ok","observed_at_utc":"%s","oldest_required_at_utc":"%s","oldest_required_wal_file":"000000010000000000000002","last_archived_wal_file":"000000010000000000000003","pending_count":1}\n' \
  "$(iso_for "$backup_end")" "$(iso_for "$backup_start")" > "$WAL_ARCHIVE_STATUS"
check_backup_alert "$((backup_end + 1))" 1 'backup end does not hide a WAL gap'

# The grace is bounded configuration and cannot slide on repeated monitor calls.
for grace in 1 300 600; do
  printf "\nWAL_ARCHIVE_CATCHUP_SECONDS='%s'\n" "$grace" >> "$BACKUP_CONFIG"
  printf '{"state":"ok","observed_at_utc":"%s","oldest_required_at_utc":"%s","oldest_required_wal_file":"000000010000000000000002","last_archived_wal_file":"000000010000000000000001","pending_count":1}\n' \
    "$(iso_for "$((backup_start - 1000))")" "$(iso_for "$((backup_start - 1000))")" > "$WAL_ARCHIVE_STATUS"
  check_backup_alert "$((backup_end + grace - 1))" 0 "catch-up $grace before deadline"
  check_backup_alert "$((backup_end + grace + 1))" 1 "catch-up $grace after deadline"
  : > "$FAKE_CURL_ARGUMENT_LOG"
  TAPTIME_MONITOR_NOW_EPOCH="$((backup_end + grace + 2))" FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR"
  assert_equals 1 "$(find "$test_root/messages" -type f | wc -l | tr -d ' ')" 'catch-up alarm remains edge-triggered'
done
# T-083 learns the completed duration before the next backup starts; it never
# derives a longer allowance from the currently running backup.
printf "\nWAL_ARCHIVE_CATCHUP_SECONDS='300'\n" >> "$BACKUP_CONFIG"
printf '{"state":"failed"}\n' > "$WAL_ARCHIVE_STATUS"
for previous_duration in 0 120 1500 2400; do
  FAKE_BACKUP_STATE=inactive
  FAKE_BACKUP_STARTED="$(iso_for "$backup_start")"
  FAKE_BACKUP_ENDED="$(iso_for "$((backup_start + previous_duration))")"
  check_backup_alert "$((backup_start + previous_duration))" 1 'failed WAL status remains failed while learning duration'
  assert_equals "$previous_duration" "$(cat "$test_root/state/backup-duration-seconds")" 'completed backup duration persisted'
  allowance=$((previous_duration * 2))
  (( allowance >= 600 )) || allowance=600
  (( allowance <= 3300 )) || allowance=3300
  assert_equals "$allowance" "$(cat "$test_root/state/backup-pause-max-seconds")" 'current allowance persisted'
  FAKE_BACKUP_STATE=activating
  FAKE_BACKUP_STARTED="$(iso_for "$((backup_start + 3600))")"
  for elapsed in "$allowance" "$((allowance + 1))"; do
    expected=0; (( elapsed <= allowance )) || expected=1
    check_backup_alert "$((backup_start + 3600 + elapsed))" "$expected" "learned duration=$previous_duration elapsed=$elapsed"
  done
done
# Invalid persisted values must not extend the default or execute shell input.
for invalid_duration in '' invalid -1 999999999999999999999; do
  printf '%s\n' "$invalid_duration" > "$test_root/state/backup-duration-seconds"
  check_backup_alert "$((backup_start + 3600 + 600))" 0 'invalid duration uses ten-minute default'
  check_backup_alert "$((backup_start + 3600 + 601))" 1 'invalid duration cannot extend default'
done
for invalid in 0 601 999999999999999999999 -1 invalid; do
  printf "\nWAL_ARCHIVE_CATCHUP_SECONDS='%s'\n" "$invalid" >> "$BACKUP_CONFIG"
  if FAKE_API_EXIT_STATUS=0 "$IMMEDIATE_MONITOR" > "$test_root/invalid-grace.log" 2>&1; then fail 'invalid grace accepted'; fi
  grep -q 'between 1 and 600' "$test_root/invalid-grace.log" || fail 'invalid grace diagnostic missing'
done

printf 'Monitoring tests passed: heartbeat, derived WAL backlog, bounded backup pause including lock waits, bounded cycle progress, causes with UTC, two priorities, no secret argv.\n'
