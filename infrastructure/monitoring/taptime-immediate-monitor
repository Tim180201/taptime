#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG_DIRECTORY="${TAPTIME_MONITOR_CONFIG_DIRECTORY:-/etc/taptime-monitor}"
readonly STATE_DIRECTORY="${TAPTIME_MONITOR_STATE_DIRECTORY:-/var/lib/taptime-monitor}"
readonly BACKUP_CONFIG="${TAPTIME_BACKUP_CONFIG:-/etc/taptime-backup/config}"
readonly API_HEALTH_URL="${TAPTIME_API_HEALTH_URL:-https://api.tb-infra.de/health}"
readonly NTFY_CURL_CONFIG="$CONFIG_DIRECTORY/ntfy.curl"
readonly HEALTHCHECKS_CURL_CONFIG="$CONFIG_DIRECTORY/healthchecks.curl"
readonly API_DOWN_STATE="$STATE_DIRECTORY/api-down"
readonly WAL_ARCHIVE_DOWN_STATE="$STATE_DIRECTORY/wal-archive-down"
# Includes the oneshot's wait for Borg; learned only from an inactive service.
BACKUP_PAUSE_MAX_SECONDS=600
# Fixed ceiling from cycle start, never renewed by a phase change or monitor run.
readonly WAL_ARCHIVE_CYCLE_MAX_SECONDS=600
# Weekly verification holds the same Borg lock; never learn or extend this limit.
readonly RESTORE_VERIFY_PAUSE_MAX_SECONDS=5400
WAL_ARCHIVE_FAILURE_REASON='Status nicht ok'
WAL_ARCHIVE_CHECKED_AT_UTC=''
running_cycle_start_epoch=0
running_cycle_observed_epoch=0
running_cycle_phase=''

write_monitor_state() {
  local name="$1" value="$2" temporary
  temporary="$(mktemp "$STATE_DIRECTORY/$name.XXXXXX")" || return 1
  if ! { printf '%s\n' "$value" > "$temporary" && chmod 0600 "$temporary" \
    && mv -f -- "$temporary" "$STATE_DIRECTORY/$name"; }; then
    rm -f -- "$temporary"; return 1
  fi
}

load_backup_pause_limit() {
  local duration=''
  if [[ -f "$STATE_DIRECTORY/backup-duration-seconds" ]]; then
    duration="$(< "$STATE_DIRECTORY/backup-duration-seconds")"
  fi
  BACKUP_PAUSE_MAX_SECONDS=600
  if [[ "$duration" =~ ^[1-9][0-9]{0,11}$ ]]; then
    # Clamp before multiplying, including unusually long completed runs.
    if (( duration >= 1650 )); then BACKUP_PAUSE_MAX_SECONDS=3300
    elif (( duration > 300 )); then BACKUP_PAUSE_MAX_SECONDS=$((duration * 2)); fi
  fi
  write_monitor_state backup-pause-max-seconds "$BACKUP_PAUSE_MAX_SECONDS"
}

file_mode() {
  if stat --format='%a' "$1" >/dev/null 2>&1; then
    stat --format='%a' "$1"
  else
    stat -f '%Lp' "$1"
  fi
}

utc_epoch() {
  if date --date="$1" +%s 2>/dev/null; then
    return 0
  fi
  date -ju -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s
}

read_running_cycle() {
  local content started observed pid process_start boot_id process_stat progress_file
  progress_file="$(dirname "$WAL_ARCHIVE_STATUS_FILE")/wal-archive-progress"
  local pattern='^\{"cycle_started_at_utc":"([0-9TZ:-]{20})","phase":"(database|lock|upload|archive_list|base|reconcile)","observed_at_utc":"([0-9TZ:-]{20})","pid":([1-9][0-9]{0,9}),"process_start_ticks":"([0-9]{1,20})","boot_id":"([0-9a-f-]{36})"\}$'
  running_cycle_start_epoch=0
  running_cycle_observed_epoch=0
  running_cycle_phase=''
  [[ -f "$progress_file" && ! -L "$progress_file" && -O "$progress_file" \
    && "$(file_mode "$progress_file")" == 600 ]] || return 1
  content="$(< "$progress_file")"
  [[ "$content" =~ $pattern ]] || return 1
  started="${BASH_REMATCH[1]}"; running_cycle_phase="${BASH_REMATCH[2]}"
  observed="${BASH_REMATCH[3]}"; pid="${BASH_REMATCH[4]}"
  process_start="${BASH_REMATCH[5]}"; boot_id="${BASH_REMATCH[6]}"
  # A leftover file, reused PID or earlier boot is not a running cycle. Linux's
  # start ticks bind the PID to this process; no status text is executed or sent.
  [[ "$boot_id" == "$(< /proc/sys/kernel/random/boot_id)" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  process_stat="$(cat "/proc/$pid/stat" 2>/dev/null)" || return 1
  process_stat="${process_stat##*) }"
  [[ "$process_stat" != Z\ * && "$process_stat" != X\ * \
    && "$(awk '{print $20}' <<< "$process_stat")" == "$process_start" ]] || return 1
  running_cycle_start_epoch="$(utc_epoch "$started")" || return 1
  running_cycle_observed_epoch="$(utc_epoch "$observed")" || return 1
  (( running_cycle_start_epoch > 0 && running_cycle_start_epoch <= running_cycle_observed_epoch ))
}

require_private_file() {
  local file="$1"
  if [[ ! -f "$file" || -L "$file" || ! -O "$file" || "$(file_mode "$file")" != '600' ]]; then
    printf 'Required root-owned mode-0600 file is unavailable: %s\n' "$file" >&2
    exit 1
  fi
}

send_urgent_notification() {
  local message="$1"
  printf '%s' "$message" | curl --config "$NTFY_CURL_CONFIG" \
    --silent \
    --show-error \
    --fail \
    --output /dev/null \
    --request POST \
    --header 'Title: TapTim.e Betrieb' \
    --header 'Priority: 5' \
    --header 'Tags: rotating_light' \
    --data-binary @-
}

wal_archive_is_current() {
  local content='' observed oldest oldest_wal last_archived_wal last_archived pending_count
  local now_epoch observed_epoch oldest_epoch last_archived_epoch
  local maximum_age backup_properties key value backup_state='' backup_loaded=''
  local backup_started='' backup_ended='' backup_start_epoch=0 backup_end_epoch=0
  local catchup_deadline=0 heartbeat_deadline data_deadline
  local cycle_running=0 restore_properties restore_state='' restore_loaded=''
  local restore_started='' restore_start_epoch

  WAL_ARCHIVE_FAILURE_REASON='Status nicht ok'
  # Type=oneshot stays activating throughout ExecStart, including flock. ActiveEnter
  # would miss that entire interval. InactiveEnter also covers a failed/aborted run.
  backup_properties="$(systemctl show taptime-backup.service \
    --property=LoadState,ActiveState,InactiveExitTimestamp,InactiveEnterTimestamp)" || backup_properties=''
  restore_properties="$(systemctl show taptime-restore-verify.service \
    --property=LoadState,ActiveState,InactiveExitTimestamp,InactiveEnterTimestamp)" || restore_properties=''
  if read_running_cycle; then cycle_running=1; fi
  # Read status after progress: completion publishes status before removing progress.
  [[ ! -f "$WAL_ARCHIVE_STATUS_FILE" ]] || content="$(< "$WAL_ARCHIVE_STATUS_FILE")"
  # A concurrent archiver may publish during these reads. Sample time only after
  # all external observations, without extending heartbeat, data or cycle deadlines.
  now_epoch="${TAPTIME_MONITOR_NOW_EPOCH:-$(date +%s)}"
  WAL_ARCHIVE_CHECKED_AT_UTC="$(date -u --date="@$now_epoch" +%Y-%m-%dT%H:%M:%SZ)"
  (( running_cycle_observed_epoch <= now_epoch )) || cycle_running=0
  while IFS='=' read -r key value; do
    case "$key" in
      LoadState) restore_loaded="$value" ;;
      ActiveState) restore_state="$value" ;;
      InactiveExitTimestamp) restore_started="$value" ;;
    esac
  done <<< "$restore_properties"
  if [[ "$restore_loaded" == loaded ]]; then
    case "$restore_state" in
      activating|active|deactivating)
        restore_start_epoch="$(utc_epoch "$restore_started")" || return 1
        (( restore_start_epoch > 0 && restore_start_epoch <= now_epoch )) || return 1
        if (( now_epoch - restore_start_epoch > RESTORE_VERIFY_PAUSE_MAX_SECONDS )); then
          WAL_ARCHIVE_FAILURE_REASON="Wiederherstellungsprüfung läuft seit $(((now_epoch - restore_start_epoch) / 60)) min"
          return 1
        fi
        return 0
        ;;
    esac
  fi
  while IFS='=' read -r key value; do
    case "$key" in
      LoadState) backup_loaded="$value" ;;
      ActiveState) backup_state="$value" ;;
      InactiveExitTimestamp) backup_started="$value" ;;
      InactiveEnterTimestamp) backup_ended="$value" ;;
    esac
  done <<< "$backup_properties"
  [[ "$backup_loaded" == loaded ]] || return 1
  if [[ -n "$backup_started" ]]; then
    backup_start_epoch="$(utc_epoch "$backup_started")" || return 1
    (( backup_start_epoch <= now_epoch )) || return 1
  fi
  case "$backup_state" in
    activating|active|deactivating)
      (( backup_start_epoch > 0 )) || return 1
      if (( now_epoch - backup_start_epoch > BACKUP_PAUSE_MAX_SECONDS )); then
        WAL_ARCHIVE_FAILURE_REASON="Sicherung läuft seit $(((now_epoch - backup_start_epoch) / 60)) min"
        return 1
      fi
      return 0
      ;;
    inactive|failed) ;;
    *) return 1 ;;
  esac
  if (( backup_start_epoch > 0 )) && [[ -n "$backup_ended" ]]; then
    backup_end_epoch="$(utc_epoch "$backup_ended")" || return 1
    (( backup_end_epoch >= backup_start_epoch && backup_end_epoch <= now_epoch )) || return 1
    if [[ "$backup_state" == inactive ]]; then
      write_monitor_state backup-duration-seconds "$((backup_end_epoch - backup_start_epoch))" || return 1
      load_backup_pause_limit || return 1
    fi
    catchup_deadline=$((backup_end_epoch + WAL_ARCHIVE_CATCHUP_SECONDS))
  fi

  if (( cycle_running )); then
    if (( now_epoch - running_cycle_start_epoch > WAL_ARCHIVE_CYCLE_MAX_SECONDS )); then
      WAL_ARCHIVE_FAILURE_REASON="Durchlauf hängt seit $(((now_epoch - running_cycle_start_epoch) / 60)) min (Phase $running_cycle_phase)"
      return 1
    fi
  fi

  [[ "$content" == *'"state":"ok"'* ]] || return 1
  [[ "$content" =~ \"observed_at_utc\":\"([^\"]+)\" ]] || return 1
  observed="${BASH_REMATCH[1]}"
  [[ "$content" =~ \"pending_count\":([0-9]+) ]] || return 1
  pending_count="${BASH_REMATCH[1]}"
  observed_epoch="$(utc_epoch "$observed")" || return 1
  (( observed_epoch <= now_epoch )) || return 1
  maximum_age=$((WAL_ARCHIVE_INTERVAL_SECONDS * WAL_ARCHIVE_MISSED_CYCLES))
  heartbeat_deadline=$((observed_epoch + maximum_age))
  (( heartbeat_deadline >= catchup_deadline )) || heartbeat_deadline=$catchup_deadline
  if (( now_epoch > heartbeat_deadline && cycle_running == 0 )); then
    WAL_ARCHIVE_FAILURE_REASON="Archivierer ohne Lebenszeichen seit $(((now_epoch - observed_epoch) / 60)) min"
    return 1
  fi
  (( pending_count == 0 )) && return 0

  [[ "$content" =~ \"oldest_required_at_utc\":\"([^\"]+)\" ]] || return 1
  oldest="${BASH_REMATCH[1]}"
  [[ "$content" =~ \"oldest_required_wal_file\":\"([0-9A-F]{24})\" ]] || return 1
  oldest_wal="${BASH_REMATCH[1]}"
  oldest_epoch="$(utc_epoch "$oldest")" || return 1
  if [[ "$content" =~ \"last_archived_wal_file\":\"([0-9A-F]{24})\" ]]; then
    last_archived_wal="${BASH_REMATCH[1]}"
    # A later externally archived segment with an earlier hole is never a healthy sequence.
    [[ "$last_archived_wal" < "$oldest_wal" ]] || return 1
  fi
  if [[ "$content" =~ \"last_archived_at_utc\":\"([^\"]+)\" ]]; then
    last_archived="${BASH_REMATCH[1]}"
    last_archived_epoch="$(utc_epoch "$last_archived")" || return 1
    (( last_archived_epoch >= 0 )) || return 1
  fi
  # One fixed deadline per backup, never extended by another monitor invocation.
  data_deadline=$((oldest_epoch + maximum_age))
  (( data_deadline >= catchup_deadline )) || data_deadline=$catchup_deadline
  if (( now_epoch > data_deadline )); then
    WAL_ARCHIVE_FAILURE_REASON="WAL-Segment wartet seit $(((now_epoch - oldest_epoch) / 60)) min"
    return 1
  fi
  return 0
}

require_private_file "$NTFY_CURL_CONFIG"
require_private_file "$HEALTHCHECKS_CURL_CONFIG"
require_private_file "$BACKUP_CONFIG"
# shellcheck source=/etc/taptime-backup/config
source "$BACKUP_CONFIG"
: "${WAL_ARCHIVE_STATUS_FILE:?WAL_ARCHIVE_STATUS_FILE must be configured}"
: "${WAL_ARCHIVE_INTERVAL_SECONDS:?WAL_ARCHIVE_INTERVAL_SECONDS must be configured}"
: "${WAL_ARCHIVE_MISSED_CYCLES:?WAL_ARCHIVE_MISSED_CYCLES must be configured}"
[[ "$WAL_ARCHIVE_INTERVAL_SECONDS" =~ ^[1-9][0-9]*$ ]]
[[ "$WAL_ARCHIVE_MISSED_CYCLES" =~ ^[1-9][0-9]*$ ]]
WAL_ARCHIVE_CATCHUP_SECONDS="${WAL_ARCHIVE_CATCHUP_SECONDS:-300}"
if [[ ! "$WAL_ARCHIVE_CATCHUP_SECONDS" =~ ^[1-9][0-9]{0,2}$ ]] \
  || (( WAL_ARCHIVE_CATCHUP_SECONDS > 600 )); then
    printf 'WAL_ARCHIVE_CATCHUP_SECONDS must be between 1 and 600.\n' >&2
    exit 1
fi
install -d -m 0700 "$STATE_DIRECTORY"
load_backup_pause_limit

result=0

if curl --silent --show-error --fail --max-time 10 --output /dev/null "$API_HEALTH_URL"; then
  rm -f "$API_DOWN_STATE"
elif [[ ! -e "$API_DOWN_STATE" ]]; then
  if send_urgent_notification 'API antwortet nicht'; then
    touch "$API_DOWN_STATE"
  else
    printf 'The API alert could not be delivered.\n' >&2
    result=1
  fi
fi

if wal_archive_is_current; then
  rm -f "$WAL_ARCHIVE_DOWN_STATE"
elif [[ ! -e "$WAL_ARCHIVE_DOWN_STATE" ]]; then
  if send_urgent_notification "WAL-Archivierung steht: $WAL_ARCHIVE_FAILURE_REASON; at=$WAL_ARCHIVE_CHECKED_AT_UTC"; then
    touch "$WAL_ARCHIVE_DOWN_STATE"
  else
    printf 'The WAL archive alert could not be delivered.\n' >&2
    result=1
  fi
fi

# A success heartbeat is evidence that every check above either remained healthy or delivered
# its first alert. When alert delivery fails, omitting this ping lets the independent dead-man
# path report the monitor failure instead of falsely acknowledging a healthy run.
if (( result == 0 )); then
  if ! curl --config "$HEALTHCHECKS_CURL_CONFIG" --head --output /dev/null; then
    printf 'The empty dead-man heartbeat could not be delivered.\n' >&2
    result=1
  fi
fi

exit "$result"
