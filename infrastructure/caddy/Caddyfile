http://api.tb-infra.de {
	header -Server
	redir https://api.tb-infra.de{uri} permanent
}

api.tb-infra.de {
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	reverse_proxy backend-api:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
		header_down -Server
	}
}

http://admin.tb-infra.de {
	header -Server
	redir https://admin.tb-infra.de{uri} permanent
}

admin.tb-infra.de {
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	handle /health {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle /status/* {
		root * /srv/admin-web
		header Cache-Control "no-store"
		file_server
	}

	@adminWebVersion path /version.txt
	header @adminWebVersion Cache-Control "no-store"

	# T-006 index.html used unversioned /assets/* URLs. Keep those immutable files
	# reachable so a browser loading across the first T-026 switch can finish.
	handle /assets/* {
		root * /srv/admin-web
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	handle /releases/* {
		root * /srv/admin-web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /v1/* {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle /v2/* {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle /v3/* {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle {
		root * /srv/admin-web/current
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
