http://api.tb-infra.de {
	header -Server
	redir https://api.tb-infra.de{uri} permanent
}

api.tb-infra.de {
	respond /v1/operator 404
	respond /v1/operator/* 404
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The API serves JSON only; a browser must never render or frame it.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy backend-api:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
		header_down -Server
	}
}

http://admin.tb-infra.de {
	header -Server
	redir https://admin.tb-infra.de{uri} permanent
}

admin.tb-infra.de {
	respond /v1/operator 404
	handle /v1/operator/* {
		respond 404
	}
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Admin Web: a Vite bundle with no inline scripts or styles; React sets styles
		# through the CSSOM, which no CSP directive governs. The only cross-origin call is
		# Supabase Auth. Tightening *.supabase.co to the exact issuer is T-039's follow-up.
		# The test extracts this exact value and serves it through a real Caddy.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
	}

	handle /health {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle /status/* {
		root * /srv/admin-web
		header Cache-Control "no-store"
		file_server
	}

	@adminWebVersion path /version.txt
	header @adminWebVersion Cache-Control "no-store"

	# T-006 index.html used unversioned /assets/* URLs. Keep those immutable files
	# reachable so a browser loading across the first T-026 switch can finish.
	handle /assets/* {
		root * /srv/admin-web
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	handle /releases/* {
		root * /srv/admin-web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /v1/* {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle /v2/* {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle /v3/* {
		reverse_proxy backend-api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
			header_down -Server
		}
	}

	handle {
		root * /srv/admin-web/current
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}

http://betreiber.tb-infra.de {
	header -Server
	redir https://betreiber.tb-infra.de{uri} permanent
}

betreiber.tb-infra.de {
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
	}

	# Removing current during an initial-install rollback closes the whole surface,
	# including its API and retained immutable releases.
	@operatorEnabled file {
		root /srv/operator-web/current
		try_files index.html
	}
	handle @operatorEnabled {
		handle /v1/operator/* {
			reverse_proxy backend-api:3000 {
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Host {host}
				header_up X-TapTime-Proxy-Secret {file./run/secrets/taptime_proxy_shared_secret}
				header_down -Server
			}
		}
		@otherApi path_regexp ^/(v[0-9]+(/|$)|health(/|$))
		handle @otherApi {
			respond 404
		}
		handle /releases/* {
			root * /srv/operator-web
			@releaseDocument path /releases/*/index.html /releases/*/version.txt
			@releaseAsset not path /releases/*/index.html /releases/*/version.txt
			header @releaseDocument Cache-Control "no-store"
			header @releaseAsset Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			root * /srv/operator-web/current
			header Cache-Control "no-store"
			try_files {path} /index.html
			file_server
		}
	}
	handle {
		respond 404
	}
}

(landing_headers) {
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}
}

http://tb-infra.de {
	import landing_headers
	redir https://tb-infra.de{uri} 301
}

www.tb-infra.de, http://www.tb-infra.de {
	import landing_headers
	redir https://tb-infra.de{uri} 301
}

tb-infra.de {
	import landing_headers
	# Authentication and file-server errors use Caddy's error route.
	handle_errors {
		import landing_headers
		respond "" {err.status_code}
	}
	@landingEnabled file {
		root /srv/landing-web/current
		try_files index.html
	}
	handle @landingEnabled {
		@landingApi path_regexp ^/(v[0-9]+(/|$)|health(/|$))
		handle @landingApi {
			respond 404
		}
		@landingPublic path /tag /robots.txt /version.txt
		handle @landingPublic {
			root * /srv/landing-web/current
			@tag path /tag
			rewrite @tag /tag.html
			file_server
		}
		# Only the tag page's styles and local fonts bypass authentication.
		@tagAsset path_regexp ^/releases/[0-9a-f]{7}/tag-assets/(fonts\.css|tag\.css|fonts/(manrope-(400|500|600|700|800)|jetbrains-mono-(400|500))\.ttf)$
		handle @tagAsset {
			root * /srv/landing-web
			file_server
		}
		handle {
			basic_auth {
				pilot {file./srv/landing-auth/password.hash}
			}
			handle /releases/* {
				root * /srv/landing-web
				file_server
			}
			handle {
				root * /srv/landing-web/current
				file_server
			}
		}
	}
	handle {
		respond 404
	}
}
