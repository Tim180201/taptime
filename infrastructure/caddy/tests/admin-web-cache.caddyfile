{
	auto_https off
}

:8080 {
	handle /status/* {
		root * /tmp/admin-web
		header Cache-Control "no-store"
		file_server
	}

	@adminWebVersion path /version.txt
	header @adminWebVersion Cache-Control "no-store"

	handle /assets/* {
		root * /tmp/admin-web
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	handle /releases/* {
		root * /tmp/admin-web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /tmp/admin-web/current
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
